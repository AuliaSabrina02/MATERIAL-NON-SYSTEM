                if ($body.hasClass('sidebar-collapse') && !$body.hasClass('sidebar-open')) {
                    $img.attr('src', imgClosed);
                } else {
                    $img.attr('src', imgOpen);
                }
            }

            updateSidebarLogo();

            $(document).on('click', '[data-widget="pushmenu"]', function () {
                setTimeout(updateSidebarLogo, 200);
            });

            $sidebar.on('mouseenter', function () {
                $img.attr('src', imgOpen);
            });

            $sidebar.on('mouseleave', function () {
                if ($body.hasClass('sidebar-collapse') && !$body.hasClass('sidebar-open')) {
                    $img.attr('src', imgClosed);
                }
            });

            // ====== BADGE DISCUSSION ======
            function fetch_discussion_badge() {
                $.ajax({
                    type: "GET",
                    url: "@Url.Action("GetUnreadDiscussionCount", "User")",
                }).done(function (res) {
                    let count = parseInt(res);
                    if (count > 0) {
                        $("#discussion-badge").text(count).show();
                    } else {
                        $("#discussion-badge").hide();
                    }
                }).fail(function () {
                    $("#discussion-badge").hide();
                });
            }

            // ====== BADGE SCHEDULE ======
            function fetch_schedule_badge() {
                $.ajax({
                    type: "GET",
                    url: "@Url.Action("GetScheduleCount", "User")",
                }).done(function (res) {
                    let count = parseInt(res);
                    if (count > 0) {
                        $("#schedule-badge").text(count).show();
                    } else {
                        $("#schedule-badge").hide();
                    }
                }).fail(function () {
                    $("#schedule-badge").hide();
                });
            }

            // Panggil pertama kali saat halaman load
            fetch_discussion_badge();
            fetch_schedule_badge();

            // Auto refresh setiap 30 detik
            setInterval(fetch_discussion_badge, 30000);
            setInterval(fetch_schedule_badge, 30000);
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>

