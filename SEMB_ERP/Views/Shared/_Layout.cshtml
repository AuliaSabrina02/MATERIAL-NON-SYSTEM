@using SEMB_ERP.Function
@using Microsoft.AspNetCore.Http;
@using System.Security.Claims;
@inject IHttpContextAccessor HttpContextAccessor
@{
    string url = ViewContext.HttpContext.Request.Path;
    string lastSegment = url.Split('/').Last();

    // string user_level = HttpContextAccessor.HttpContext.Session.GetString("level");
    // string user_role = HttpContextAccessor.HttpContext.Session.GetString("role");
    string sesa_id = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    string user_level = User.FindFirst("semb_erp_level")?.Value;
    // string user_role = User.FindFirst("semb_erp_role")?.Value;
    string name = User.FindFirst("semb_erp_name")?.Value;
    List<string> user_roles = User.Claims
                .Where(c => c.Type == "semb_erp_role")
                .Select(c => c.Value)
                .ToList();
}

