@model SEMB_ERP.Models.LoginModel
@using Microsoft.AspNetCore.Mvc.Rendering;
@using Microsoft.AspNetCore.Http
@using System.Security.Claims;


@{
    //ViewData["Title"] = "Login Page";
    // string name = User.FindFirst("name")?.Value;
    // int changeLevel = ViewBag.changeLevel;
    string sesa_id = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    string name = User.FindFirst("semb_erp_name")?.Value;
    string level = User.FindFirst("semb_erp_level")?.Value;
    string role = User.FindFirst("semb_erp_role")?.Value;
    int is_registered = 1;
    if (level == null)
    {
        is_registered = 0;
    }
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SEMB - Material Non System</title>
    <link rel="icon" type="image/x-icon" href="~/images/icon/icontabocr.svg">
    <!-- AdminLTE V3 -->
    <link href="~/Content/adminlte.min.css" rel="stylesheet" />
    <link href="~/lib/adminlte/plugins/fontawesome-free/css/all.css" rel="stylesheet" />
    <link href="~/lib/adminlte/plugins/fontawesome-free/css/fontawesome.css" rel="stylesheet" />
    <link href="~/lib/adminlte/plugins/fontawesome-free/css/solid.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
    <link href="~/lib/adminlte/dist/css/adminlte.min.css" rel="stylesheet" />
    <link href="~/lib/adminlte/plugins/sweetalert2/sweetalert2.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/custom-fonts.css" />

</head>

<body class="bg">
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="container mask p-4 p-md-5 shadow-lg">
            <div class="row justify-content-center">

                <div class="col-12 col-lg-6 text-lg-start mb-4 mb-lg-0 custom-alignment">
                    <div class="p-3 p-md-4 text-lg-start">
                    <div>
                        <img src="~/images/logo/semb_materialnon.svg" alt="Logo" class="nav-logo">
                    </div>
                        <h8 class="text-muted">SEMB - Material Non System</h8>
                        <p class="text-muted small mt-3">version 1.0</p>
                    </div>
                </div>


                <!-- RIGHT (login box) -->
                <!-- RIGHT (login box) -->
                <div class="col-12 col-lg-6">
                    <div class="p-3 p-md-4 text-lg-start">
                        <div class="custom-alignment text-lg-start">
                            <h4>Welcome,</h4>
                            <h4>Please Login</h4>
                        </div>

                        @if (TempData["AccessDenied"] != null)
                        {
                            <div class="mt-3">
                                <div class="alert alert-danger text-center small">
                                    You don't have access,<br />
                                    Please contact admin for support.
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Mobile view: manual login form langsung tampil -->
                            <div class="d-lg-none mt-3">
                                <form id="form_mobile_login" method="post" action="@Url.Action("LoginManual", "Home")">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-2 text-start">
                                        <label class="form-label">SESA ID</label>
                                        @Html.EditorFor(model => model.sesa_id, new { htmlAttributes = new { @class = "form-control", Required = true } })
                                    </div>
                                    <div class="mb-2 text-start">
                                        <label class="form-label">Password</label>
                                        @Html.EditorFor(model => model.password, new { htmlAttributes = new { @Type = "password", @class = "form-control", Required = true } })
                                    </div>
                                    <div class="d-flex gap-2 mt-3">
                                        <button type="submit" class="btn btn-success flex-fill">
                                            Login <i class="fa fa-arrow-right ms-1"></i>
                                        </button>
                                    </div>
                                    <div class="d-flex align-items-center my-2">
                                        <hr class="flex-grow-1">
                                        <span class="mx-2 text-muted">or</span>
                                        <hr class="flex-grow-1">
                                    </div>
                                    <div class="d-flex gap-2 mt-2">
                                        <a href="@Url.Action("Login", "Home")"
                                           class="btn btn-outline-success flex-fill">
                                            <img src="~/images/icon/icon_se.svg"
                                                 alt="SSO Login Icon"
                                                 class="iconse"
                                                 style="width: 20px; vertical-align: middle; margin-right: 5px;">
                                            SSO Login
                                        </a>

                                    </div>
                                </form>
                            </div>

                            <div class="d-none d-lg-flex justify-content-between mt-2 gap-2">
                                <button class="btn btn-info btn-flat rounded flex-fill" data-bs-toggle="modal" data-bs-target="#modal_login">
                                    <i class="fas fa-sign-in-alt"></i> Login with SESA
                                </button>

                                <a href="@Url.Action("Login", "Home")"
                                   class="btn btn-success btn-flat rounded flex-fill">
                                    <img src="~/images/icon/icon_se.svg"
                                         alt="SSO Login Icon"
                                         class="iconse"
                                         style="width: 20px; vertical-align: middle; margin-right: 1px;">
                                    SSO Login
                                </a>
                            </div>
                        }
                    </div>
                </div>
                <div class="row mt-0 pt-3 border-top">
                    <div class="col-12 d-flex flex-column flex-md-row justify-content-between align-items-center text-center text-md-start">
                        <div class="text-success mb-2 mb-md-0">
                            <ul class="list-unstyled mb-0 small">
                                <li>&copy;2025 - GSC EA SEMB Digital & Analytics</li>
                                <li>Schneider Electric Manufacturing Batam</li>
                            </ul>
                        </div>
                        <div>
                            <img src="~/images/logo/se-lio-green.png"
                                 class="d-inline-block align-text-top img-fluid"
                                 style="max-width: 120px;" alt="Schneider Electric Logo">
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="modal_login" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-md ">
                        <div class="maskmodals   modal-content border-0 rounded-4 shadow-sm">
                            <div class="modal-body p-4 text-center">
                                <i class="fas fa-sign-in-alt"></i> Login with SESA
                                <form id="form_add" method="post" action="@Url.Action("LoginManual", "Home")">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-3 text-start">
                                        <label class="form-label">SESA ID</label>
                                        @Html.EditorFor(model => model.sesa_id, new { htmlAttributes = new { @class = "form-control", Required = true } })
                                    </div>
                                    <div class="mb-3 text-start">
                                        <label class="form-label">Password</label>
                                        @Html.EditorFor(model => model.password, new { htmlAttributes = new { @Type = "password", @class = "form-control", Required = true } })
                                    </div>

                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-secondary flex-fill" id="btn_cancel" data-bs-dismiss="modal">
                                            Cancel
                                        </button>
                                        <button type="submit" class="btn btn-success flex-fill">
                                            Login <i class="fa fa-arrow-right ms-1"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>



    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <script src="~/lib/adminlte/plugins/sweetalert2/sweetalert2.min.js"></script>
    <script>
        $(document).on('click', '#btn_cancel', function () {
            $('#form_add')[0].reset();        // Clears the form fields
            $('#form_add input').trigger('change'); // If using validation/Select2/etc
        });

        function login() {
            $("#modal_login").modal("show");
        }
    </script>
    <style>
        .bg {
            background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), /* lapisan gelap */
            url('@Url.Content("~/images/background/warehouse.jpg")') no-repeat center center fixed;
            background-size: cover;

        }

        .mask {
                    background: rgba(255, 255, 255, 0.9); /* lebih transparan */
                    border-radius: 20px;
        }

                .maskmodals {
                    background: rgba(255, 255, 255, 0.9); /* lebih transparan */
                    border-radius: 20px;
                    backdrop-filter: blur(15px) saturate(180%);
                    -webkit-backdrop-filter: blur(15px) saturate(180%); /* untuk Safari */
                    border: 1px solid rgba(255, 255, 255, 0.4);
                    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
                }

        .shadow-lg {
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15) !important;
        }

        .btn-success {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }

            .btn-success:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            }

        .btn-success {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }

                    .btn-success:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            }

        .custom-alignment {
            text-align: center;
        }

        .nav-logo {
            width: 90%;
            height: auto;
            display: block;
            margin: 0;
        }

        @@media (max-width: 768px) {
            .iconse {
                width: 10%;
            }


            .custom-alignment {
                text-align: center !important;
                align-items: center;
                justify-content: center;
            }

            .nav-logo {
                margin-top: 10pt;
                width: 90%;
            }
        }
    </style>
</body>
</html>
