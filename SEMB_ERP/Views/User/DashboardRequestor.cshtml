                    $('#body_filtered_returns').html(response);
                    Swal.fire({ icon: 'success', title: 'Data Loaded', text: 'Showing ' + statusName + ' returns', timer: 1500, showConfirmButton: false, toast: true, position: 'top-end' });
                },
                error: function (xhr, status, error) {
                    $('#body_filtered_returns').html(`<div class="alert alert-danger m-3"><i class="fas fa-exclamation-triangle"></i> Error loading data: ${error}</div>`);
                }
