        function getStatusBadge(status) {
            status = status.toLowerCase();
            if (status.includes('picking')) return `<span class="badge bg-warning text-dark">PICKING</span>`;
            if (status.includes('close'))   return `<span class="badge bg-secondary">CLOSED</span>`;
            if (status.includes('done'))    return `<span class="badge bg-success">DONE</span>`;
            return `<span class="badge bg-info">${status.toUpperCase()}</span>`;
        }

        // ✅ renderCharts - HANYA render chart, tidak ada fungsi lain di dalamnya
              function renderCharts(data) {
            Highcharts.chart('bar_chart', {
                chart: { type: 'column' },
                title: { text: null },
                credits: { enabled: false },
                xAxis: { categories: ['Picking Volume'] },
                yAxis: { title: { text: 'Total Requests' } },
                legend: { enabled: true, align: 'center', verticalAlign: 'bottom', layout: 'horizontal', itemStyle: { fontSize: '11px', fontWeight: 'normal' } },
                tooltip: { pointFormat: '<b>{series.name}</b>: {point.y}<br/><i>Click to view details</i>' },
                plotOptions: {
                    column: {
                        dataLabels: { enabled: true },
                        cursor: 'pointer',
                        borderRadius: 6,
                        borderWidth: 0,
                        point: { events: { click: function () { openOrderModal(this.series.name); } } }
                    }
                },
                series: [
                    { name: 'Submission',  data: [data.submission],      color: '#FFBF00' },
                    { name: 'Received',    data: [data.received],         color: '#22A855' },
                    { name: 'Putaway',     data: [data.putaway],          color: '#2196C9' },
                    { name: 'Partial',     data: [data.partiallyPicked],  color: '#F45C1B' },
                    { name: 'Closed',      data: [data.closed],           color: '#9E9E8E' }
                ]
            });

            Highcharts.chart('pie_chart', {
                chart: { type: 'pie' },
                title: { text: null },
                credits: { enabled: false },
                legend: { enabled: true, align: 'center', verticalAlign: 'bottom', layout: 'horizontal', itemStyle: { fontSize: '11px', fontWeight: 'normal' }, symbolRadius: 6 },
                plotOptions: {
                    pie: {
                        cursor: 'pointer',
                        borderRadius: 6,
                        borderWidth: 0,
                        dataLabels: { enabled: true, format: '{point.name}: {point.y} ({point.percentage:.1f}%)' },
                        showInLegend: true,
                        point: { events: { click: function () { filterRequestByPickingStatus(this.name); } } }
                    }
                },
                series: [{
                    name: 'Picking Status', colorByPoint: true,
                          data: [
            { name: 'Request',        y: data.pickingSummary?.request        || 0, color: '#6c757d' },
            { name: 'Start Picking',  y: data.pickingSummary?.startPicking   || 0, color: '#17a2b8' },
            { name: 'Consolidation',  y: data.pickingSummary?.consolidation  || 0, color: '#fd7e14' },
            { name: 'Transfering',    y: data.pickingSummary?.transferring   || 0, color: '#007bff' },
            { name: 'Plant Received', y: data.pickingSummary?.plantReceived  || 0, color: '#e83e8c' }, // ← tambah ini
            { name: 'Supplied',       y: data.pickingSummary?.supplied       || 0, color: '#28a745' },
            { name: 'Done Picking',   y: data.pickingSummary?.donePicking    || 0, color: '#20c997' }
        ]
                }]
            });
        }

        // ✅ Semua fungsi berikut di LUAR renderCharts
        function openOrderModal(status) {
            const statusMapping = {
                'Submission': 'SUBMISSION',
                'Received': 'RECEIVED',
                'Putaway': 'PUTAWAY',
                'Partial': 'PARTIALLY PICKED',
                'Closed': 'CLOSED'
            };
            const mappedStatus = statusMapping[status] || status;

            $('#modalOrderList').modal('show');
            $('#modalOrderListBody').html(`
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-primary"></i>
                    <p class="mt-3">Loading <strong>${status}</strong> orders...</p>
                </div>
            `);

            $.ajax({
                type: "GET",
                url: '@Url.Action("GetOrderListByStatus", "User")',
                data: { status: mappedStatus },
                success: function (response) {
                    $('#modalOrderListBody').html(response);
                    setTimeout(function () {
                        $('#modalOrderListBody table').each(function () {
                            if ($.fn.DataTable.isDataTable(this)) { $(this).DataTable().destroy(); }
                        });
                        $('#modalOrderListBody table').DataTable({
                            "paging": true, "lengthChange": true, "searching": true,
                            "ordering": true, "info": true, "autoWidth": false,
                            "responsive": true, "pageLength": 10
                        });
                        Swal.fire({ icon: 'success', title: 'Data Loaded', text: 'Showing ' + status + ' orders', timer: 1500, showConfirmButton: false, toast: true, position: 'top-end' });
                    }, 300);
                },
                error: function (xhr, status, error) {
                    $('#modalOrderListBody').html(`
                        <div class="alert alert-danger m-3">
                            <i class="fas fa-exclamation-triangle"></i>
                            Error loading data: ${error}
                            <br><small>Status: ${xhr.status} - ${xhr.statusText}</small>
                        </div>
                    `);
                    console.error('Error:', error);
                }
            });
        }

                                    function openAgingModal(agingCategory) {
            $('#aging-modal-title').text(agingCategory);

            // 1. Munculkan spinner di wrapper sebelum AJAX jalan
            $('#aging-modal-content-wrapper').html(`
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-primary"></i>
                    <p class="mt-3">Loading ${agingCategory} data...</p>
                </div>
            `);

            $('#modal_aging_movement').modal('show');

            // 2. Eksekusi AJAX
            $.ajax({
                type: 'GET',
                url: '@Url.Action("AgingMovementPartial", "User")',
                data: { agingCategory: agingCategory },
                success: function (res) {
                    // Beri sedikit delay agar spinner tidak "kelap-kelip" terlalu cepat
                    setTimeout(function() {
                        // Update konten modal
                        $('#aging-modal-content-wrapper').html(res);

                        // 3. Tampilkan Alert setelah konten muncul
                        Swal.fire({
                            icon: 'success',
                            title: 'Data Loaded',
                            text: 'Showing ' + agingCategory + ' aging data',
                            timer: 1500,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });
                    }, 400); // 400ms cukup untuk transisi yang smooth
                },
                error: function () {
                    $('#aging-modal-content-wrapper').html('<div class="alert alert-danger m-3">Gagal load data.</div>');
                }
            });
        }

        function filterRequestByPickingStatus(statusName) {
            const statusMapping = {
                'Request': 'REQUEST',
                'Start Picking': 'START PICKING',
                'Picking': 'PICKING',
                'Consolidation': 'CONSOLIDATION',
        'Transfering': 'TRANSFERING',
                'Supplied': 'SUPPLIED',
                'Done Picking': 'DONE PICKING'
            };
            const statusValue = statusMapping[statusName] || statusName;

            $('#modal_filtered_requests').modal('show');
            $('#body_filtered_requests').html(`
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-primary"></i>
                    <p class="mt-3">Loading <strong>${statusName}</strong> requests...</p>
                </div>
            `);

            $.ajax({
                type: "GET",
                url: "@Url.Action("GetRequestListByStatus", "User")",
                data: { status: statusValue },
                success: function (response) {
                    $('#body_filtered_requests').html(response);
                    Swal.fire({ icon: 'success', title: 'Data Loaded', text: 'Showing ' + statusName + ' requests', timer: 1500, showConfirmButton: false, toast: true, position: 'top-end' });
                },
                error: function (xhr, status, error) {
                    $('#body_filtered_requests').html(`
                        <div class="alert alert-danger m-3">
                            <i class="fas fa-exclamation-triangle"></i>
                            Error loading data: ${error}
                        </div>
