@model List<UserDetailModel>
@{
    ViewData["Title"] = "Dashboard Requestor";
    var user = Model.First();
}

<style>
    .kpi-card-wh {
        background: #ffffff;
        border-radius: 12px;
        padding: 12px 14px;
        margin-bottom: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
        border: 1px solid #e9ecef;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        display: flex;
        align-items: center;
        gap: 10px;
        height: 100%;
    }

        .kpi-card-wh:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
        }

    .kpi-icon-wh {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }

        .kpi-icon-wh i {
            color: #fff;
        }

    .kpi-body {
        flex: 1;
        min-width: 0;
    }

    .kpi-label-wh {
        font-size: 9.5px;
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        white-space: normal;
        word-break: break-word;
        line-height: 1.3;
        margin-bottom: 2px;
    }

    .kpi-value-wh {
        font-size: 18px;
        font-weight: 700;
        color: #2c3e50;
        line-height: 1;
    }

    .kpi-col {
        padding-left: 4px !important;
        padding-right: 4px !important;
    }

    .card {
        margin-bottom: 0;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }

    .hero {
        min-height: 70px;
        position: relative;
        display: flex;
        align-items: center;
        color: #fff;
        margin-bottom: 15px;
    }

        .hero .inner {
            background: rgba(0,0,0,0.7);
            height: 70px;
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 0 1rem;
        }

    .hero-title-container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        width: 100%;
    }


    .card-header {
        background-color: #2f3d57;
        border-radius: 12px 12px 0 0 !important;
    }

        .card-header h3.card-title,
        .card-header .card-title {
            color: #ffffff !important;
        }

        .card-header i {
            color: #3DCD58 !important;
        }

        .card-header .btn-outline-secondary {
            color: #ffffff;
            border-color: rgba(255,255,255,0.4);
        }

            .card-header .btn-outline-secondary:hover {
                background-color: rgba(255,255,255,0.1);
            }

    .hero-title-container h3 {
        margin-bottom: 0;
        font-weight: 700;
        font-size: 1.75rem;
    }

    .status-badge {
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 0.85rem;
        font-weight: bold;
    }

    .table-sm td, .table-sm th {
        font-size: 0.9rem;
    }
</style>

<section id="hero" class="hero bg-dark position-relative"
         style="background: url('@Url.Content("~/images/background/bg-am.jpg")') center center / cover no-repeat fixed;">
    <div class="inner">
        <div>
            @* <small class="text-white-50"><i class="fas fa-clock"></i> <span id="current-time"></span></small> *@
        </div>
        <div class="hero-title-container">
            <h3 class="text-white">
                <i class="fas fa-chart-pie text-success me-2"></i>
                Dashboard Requestor
            </h3>
        </div>
        <div class="ms-auto"></div>
    </div>
</section>

<div class="container-fluid px-2 pb-4">

    <!-- KPI Cards -->
    <div class="row flex-nowrap overflow-auto mb-2 pb-1" style="margin-left: 0; margin-right: 0;">

        <!-- Submission -->
        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" onclick="openOrderModal('Submission')">
                <div class="kpi-icon-wh" style="background-color: #FFBF00;">
                    <i class="fas fa-file-import"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Submission</div>
                    <div class="kpi-value-wh" id="total-submission">0</div>
                </div>
            </div>
        </div>

        <!-- Received -->
        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" onclick="openOrderModal('Received')">
                <div class="kpi-icon-wh" style="background-color: #22A855;">
                    <i class="fas fa-box-open"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Received</div>
                    <div class="kpi-value-wh" id="total-received">0</div>
                </div>
            </div>
        </div>

        <!-- Putaway -->
        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" onclick="openOrderModal('Putaway')">
                <div class="kpi-icon-wh" style="background-color: #2196C9;">
                    <i class="fas fa-warehouse"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Putaway</div>
                    <div class="kpi-value-wh" id="total-putaway">0</div>
                </div>
            </div>
        </div>

        <!-- Partially Picked -->
        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" onclick="openOrderModal('Partial')">
                <div class="kpi-icon-wh" style="background-color: #F45C1B;">
                    <i class="fas fa-tasks"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Partially Picked</div>
                    <div class="kpi-value-wh" id="total-partially-picked">0</div>
                </div>
            </div>
        </div>

        <!-- Closed -->
        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" onclick="openOrderModal('Closed')">
                <div class="kpi-icon-wh" style="background-color: #9E9E8E;">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Closed</div>
                    <div class="kpi-value-wh" id="total-closed">0</div>
                </div>
            </div>
        </div>

    </div>

    <!-- Chart Cards -->
    <div class="row g-3 px-1">

        <!-- Request Status -->
        <div class="col-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-chart-bar me-1"></i> Request Status
                    </h3>
                </div>
                <div class="card-body">
                    <div id="bar_chart" style="width:100%; height:300px;"></div>
                </div>
            </div>
        </div>

        <!-- Picking Progress -->
        <div class="col-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-chart-pie me-1"></i> Picking Progress
                    </h3>
                </div>
                <div class="card-body">
                    <div id="pie_chart" style="width:100%; height:300px;"></div>
                </div>
            </div>
        </div>

        <!-- Aging Movement Chart -->
        <div class="col-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-chart-line me-1"></i> Aging Movement Chart
                    </h3>
                </div>
                <div class="card-body">
                    <div id="aging_chart" style="width:100%; height:280px;"></div>
                </div>
            </div>
        </div>

        <!-- Return Status -->
        <div class="col-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-undo me-1"></i> Return Status
                    </h3>
                </div>
                <div class="card-body">
                    <div id="return_chart" style="width:100%; height:280px;"></div>
                </div>
            </div>
        </div>

        <!-- Request Schedule - full width -->
        <div class="col-12">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-chart-bar me-1"></i> Request Schedule
                    </h3>
                </div>
                <div class="card-body">
                    <div id="summary_chart" style="width:100%; height:350px;"></div>
                </div>
            </div>
        </div>

        <!-- Recent Non-Conf - full width -->
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-exclamation-circle me-1"></i> Recent Non-Conf
                    </h3>
                    <div class="card-tools ms-auto">
                        <a href="@Url.Action("NonConfList", "User")" class="btn btn-sm btn-outline-secondary">
                            View All
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div id="nonconf-table-container">
                        <!-- ✅ Ganti ini -->
                        <div class="text-center p-3">
                            <i class="fas fa-spinner fa-spin"></i> Loading...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


    </div>
</div>

<!-- Modal Order List -->
