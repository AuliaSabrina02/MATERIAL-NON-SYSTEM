              function renderReturnChart(statusCount) {
            Highcharts.chart('return_chart', {
                chart: { type: 'column' },
                title: { text: null },
                credits: { enabled: false },
                xAxis: { categories: ['Return Status'], labels: { style: { fontSize: '11px', fontWeight: 'bold' } } },
                yAxis: { min: 0, title: { text: 'Total Returns' }, stackLabels: { enabled: true, style: { fontWeight: 'bold' } } },
                legend: { align: 'center', verticalAlign: 'bottom', layout: 'horizontal', itemStyle: { fontSize: '11px' } },
                tooltip: { pointFormat: '<b>{series.name}</b>: {point.y}<br/>Total: {point.stackTotal}<br/><i>Click to view details</i>' },
                plotOptions: {
                    column: {
                        stacking: 'normal',
                        cursor: 'pointer',
