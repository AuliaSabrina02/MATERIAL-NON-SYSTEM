@section Scripts {
    <script src="https://code.highcharts.com/highcharts.js"></script>

    <script>
        $(document).ready(function () {
            Highcharts.setOptions({
                chart: { style: { fontFamily: 'inherit' } },
                legend: { itemStyle: { color: '#000000', fontFamily: 'inherit', fontWeight: 'bold' } },
                xAxis: { labels: { style: { color: '#000000', fontFamily: 'inherit' } } },
                yAxis: {
                    labels: { style: { color: '#000000', fontFamily: 'inherit' } },
                    title: { style: { color: '#000000', fontFamily: 'inherit' } }
                },
                tooltip: { style: { fontFamily: 'inherit' } }
            });

            loadData();
            loadReserveReturnData();
            loadNonConfData();
            loadAgingMovementChart();
            loadScheduleSummary();

            setInterval(function () {
                loadData();
                loadReserveReturnData();
                loadNonConfData();
                loadAgingMovementChart();
                loadScheduleSummary();
            }, 300000);
        });

        function loadData() {
            $.post('@Url.Action("GetRequestorSummary", "User")', function (data) {
                $('#total-submission').text(data.submission);
                $('#total-received').text(data.received);
                $('#total-putaway').text(data.putaway);
                $('#total-partially-picked').text(data.partiallyPicked);
                $('#total-closed').text(data.closed);
                renderCharts(data);
            });
        }

         function loadNonConfData() {
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetRecentNonConf", "User")",
                success: function (response) {
                    $('#nonconf-table-container').html(response);
                },
                error: function () {
                    $('#nonconf-table-container').html(`
                        <div class="alert alert-danger m-2">
                            <i class="fas fa-exclamation-triangle"></i> Failed to load non-conformance data
                        </div>
                    `);
                }
            });
        }

        function loadReserveReturnData() {
            $.post('@Url.Action("GetReservationList", "User")', { draw: 1, start: 0, length: 1000 }, function (response) {
                if (response.data) processReservationChart(response.data);
            });
            $.post('@Url.Action("GetReturnList", "User")', { draw: 1, start: 0, length: 1000 }, function (response) {
                if (response.data) processReturnChart(response.data);
            });
        }
        function loadAgingMovementChart() {
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetAgingMovementChart", "User")",
                success: function (res) {
                    var categories = [], series1 = [], series2 = [], series3 = [], series4 = [];
                    $.each(res, function (i, item) {
                        categories.push(item.label);
                        series1.push(item.value1);
                        series2.push(item.value2);
                        series3.push(item.value3);
                        series4.push(item.value4);
                    });
                    Highcharts.chart('aging_chart', {
                        chart: { type: 'column' },
                        title: { text: '' },
                        credits: { enabled: false },
                        xAxis: { categories: categories },
                        yAxis: { min: 0, title: { text: 'Total' }, stackLabels: { enabled: false } },
                        legend: { align: 'center', verticalAlign: 'bottom', itemStyle: { fontSize: '11px', fontWeight: 'normal' } },
                        tooltip: { headerFormat: '<b>{point.key}</b><br/>', pointFormat: '{series.name}: {point.y}<br/>Total: {point.stackTotal}' },
                        plotOptions: {
                            column: {
                                stacking: 'normal',
                                dataLabels: { enabled: true },
                                cursor: 'pointer',
                                borderRadius: 6,
                                borderWidth: 0,
                                point: {
                                    events: {
                                        click: function () {
                                            openAgingModal(this.series.name);
                                        }
                                    }
                                }
                            }
                        },
                        series: [
                            { name: '<= 3 Months',  data: series1, color: '#22A855' },
                            { name: '<= 6 Months',  data: series2, color: '#FFBF00' },
                            { name: '<= 12 Months', data: series3, color: '#F45C1B' },
                            { name: '> 1 Year',     data: series4, color: '#E03131' }
                        ]
                    });
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.error("Error loading Aging Movement Chart:", textStatus, errorThrown);
                }
            });
        }
             function loadScheduleSummary() {
            $.ajax({
                url: '@Url.Action("GetSchedules", "User")',
                type: 'GET',
                success: function (res) {
                    if (!res.success || !res.data) { console.error('Failed load schedules'); return; }
                    const schedules = res.data;
                    const now = new Date();
                    const nextWeek = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);

                    let total = schedules.length, upcoming = 0, completed = 0;
                    schedules.forEach(item => {
                        if (item.isCompleted) {
                            completed++;                                          // ← dari flag
                        } else if (new Date(item.start) >= now && new Date(item.start) <= nextWeek) {
                            upcoming++;
                        }
                    });
                    renderSummaryChart({ total, upcoming, completed });
                },
                error: function (err) { console.error('Error load schedules:', err); }
            });
        }

                     function renderSummaryChart(data) {
            Highcharts.chart('summary_chart', {
                chart: { type: 'column' },
                title: { text: null },
                credits: { enabled: false },
                xAxis: { categories: ['Schedule Status'] },
                yAxis: { min: 0, title: { text: 'Total Schedule' } },
                legend: { enabled: true, align: 'center', verticalAlign: 'bottom', layout: 'horizontal', itemStyle: { fontSize: '11px', fontWeight: 'normal' } },
                tooltip: { pointFormat: '<b>{series.name}</b>: {point.y}<br/><i>Click to view details</i>' },
                plotOptions: {
                    column: {
                        dataLabels: { enabled: true },
                        cursor: 'pointer',
                        borderRadius: 6,
                        borderWidth: 0,
                        point: {
                            events: {
                                click: function () {
                                    const categoryMap = { 'Total': 'TOTAL', 'Upcoming': 'UPCOMING', 'Completed': 'COMPLETED' };
                                    filterScheduleByCategory(categoryMap[this.series.name] || this.series.name);
                                }
                            }
                        }
                    }
                },
                series: [
                    { name: 'Total',     data: [data.total],     color: '#2196C9' },
                    { name: 'Upcoming',  data: [data.upcoming],  color: '#FFBF00' },
                    { name: 'Completed', data: [data.completed], color: '#22A855' }
                ]
            });
        }

                function filterScheduleByCategory(category) {
            let title = category === 'TOTAL' ? 'All Schedules' :
                        category === 'UPCOMING' ? 'Upcoming This Week' : 'Completed Schedules';

            $('#scheduleModalTitle').text(title);
            $('#scheduleModalContent').html(`
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-success"></i>
                    <p class="mt-3">Loading ${title}...</p>
                </div>
            `);
            $('#modal_schedule_detail').modal('show');

                 $.get('/User/GetScheduleDetailsPartial', { category: category }, function (data) {
            $('#scheduleModalContent').html(data);
            Swal.fire({
                icon: 'success',
                title: 'Data Loaded',
                text: 'Showing ' + title,
                timer: 1500,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
            });
        }).fail(function () {
            $('#scheduleModalContent').html('<div class="alert alert-danger m-3">Failed to load data.</div>');
        });
        }

        function processReservationChart(data) {
            let statusCount = { submission: 0, approved: 0, cancelled: 0 };
            data.forEach(function (item) {
                let status = (item.status_desc || '').toLowerCase();
                if (status.includes('submission')) { statusCount.submission++; }
                else if (status.includes('approved')) { statusCount.approved++; }
                else if (status.includes('cancelled')) { statusCount.cancelled++; }
            });
            renderReservationChart(statusCount);
        }

        function processReturnChart(data) {
            let statusCount = { sent: 0, approved: 0, inTransit: 0, returned: 0 };
            data.forEach(function (item) {
                let status = (item.status_desc || '').toLowerCase();
                if (status.includes('sent')) { statusCount.sent++; }
                else if (status.includes('approved')) { statusCount.approved++; }
                else if (status.includes('transit')) { statusCount.inTransit++; }
                else if (status.includes('returned')) { statusCount.returned++; }
            });
            renderReturnChart(statusCount);
        }

        function renderReservationChart(statusCount) {
            Highcharts.chart('reserve_chart', {
                chart: { type: 'pie' },
                title: { text: null },
                credits: { enabled: false },
