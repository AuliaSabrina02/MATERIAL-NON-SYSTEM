        function filterReturnByStatus(statusName) {
            const statusMapping = { 'Sent': 'Sent', 'Approved': 'Approved', 'In Transit': 'In Transit', 'Returned': 'Returned' };
            const statusValue = statusMapping[statusName] || statusName;

            $('#modal_filtered_returns').modal('show');
