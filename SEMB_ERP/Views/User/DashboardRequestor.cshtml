            function filterReturnByStatus(statusName) {
            const statusMapping = {
                'Sent': 'Sent',
                'Approved': 'Approved',
                'In Transit': 'In Transit',
                'Returned': 'Returned'
            };

            const statusValue = statusMapping[statusName] || statusName;
            console.log('Loading returns with status:', statusValue);

            $('#modal_filtered_returns').modal('show');
            $('#body_filtered_returns').html(`
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-primary"></i>
                    <p class="mt-3">Loading <strong>${statusName}</strong> returns...</p>
                </div>
            `);

            $.ajax({
                type: "GET",
                url: "@Url.Action("GetReturnListByStatus", "User")",
                data: { status: statusValue },
                success: function(response) {
                    $('#body_filtered_returns').html(response);

                    Swal.fire({
                        icon: 'success',
                        title: 'Data Loaded',
                        text: 'Showing ' + statusName + ' returns',
                        timer: 1500,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                },
                error: function(xhr, status, error) {
                    $('#body_filtered_returns').html(`
                        <div class="alert alert-danger m-3">
                            <i class="fas fa-exclamation-triangle"></i>
                            Error loading data: ${error}
                        </div>
                    `);
                    console.error('Error:', error);
                }
            });
        }

        function getStatusBadge(status) {
            status = status.toLowerCase();
            if (status.includes('picking')) return `<span class="badge bg-warning text-dark">PICKING</span>`;
            if (status.includes('close')) return `<span class="badge bg-secondary">CLOSED</span>`;
            if (status.includes('done')) return `<span class="badge bg-success">DONE</span>`;
            return `<span class="badge bg-info">${status.toUpperCase()}</span>`;
        }

        function renderCharts(data) {
            const chartData = [
                { name: 'Submission', y: data.submission, color: '#6c757d' },
                { name: 'Received', y: data.received, color: '#007bff' },
                { name: 'Putaway', y: data.putaway, color: '#ffc107' },
                { name: 'Partial', y: data.partiallyPicked, color: '#fd7e14' },
                { name: 'Closed', y: data.closed, color: '#28a745' }
            ];

            Highcharts.chart('bar_chart', {
            chart: { type: 'column' },
            title: { text: null },
            credits: { enabled: false },
            xAxis: {
                categories: ['Picking Volume']  
            },
            yAxis: {
                title: { text: 'Total Requests' }
            },
            legend: {
                enabled: true,
                align: 'center',
                verticalAlign: 'bottom',
                layout: 'horizontal',
                itemStyle: {
                    fontSize: '11px',
                    fontWeight: 'normal'
                }
            },
            tooltip: {
                pointFormat: '<b>{series.name}</b>: {point.y}<br/><i>Click to view details</i>'
            },
            plotOptions: {
                column: {
                    dataLabels: { enabled: true },
                    cursor: 'pointer',
                    point: {
                        events: {
                            click: function() {
                                openOrderModal(this.series.name);  
                            }
                        }
                    }
                }
            },
            series: [
                {
                    name: 'Submission',
                    data: [data.submission],
                    color: '#6c757d'
                },
                {
                    name: 'Received',
                    data: [data.received],
                    color: '#007bff'
                },
                {
                    name: 'Putaway',
                    data: [data.putaway],
                    color: '#ffc107'
                },
                {
                    name: 'Partial',
                    data: [data.partiallyPicked],
                    color: '#fd7e14'
                },
                {
                    name: 'Closed',
                    data: [data.closed],
                    color: '#28a745'
                }
            ]
        });
        function openOrderModal(status) {
            const statusMapping = {
                'Submission': 'SUBMISSION',
                'Received': 'RECEIVED',
                'Putaway': 'PUTAWAY',
                'Partial': 'PARTIALLY PICKED', 
                'Closed': 'CLOSED'
            };

            const mappedStatus = statusMapping[status] || status;

            console.log('Opening modal for status:', mappedStatus);

            $('#modalOrderList').modal('show');
            $('#modalOrderListBody').html(`
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-primary"></i>
                    <p class="mt-3">Loading <strong>${status}</strong> orders...</p>
                </div>
            `);

            $.ajax({
                type: "GET",
                url: '@Url.Action("GetOrderListByStatus", "User")',
                data: { status: mappedStatus }, 
                success: function(response) {
                    $('#modalOrderListBody').html(response);
                    setTimeout(function() {
                        $('#modalOrderListBody table').each(function() {
                            if ($.fn.DataTable.isDataTable(this)) {
                                $(this).DataTable().destroy();
                            }
                        });
                        $('#modalOrderListBody table').DataTable({
                            "paging": true,
                            "lengthChange": true,
                            "searching": true,
                            "ordering": true,
                            "info": true,
                            "autoWidth": false,
                            "responsive": true,
                            "pageLength": 10
                        });

                        Swal.fire({
                            icon: 'success',
                            title: 'Data Loaded',
                            text: 'Showing ' + status + ' orders',
                            timer: 1500,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });
                    }, 300);
                },
                error: function(xhr, status, error) {
                    $('#modalOrderListBody').html(`
                        <div class="alert alert-danger m-3">
                            <i class="fas fa-exclamation-triangle"></i>
                            Error loading data: ${error}
                            <br><small>Status: ${xhr.status} - ${xhr.statusText}</small>
                        </div>
                    `);
                    console.error('Error:', error);
                    console.error('Response:', xhr.responseText);
                }
            });
        }
