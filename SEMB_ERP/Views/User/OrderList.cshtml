                                if (row["pic"].toUpperCase() == sesa_id){ // Only PIC can delete
                                    btn_delete = `<div class="mt-1"><button class="btn btn-sm btn-danger btn-block" onclick="delete_order('${data}','${row['partno']}')"><i class="fas fa-trash"></i> Delete</button></div>`;
