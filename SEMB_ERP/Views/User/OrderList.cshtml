        }

        function add_order(id_order,stock_qty){
            $("input[name=picking_id_order]").val(id_order);
            $("input[name=picking_stock_qty]").val(stock_qty);
            $("input[name=picking_req_qty]").val(0);
            $("div#modal_req_picking").modal("show");
        }

        $("form#form_req_picking").submit(function (e) {
            e.preventDefault();
            let formData = new FormData(this);
            let stock_qty = formData.get('picking_stock_qty');
            let req_qty = formData.get('picking_req_qty');
            if(parseFloat(req_qty)>parseFloat(stock_qty)){
                swal.fire("Failed!", "Request qty is more than stock qty!", "error");
                return;
            }
            else if(parseFloat(req_qty) == 0){
                swal.fire("Failed!", "Request qty can't 0!", "error");
                return;
            }
            else {
                // console.log(formData);
                Swal.fire({
                    title: 'Confirmation!!',
                    text: "Are you sure ?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#dc3545',
                    confirmButtonText: 'Yes!',
                    cancelButtonText: 'No!',
                    showLoaderOnConfirm: true,
                    preConfirm: function () {
                        return new Promise(function (resolve, reject) {
                            $.ajax({
                                url: "@Url.Action("AddReqPicking")",
                                type: 'POST',
                                data: formData,
                                cache: false,
                                contentType: false,
                                processData: false
                            }).done(function (msg) {
                                let arr = msg.split(";");
                                if (arr[0] == "success") {
                                    swal.fire("Success!", arr[1], "success").then(function () {
                                        get_total_req();
                                        $("div#modal_req_picking").modal("hide");
                                        $("#table_order").DataTable().ajax.reload(null, false);
                                    })
                                }
                                else {
                                    swal.fire("Failed!", msg, "error");
                                }
                            })
                        })
                    },
                    allowOutsideClick: () => !Swal.isLoading()
                })
            }
        })

        function open_request_list() {
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetTempReqList")"
            }).done(function(res){
                $("div#body_req_list").html(res);
