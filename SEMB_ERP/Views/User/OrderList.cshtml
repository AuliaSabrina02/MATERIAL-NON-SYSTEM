@section Scripts {

    <script>
        var table;
        var loading = "<div class='text-center'><i class='fa fa-4x fa-spinner fa-spin'></i></div>";
        var id_order_array = [];
        var sesa_id = "@user.sesa_id".toUpperCase();
        var user_roles = @Html.Raw(Json.Serialize(userRoles));
        var list_printers = @Html.Raw(Json.Serialize(listPrinter));
        const printInputOptions = list_printers.reduce((acc, text) => {
            acc[text] = text;
            return acc;
        }, {});

        $(document).ready(function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            })
            get_total_req();

            var table = $("#table_order").DataTable({
                // "searching": false,
                // "scrollX": true,
                // "fixedColumns": {
                //     rightColumns: 1
                // },
                "orderCellsTop": true,
                "processing": true,
                "serverSide": true,
                "filter": true,
                "ajax": {
                    "url": "@Url.Action("GetOrderList")",
                    "type": "POST",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "status_desc", 
                        "className": "align-middle",
                        "render": function (data, type, row) {
                            return data;
                        }
                    },
                    {
                        "data": "id_order",
                        "className": "text-center align-middle",
                        "render": function (data, type, row) {
                            if (row["status_code"] == 1 && user_roles.includes("receiver") &&
                                row["length_mm"] > 0 &&
                                row["width_mm"] > 0 &&
                                row["height_mm"] > 0) {
                                let order_check = "";
                                let is_checked = "";
                                if (id_order_array.includes(data)) {
                                    order_check = "checked";
                                    is_checked = "1";
                                }
                                // return `<button class="btn btn-sm btn-info" onclick="start_gr('${data}')"><i class="fas fa-arrow-right"></i> GR</button>`;
                                return `<input type="checkbox" class="form-input form-check-input bigger-checkbox all_row" name='id_order[]' onclick="select_id(${data})" id="id_order-${data}" value="${data}" ${order_check} />
                                        <label class="form-check-label" for="id_order-${data}"></label>
                                        <div class="check_sort" id="sort-${data}" hidden>${is_checked}</div>`;
                            }
                            else if (row["status_code"] == 1) {
                                return `<i class="text-danger fas fa-exclamation-circle" style="font-size:14pt" data-bs-toggle="tooltip" data-bs-placement="right" title="Please fill in dimension!!"></i>`;
                            }
                            else{
                                return `<button class="btn btn-sm btn-warning " onclick="box_list(${data})"><i class="fas fa-clipboard"></i></button>`;
                            }
                        }
                    },
                    { "data": "material_type", "className": "align-middle" },
                    { "data": "partno", "className": "align-middle" },
                    { "data": "po_no", "className": "align-middle" },
                    { "data": "qty", "className": "align-middle" },
                    { "data": "picked_qty", "className": "align-middle" },
                    { "data": "available_qty", "className": "align-middle" },
                    { "data": "uom", "className": "align-middle" },
                    { "data": "revision", "className": "align-middle" },
                    { "data": "project_name", "className": "align-middle" },
                    { "data": "storage_requirement", "className": "align-middle" },
                    { "data": "supplier_name", "className": "align-middle" },
                    { "data": "pic_name", "className": "align-middle" },
                    { "data": "order_type", "className": "align-middle" },
                    {
                        "data": "unit_price",
                        "className": "text-center align-middle",
                        "render": function (data, type, row) {
                            if (data === null || data == "") {
                                return "";
                            }
                            else {
                                return `$ `+ data.toFixed(2);
                            }
                        }
                    },
                    { "data": "gatepass", "className": "align-middle" },
                    {
                      data: "record_date",
                      className: "align-middle",
                      render: function (data, type, row) {
                        const date = new Date(data);
                        const day = String(date.getDate()).padStart(2, '0');
                        const month = String(date.getMonth() + 1).padStart(2, '0');
                        const year = date.getFullYear();
                        const hours = String(date.getHours()).padStart(2, '0');
                        const minutes = String(date.getMinutes()).padStart(2, '0');
                        const seconds = String(date.getSeconds()).padStart(2, '0');
                        return `${day}-${month}-${year} ${hours}:${minutes}:${seconds}`;
                      }
                    },

                    {
                        "data": "file_support",
                        "className": "text-center align-middle",
                        "render": function (data, type, row) {
                            if (data === null || data == "") {
                                return "";
                            }
                            else {
                                return `<a href="../Documents/${data}" target="_blank">
                                        <button class="btn btn-sm btn-danger">
                                            <i class="fas fa-file-alt"></i>
                                        </button>
                                    </a>`;
                            }
                        }
                    },
                    { "data": "length_mm", "className": "align-middle" },
                    { "data": "width_mm", "className": "align-middle" },
                    { "data": "height_mm", "className": "align-middle" },
                    {
                        "data": "id_order",
                        "className": "align-middle text-center",
                        "render": function (data, type, row) {
                            let btn_edit = "";
                            let btn_delete = "";
                            let btn_order_picking = "";
                            if (row['status_code'] == 1 && 
