        function kitting_box(id_order, kitting_box, qty){
            $("div#body_box_kitting").find("input[name=box_id]").val(kitting_box);
            $("div#body_box_kitting").find("input[name=box_qty]").val(qty);
            $("div#body_box_kitting").find("input[name=spq]").val("");
            $("div#review_box_kitting").html("");
            $("div#modal_box_kitting").modal("show");
        }

        $("button[name=btn_next_kitting]").click(function(){
            let box_id = $("div#body_box_kitting").find("input[name=box_id]").val();
            let total_qty = $("div#body_box_kitting").find("input[name=box_qty]").val();
            let spq = $("div#body_box_kitting").find("input[name=spq]").val();
            if (parseFloat(spq) > parseFloat(total_qty)) {
                swal.fire("Failed!", "Total box exceed total qty!", "error");
            }
            else {
                $("div#review_box_kitting").html(loading);
                $.ajax({
                    type: "GET",
                    url: "@Url.Action("CreateListBox")",
                    data: {
                        box_id: box_id,
                        total_qty: total_qty,
                        spq: spq
                    }
                }).done(function (res) {
                    $("div#review_box_kitting").html(res);
                }).fail(function (err) {
                    $("div#review_box_kitting").html(err);
                    swal.fire("Error!", "Error get list box", "error");
                })
            }
        })

        function showLoadingSpinner(msg = 'Please wait...') {
