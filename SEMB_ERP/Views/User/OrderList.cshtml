                            if (response.trim() === "OK") {
                                Swal.fire(
                                    'Deleted!',
                                    'Order has been Deleted.',
                                    'success'
                                );
                            } else {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Warning!',
                                    text: 'Unexpected response received.',
                                    confirmButtonText: 'OK'
                                });
                            }
                            $("#table_order").DataTable().ajax.reload(null, false);
                        },
                        error: function(xhr, status, error) {
                            alert("An error occurred while deleting Order: " + error);
                        }
                    });
                }
            });
        }

