                            if ((row['status_code'].toLowerCase() == 3 || row['status_code'].toLowerCase() == 4) && row["pic"].toUpperCase() == sesa_id) { // Only PIC can request picking
                                btn_order_picking = `<button class="btn btn-sm btn-success" onclick="add_order(${row['id_order']},${row['available_qty']})"><i class="fas fa-plus"></i> Req. Picking</button>`;
                            }
                            return btn_edit + btn_delete + btn_order_picking;
                        }
                    }
