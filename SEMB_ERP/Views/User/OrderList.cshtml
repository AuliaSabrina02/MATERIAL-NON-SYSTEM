@* @using System.Data; *@
@model List<UserDetailModel>
@using Microsoft.AspNetCore.Mvc.Rendering;
@using Microsoft.AspNetCore.Http;
@using SEMB_ERP.Function;
@{
    var user = Model.First();
    string sesa_id = ViewBag.sesa_id;
    string name = ViewBag.name;
    List<string> listStatus = ViewBag.listStatus;
    List<string> userRoles = ViewBag.userRoles;
    List<string> listPrinter = ViewBag.listPrinter;
}

<style>
    /* CSS untuk membuat modal berada di tengah layar */
    #loadingSpinner {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.5); /* Transparan hitam */
    }

    #loadingSpinner img {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .box_form_input {
        background-color: #fcfcfc;
        border-radius: 5px;
        box-shadow: 1px 2px 8px 2px rgba(152,152,152,0.7);
    }

    .modal{
        overflow: auto !important
    }

    .smaller-input {
        height: 25px; /* Adjust height as necessary */
        padding: 5px; /* Adjust padding as necessary */
        font-size: 10px; /* Optional: Adjust font size */
        line-height: 1; /* Optional: Reset line height */
    }

    /* Customize the font size for DataTables elements */
    .dataTables_info, .dataTables_paginate, .dataTables_filter {
        font-size: 10pt; /* Adjust the value to your desired font size */
    }

    #table_order_filter.dataTables_filter {
        display: none;
    }

    table#table_order tr > th {
        padding: 5px;
    }

    table#table_order tr > td {
        padding: 5px;
    }

    .btn-group-xs > .btn, .btn-xs {
        padding: .25rem .4rem;
        font-size: .875rem;
        line-height: .5;
        border-radius: .2rem;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-check-input.bigger-checkbox {
        margin-left: 0.2px;
        transform: scale(2); /* Adjust the scale as needed */
    }

</style>

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 mt-3">
                <div class="card card-success card-outline">
@*                     <div class="card-header">
                        <h3 class="text-center half-underline">
                            <i class="fas fa-list"></i>
                            Asset List
                        </h3>
                    </div> *@
                    <div class="card-header">
                        <h5>
                            <i class="fas fa-list"></i>
                            Request List
                        </h5>
                        <div class="card-tools">
                            <button class="btn btn-primary" onclick="open_request_list()"><i class="fas fa-arrow-right"></i> Req. Picking List <span id="total_req" class="badge bg-danger">0</span></button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @* <div class="col-12 d-flex justify-content-end mb-2">
                                <a href="@Url.Action("DOWNLOAD_ASSET_LIST", "Requestor")" id="btn_download_data" class="btn btn-dark">
                                    <i class="fas fa-download"></i> Download Asset List
                                </a>
                            </div> *@
                            @* <div class="col-12 text-right">
                                <button class="btn btn-success" name="btn_gr"><i class="fas fa-boxes"></i> GR</button>
                            </div> *@
                            <div class="col-12 table-responsive">
                                <table class="table table-bordered table-striped align-center nowrap" id="table_order" style="font-size:10pt;width:100%;">
                                    <thead class="bg-info align-middle text-center">
                                        <tr>
                                            <th>Status</th>
                                            <th rowspan="2">Goods<br />Receipt</th>
                                            <th>Material Type</th>
                                            <th>Part No</th>
                                            <th>PO NO</th>
                                            <th>Qty</th>
                                            <th>Pick.Qty</th>
                                            <th>Avai.Qty</th>
                                            <th>UOM</th>
                                            <th>Revision</th>
                                            <th>Project Name</th>
                                            <th>Storage Requirement</th>
                                            <th>Supplier Name</th>
                                            <th>PIC</th>
                                            <th>Order Type</th>
                                            <th>Unit Price</th>
                                            <th>Gatepass</th>
                                            <th rowspan="2">Order<br />Date</th>
                                            <th rowspan="2">File<br />Support</th>
                                            <th class="align-middle" colspan="3">Dimension</th> <!-- Merged cell for File Tag -->
                                            <th rowspan="2">Action</th>
                                        </tr>
                                        @* <tr>
                                            <th>Length(mm)</th>
                                            <th>Width(mm)</th>
                                            <th>Height(mm)</th>
                                        </tr> *@
                                        <tr>
                                            @for (int i = 0; i < 17; i++) // Adjusted the loop to 24 to exclude Img Tagging
                                            {
                                                if (i != 1) // i!=1, because column index 1 is for button GR
                                                {
                                                    if (i == 0)
                                                    {
                                                        <td>
                                                            <select class="form-control smaller-input filter_table" target="@i">
                                                                <option value="">#ALL</option>
                                                                @foreach (var status in listStatus)
                                                                {
                                                                    <option value="@status">@status</option>
                                                                }
                                                            </select>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td><input type="text" class="form-control smaller-input filter_table" placeholder="Filter..." target="@i" /></td>
                                                    }
                                                }
                                            }
                                            <th>L(mm)</th>
                                            <th>W(mm)</th>
                                            <th>H(mm)</th>
                                        </tr>
                                    </thead>
                                    @if (userRoles.HasAnyRole("receiver"))
                                    {
                                        <tfoot>
                                            <tr>
                                                <td colspan="21" class="text-center">
                                                    <button class="btn btn-info" name="start_gr"><i class="fas fa-arrow-right"></i> GR <span id="total_gr_line"></span></button>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    }
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Element spinner -->
            <div id="loadingSpinner" style="display: none;">
                <img src="~/images/icon/loading.gif" alt="Loading..." />
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_update_order" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success">
                <h5 class="modal-title" id="chart_title"><i class="fas fa-edit"></i> Update Non Conformity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="body_update_posting">
                <form id="form_update_order">
                    <div class="row">
                        <div class="col-6 pl-4 pr-4">
                            <input class="form-control" type="hidden" name="id_order"  autocomplete="off" required />
                            <div class="form-group">
                                <label>Material Type<span class="text-danger">*</span></label>
                                <select class="form-select" name="material_type" required>
                                    <option value="">--SELECT--</option>
                                    <option value="RM">Raw Material (RM)</option>
                                    <option value="FG">Finish Goods (FG)</option>
                                    <option value="WIP">Work In Progress (WIP)</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Part No<span class="text-danger">*</span></label>
                                <input class="form-control" type="text" name="partno" placeholder="Part Number" autocomplete="off" required />
                            </div>
                            <div class="form-group">
                                <label>PO No<span class="text-danger">*</span></label>
                                <input class="form-control" type="text" name="po_no" placeholder="PO Number" autocomplete="off" required />
                            </div>
                            <div class="form-group">
                                <label>Qty<span class="text-danger">*</span></label>
                                <input class="form-control" type="number" name="qty" placeholder="Qty" step="any" autocomplete="off" required />
                            </div>
                            <div class="form-group">
                                <label>UOM<span class="text-danger">*</span></label>
                                <input class="form-control" type="text" name="uom" placeholder="PC, PALLET, ..." autocomplete="off" required />
                            </div>
                            <div class="form-group">
                                <label>Revision<span class="text-danger">*</span></label>
                                <input class="form-control" type="text" name="revision" placeholder="Revision" autocomplete="off" required />
                            </div>
                            <div class="form-group">
                                <label>Project Name<span class="text-danger">*</span></label>
                                <input class="form-control" type="text" name="project_name" placeholder="Project Name" autocomplete="off" required />
                            </div>
                            <div class="form-group">
                                <label>Storage Requirement<span class="text-danger">*</span></label>
                                <select class="form-select" name="storage_requirement" required>
                                    <option value="">--SELECT--</option>
                                    <option value="AC">AC</option>
                                    <option value="Non AC">Non AC</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-6 pl-4 pr-4">
                            <div class="form-group">
                                <label>Supplier Name<span class="text-danger">*</span></label>
                                <input class="form-control" type="text" name="supplier_name" placeholder="Supplier" autocomplete="off" required />
                            </div>
                            <div class="form-group">
                                <label>PIC<span class="text-danger">*</span></label>
                                <input class="form-control" type="text" name="pic_display" autocomplete="off" required readonly />
                            </div>
                            <div class="form-group">
                                <label>Order Type<span class="text-danger">*</span></label>
                                <select class="form-select" name="order_type" required>
                                    <option value="">--SELECT--</option>
                                    <option value="Apollo">Apollo</option>
                                    <option value="Coupa">Coupa</option>
                                    <option value="FOC">FOC</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Price<span class="text-danger">*</span></label>
                                <input class="form-control" type="number" name="unit_price" placeholder="Price" autocomplete="off" step="any" required />
                            </div>
                            <div class="row">
                                <div class="col-4">
                                    <div class="form-group">
                                        <label>Length (mm)</label>
                                        <input class="form-control" type="number" name="length_mm" placeholder="Length (mm)" autocomplete="off" step="any" />
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="form-group">
                                        <label>Width (mm)</label>
                                        <input class="form-control" type="number" name="width_mm" placeholder="Width (mm)" autocomplete="off" step="any" />
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="form-group">
                                        <label>Height (mm)</label>
                                        <input class="form-control" type="number" name="height_mm" placeholder="Height (mm)" autocomplete="off" step="any" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Remark</label>
                                <textarea class="form-control" name="remark" rows="3"></textarea>
                            </div>
                            <div class="form-group">
                                <label>Gatepass</label>
                                <input class="form-control" type="text" name="gatepass" placeholder="Gatepass" autocomplete="off"/>
                            </div>
                            <div class="form-group">
                                <label>Supporting Documents (Excel or PDF)</label>
                                <input type="file" class="form-control" name="file_support">
                                <div id="file_preview" class="mt-2"></div> <!-- Add this line for file preview -->
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-group text-center">
                                <button type="submit" class="btn btn-success mt-2" name="btn_confirm">Update Order <i class="fa fa-arrow-right"></i></button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


