                            swal.fire("Error!", err, "error");
                        })
                    })
                },
                allowOutsideClick: () => !Swal.isLoading()
            })
        }

        function box_list(orderId){
            $("#modal_box_info").data("orderId", orderId);
            if ($.fn.DataTable.isDataTable('#tbl_box_list')) {
                $('#tbl_box_list').DataTable().clear().destroy();
            }
            $("#modal_box_info").modal('show');

            $('#tbl_box_list').DataTable({
                "ajax": {
                    "url": '@Url.Action("GetBoxList")',
                    "data": {
                        orderId: orderId
                    },
                    "dataSrc": function (json) {
                        console.log("AJAX response:", json);
                        return json.map(function (item) {
                            return {
                                BoxId: item.boxId,
                                PartNo: item.partNo,
                                Qty: item.qty,
                                Sbin: item.sbin,
                                Unit: item.unit,
                                Pstats: item.pstats,
                            };
                        });
                    }
                },
                "columns": [
                    { data: "BoxId", title: "Box Id" },
                    { data: "PartNo", title: "Part No" },
                    { data: "Qty", title: "Qty" },
                    { data: "Sbin", title: "Storage Bin" },
                    { data: "Unit", title: "Unit" },
                    { data: "Pstats", title: "Picking Status" },
                    {
                        data: "BoxId",
                        "render": function (data, type, row) {
                            let kitting_btn = row['Pstats'] != "DONE" ? `<button class='btn btn-sm btn-warning ml-1' onclick="kitting_box('${orderId}','${data}','${row['Qty']}')"><i class='fas fa-boxes'></i> Kitting</button>` : ``;
                            return `<button class='btn btn-sm btn-success' onclick="print_box('${data}')"><i class='fas fa-print'></i> Print</button>${kitting_btn}`;
                        }
                    }
                ],
                "searching": true,
                "paging": true,
                "info": true,
                "ordering": false,
                "order": [[0, "asc"]],

            });
        }

