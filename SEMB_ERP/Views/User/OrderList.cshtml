<div class="modal fade" id="modal_req_picking" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success">
                <h5 class="modal-title" id="chart_title"><i class="fas fa-plus"></i> Add Request Picking</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="body_update_posting">
                <form id="form_req_picking">
                    <div class="row">
                        <div class="col-12">
                            <input class="form-control" type="hidden" name="picking_id_order" autocomplete="off" required />
                            <div class="form-group">
                                <label>Stock Qty</label>
                                <input class="form-control" type="text" name="picking_stock_qty" placeholder="Part Number" autocomplete="off" readonly />
