@* @using System.Data; *@
@model List<TempBoxModel>
@using Microsoft.AspNetCore.Mvc.Rendering;
@using Microsoft.AspNetCore.Http;
@using SEMB_ERP.Function;
@using System.Text.Json;
@{
    string sesa_id = ViewBag.sesa_id;
    string name = ViewBag.name;
    int id_request = ViewBag.id_request;
    var reqInfo = ViewBag.reqInfo;
    List<PalletModel> palletList = ViewBag.palletList;
    List<string> userRoles = ViewBag.userRoles;
    List<string> printList = ViewBag.printList;

    List<string> palletOpt = new List<string>();
    foreach(var pallet in palletList)
    {
        palletOpt.Add("<option value='"+pallet.id_pallet+"'>"+pallet.pallet_no+"</option>");
    }

    List<string> printOpt = new List<string>();
    foreach (var print in printList)
    {
        printOpt.Add("<option value='" + print + "'>" + print + "</option>");
    }

    int total_scanned = 0;
    int no = 0;
}

<style>
    /* CSS untuk membuat modal berada di tengah layar */
    #loadingSpinner {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.5); /* Transparan hitam */
    }

    #loadingSpinner img {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .box_form_input {
        background-color: #fcfcfc;
        border-radius: 5px;
        box-shadow: 1px 2px 8px 2px rgba(152,152,152,0.7);
    }

    .modal{
        overflow: auto !important
    }

    .smaller-input {
        height: 25px; /* Adjust height as necessary */
        padding: 5px; /* Adjust padding as necessary */
        font-size: 10px; /* Optional: Adjust font size */
        line-height: 1; /* Optional: Reset line height */
    }

    /* Customize the font size for DataTables elements */
    .dataTables_info, .dataTables_paginate, .dataTables_filter {
        font-size: 10pt; /* Adjust the value to your desired font size */
    }

    .dataTables_filter {
        display: none; /* Hides just the input field */
    }

    table#table_req tr > th {
        padding: 5px;
    }

    table#table_req tr > td {
        padding: 5px;
    }

    .btn-group-xs > .btn, .btn-xs {
        padding: .25rem .4rem;
        font-size: .875rem;
        line-height: .5;
        border-radius: .2rem;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-check-input.bigger-checkbox {
        margin-left: 15px;
        transform: scale(2); /* Adjust the scale as needed */
    }

</style>

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 mt-3">
                <div class="card card-success">
@*                     <div class="card-header">
                        <h3 class="text-center half-underline">
                            <i class="fas fa-list"></i>
                            Asset List
                        </h3>
                    </div> *@
                    <div class="card-header">
                        <h5>
                            <i class="fas fa-list"></i>
                            Consolidation - Scan Box
                        </h5>
                        <div class="card-tools d-flex justify-content-end">
                            @* <div class="float-right"> *@
                                <a href="@Url.Action("Consolidation")" class="btn btn-sm btn-warning"><i class="fas fa-arrow-left"></i> Cancel</a>
                            @* </div> *@
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-12 text-center mt-2 mb-2">
                                <h6 class="font-weight-bold">Req.No : <span class="badge bg-secondary" style="font-size:12pt">@reqInfo.request_no</span></h6>
                            </div>
                            <div class="col-12 table-responsive">
                                <div class="m-b-3">
                                    <input type="hidden" name="id_request" value="@id_request">
                                </div>
                                <div class="form-group">
                                    <input type="text" name="scan_box" class="form-control text-center" placeholder="Scan Box" autofocus="on" autocomplete="off">
                                </div>
                            </div>
                            <div class="col-12 table-responsive">
                                <table class="table table-sm table-bordered">
                                    <tr>
                                        <th>No.</th>
                                        <th>Box ID</th>
                                    </tr>
                                    @foreach(var temp in Model)
                                    {
                                        string bg_row = temp.box_id_consol != "-" ? "bg-success" : "bg-danger";
                                        if (temp.box_id_consol != "-")
                                        {
                                            total_scanned++;
                                        }
                                        no++;
                                        <tr class="@bg_row">
                                            <td>@no</td>
                                            <td>@temp.box_id</td>
                                        </tr>
                                    }
                                </table>
                                <div class="text-center">
                                    @if (total_scanned > 0)
                                    {
                                        <button class="btn btn-sm btn-success" name="btn_finish"><i class="fas fa-flag"></i> Finish</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Element spinner -->
            <div id="loadingSpinner" style="display: none;">
                <img src="~/images/icon/loading.gif" alt="Loading..." />
            </div>
        </div>
    </div>
</div>


@section Scripts {

    <script>
        var table;
        var loading = "<div class='text-center'><i class='fa fa-4x fa-spinner fa-spin'></i></div>";
        var sesa_id = "@sesa_id".toUpperCase();

        $(document).ready(function () {
            var pallet_opt = @Html.Raw(Json.Serialize(palletOpt));
            var print_opt = @Html.Raw(Json.Serialize(printOpt));

            $("input[name=scan_box]").focus();

            $("input[name=scan_box]").keyup(function (event) {
                if (event.keyCode == 13) {
                    let scan_box = $(this).val();
                    let id_request = $("input[name=id_request]").val();
                    if (scan_box == "") {
                        swal.fire("Failed!", "Please Scan Box!!", "error");
                    }
                    else {
                        $.ajax({
                            type: "POST",
                            url: "@Url.Action("CheckBoxConsol")",
                            data: {
                                id_request: id_request,
                                box_id: scan_box
                            }
                        }).done(function (res) {
                            let arr = res.split(";");
                            if (arr[0] == "OK") {
                                location.reload();
                            }
                            else if (arr[0] == "ERROR") {
                                $("input[name=scan_box]").val("");
                                swal.fire("Failed!", arr[1], "warning");
                            }
                            else {
                                $("input[name=scan_box]").val("");
                                swal.fire("Error!", res, "error");
                            }
                        }).fail(function (err) {
                            swal.fire("Page Error!", err, "error");
                        })
                    }
                }
            })

            $("button[name=btn_finish]").click(function () {
                Swal.fire({
                    title: 'Are you sure?',
                    text: "Select options!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Confirm',
                    html: `<div style="display: flex; flex-direction: column;">
                               <label for="select_pallet" style="margin-bottom: 5px; font-weight: bold;">Select Pallet :</label>
                               <select id="select_pallet" class="swal2-input">
                                  <option value="0">New Pallet</option>
                                  ${pallet_opt.join("")}
                               </select>
                               <label for="select_printer" style="margin-top: 15px; margin-bottom: 5px; font-weight: bold;">Select Printer :</label>
                               <select id="select_printer" class="swal2-input">
                                  ${print_opt.join("")}
                               </select>
                               </div>`,
                    focusConfirm: false,
                    preConfirm: () => {
                        const select1 = document.getElementById('select_pallet');
                        const select2 = document.getElementById('select_printer');
                        return select1 && select2 ? [select1.value, select2.value] : null;
                    },
                }).then((result) => {
                    if (result.isConfirmed) {
                        const selectedValues = result.value;
                        console.log(selectedValues);
                        if (selectedValues) {
                            let id_request = $("input[name=id_request]").val();
                            $.ajax({
                                type: "POST",
                                url: "@Url.Action("CreatePallet")",
                                data: {
                                    id_request: id_request,
                                    id_pallet: selectedValues[0]
                                }
                            }).done(function(res){
                                let arr = res.split(";");
                                if (arr[0] == "OK") {
                                    print_label(selectedValues[1], arr[1]);
                                }
                                else{
                                    swal.fire("Error!", res, "error");
                                }
                            }).fail(function(err){
                                swal.fire("Page Error!", err, "error");
                            })
                            // Swal.fire(
                            //     'Confirmed!',
                            //     `You selected: ${selectedValues[0]} and ${selectedValues[1]}`,
                            //     'success'
                            // );
                        } else {
                            Swal.fire(
                                'Cancelled',
                                'No options were selected',
                                'error'
                            );
                        }
                    } else if (result.dismiss === Swal.DismissReason.cancel) {
                        Swal.fire(
                            'Cancelled',
                            'Operation cancelled',
                            'error'
                        );
                    }
                });
            })

        })

        function print_label(print, pallet_no) {
            // let url_print = "http://10.155.129.223/wh_trans/Printlabel_project_pallet_closetab_Webservices.aspx?print=" + print + "&pallet_no=" + pallet_no;
            // window.open(url_print, '_blank');
            // setTimeout(function () {
            //     swal.fire("Done!", "Success Create Pallet : " + pallet_no, "success").then(function () {
            //         window.location = "@Url.Action("Consolidation")";
            //     })
            // }, 2000)
            $.ajax({
                type: "GET",
                url: "https://warehouse.semb.se.com/wh_trans/Printlabel_project_pallet_Webservices.aspx",
                data: {
                    print: print,
                    pallet_no: pallet_no,
                }
            }).done(function (res) {
                swal.fire("Done!", "Success Create Pallet : "+pallet_no, "success").then(function () {
                    window.location = "@Url.Action("Consolidation")";
                })
            }).fail(function (err) {
                swal.fire("Done!", "Success Create Pallet : " + pallet_no, "success").then(function () {
                    window.location = "@Url.Action("Consolidation")";
                })
                // swal.fire("Page Error!", err, "error");
            })
        }

    </script>
}