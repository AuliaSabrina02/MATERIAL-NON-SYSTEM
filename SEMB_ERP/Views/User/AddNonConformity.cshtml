@using SEMB_ERP.Models
@*@model ViewModel*@
@using System.Globalization;
@using Microsoft.AspNetCore.Http;
@using SEMB_ERP.Controllers;
@inject IHttpContextAccessor Accessor

@{
    string sesa_id = ViewBag.sesa_id;
    string name = ViewBag.name;
    string plant = ViewBag.plant;
    string todayDate = DateTime.Today.ToString("yyyy-MM-dd");
    List<string> catList = ViewBag.catList;

}

<style>

    .table-row {
        cursor: pointer;
    }

    .modal {
        overflow-y: auto;
    }

    .box_form_input {
        background-color: #fcfcfc;
        border-radius: 5px;
        box-shadow: 1px 2px 8px 2px rgba(152,152,152,0.7);
    }

    /* .content {
        font-family: Verdana
    } */

</style>
<section id="hero1" class="hero bg-dark position-relative">
    <div class="inner d-flex justify-content-between align-items-center px-3 py-2 w-100">

        <!-- Kiri (kosong / placeholder) -->
        <div class="extract-info">
        </div>

        <!-- Tengah: Judul (absolutely centered) -->
        <div class="position-absolute top-50 start-50 translate-middle text-center">
            <h3 class="text-white mb-0">
                <i class="fas fa-exclamation text-success"></i>
                <b>Non Conformity</b>
            </h3>
        </div>

        <!-- Kanan: Breadcrumb -->
        <nav aria-label="breadcrumb" class="text-end ms-auto breadcrumb-sm">
            <ol class="breadcrumb mb-0 d-inline-flex flex-nowrap align-items-center bg-transparent">
                <ul class="navbar-nav ml-auto">
                    <div class="dropdown" style="flex-shrink: 0;">
                        <button class="btn btn-sm btn-danger dropdown-toggle" type="button" id="wiDropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-file-pdf"></i> Work Instructions
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="wiDropdownMenuButton">
                            <li><a class="dropdown-item" target="_blank" href="../WI/JBS Non System Apps - Section Requestor.pdf">JBS Non System Apps - Section Requestor</a></li>
                            <li><a class="dropdown-item" target="_blank" href="../WI/JBS Non System Apps - Section Warehouse Plant (English).pdf">JBS Non System Apps - Section Warehouse Plant (English)</a></li>
                            <li><a class="dropdown-item" target="_blank" href="../WI/JBS Non System Apps - Section Warehouse Plant (Bahasa).pdf">JBS Non System Apps - Section Warehouse Plant (Bahasa)</a></li>
                        </ul>
                    </div>
                </ul>
        </nav>
    </div>
</section>
<div class="content">
    <div class="container-fluid">
        <div class="row pt-3">
            <div class="col-md-12">
                <div class="offset-1 col-10 py-4 px-5 mb-4" style="background: #f8f9fa; border-radius: 15px; box-shadow: 0 8px 20px rgba(0,0,0,0.1);">
                    <!-- HEADER -->
                    <div class="text-center mb-4">
                        <label class="badge bg-warning text-dark shadow-sm" style="font-size:18pt; border-radius:50px; padding:12px 30px; cursor: default;">
                            <i class="fas fa-plus me-2"></i> Add Non Conformity
                        </label>
                    </div>

                    <form id="form_add_non_conf">
                        <div class="row g-4">

                            <!-- LEFT COLUMN -->
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="material_type" class="form-label fw-semibold">Material Type <span class="text-danger">*</span></label>
                                    <select class="form-select shadow-sm" name="material_type" id="material_type" required>
                                        <option value="">-- SELECT TYPE --</option>
                                        <option value="RW">Raw Material (RW)</option>
                                        <option value="FG">Finish Goods (FG)</option>
                                        <option value="WIP">Work In Progress (WIP)</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label for="partno" class="form-label fw-semibold">Part No <span class="text-danger">*</span></label>
                                    <input class="form-control shadow-sm" type="text" name="partno" placeholder="Part Number" autocomplete="off" required />
                                </div>

                                <div class="mb-3">
                                    <label for="po_no" class="form-label fw-semibold">PO No <span class="text-danger">*</span></label>
                                    <input class="form-control shadow-sm" type="text" name="po_no" placeholder="PO Number" autocomplete="off" required />
                                </div>

                                <div class="mb-3">
                                    <label for="qty" class="form-label fw-semibold">Qty <span class="text-danger">*</span></label>
                                    <input class="form-control shadow-sm" type="number" name="qty" placeholder="Qty" autocomplete="off" required />
                                </div>

                                <div class="mb-3">
                                    <label for="uom" class="form-label fw-semibold">UOM <span class="text-danger">*</span></label>
                                    <input class="form-control shadow-sm" type="text" name="uom" placeholder="PC, PALLET, ..." autocomplete="off" required />
                                </div>
                            </div>

                            <!-- RIGHT COLUMN -->
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="supplier_name" class="form-label fw-semibold">Supplier Name <span class="text-danger">*</span></label>
                                    <input class="form-control shadow-sm" type="text" name="supplier_name" placeholder="Supplier" autocomplete="off" required />
                                </div>

                                <div class="mb-3">
                                    <label for="pic" class="form-label fw-semibold">PIC <span class="text-danger">*</span></label>
                                    <select class="form-select shadow-sm" name="pic"></select>
                                </div>

                                <div class="mb-3">
                                    <label for="category_issue" class="form-label fw-semibold">Category Issue <span class="text-danger">*</span></label>
                                    <select class="form-select shadow-sm" name="category_issue" id="category_issue" required>
                                        <option value="">-- SELECT CATEGORY ISSUE --</option>
                                        @foreach (var cat in catList)
                                        {
                                            <option value="@cat">@cat</option>
                                        }
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label for="detail_issue" class="form-label fw-semibold">Detail Issue</label>
                                    <textarea class="form-control shadow-sm" name="detail_issue" rows="3" placeholder="Describe the issue..."></textarea>
                                </div>

                                <div class="mb-3">
                                    <label for="file_support" class="form-label fw-semibold">Supporting Documents (Optional)</label>
                                    <input type="file" class="form-control shadow-sm" name="file_support">
                                </div>
                            </div>

                            <!-- SUBMIT BUTTON -->
                            <div class="col-12 text-end mt-4">
                                <button type="submit" class="btn btn-success btn-lg shadow-sm" name="btn_submit" style="border-radius:10px;">
                                    Submit <i class="fa fa-arrow-right ms-2"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="modal_temp_order" class="modal fade">
    <div class="modal-dialog" role="document" style="min-width:80%">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-file-import"></i> Review Order</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row" id="body_temp_order"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times"></i> Cancel</button>
                <button class="btn btn-success" name="btn_confirm_order"><i class="fas fa-save"></i> Submit</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        var Table;
        var loading = "<i class='fa fa-4x fa-spinner fa-spin'></i>";

        $(document).ready(function () {
            $('select[name=pic]').select2({
                // dropdownParent: $("#modal_gate_pass > .modal-dialog > .modal-content"),
                placeholder: '-- SELECT PIC --',
                width: '100%',
                ajax: {
                    url: "@Url.Action("GetPIC")",
                    data: function (params) {
                        return {
                            search_value: params.term
                        };
                    },
                    processResults: function (data) {
                        //console.log(data);
                        return {
                            results: data.items
                        }
                    },
                }
            })

            $('#category_issue').select2({
                placeholder: "-- SELECT CATEGORY ISSUE --"
            });

            $('#material_type').select2({
                placeholder: "-- SELECT TYPE --"

            });

            $("form#form_add_non_conf").submit(function (e) {
                e.preventDefault();
                let formData = new FormData(this);
                // console.log(formData);
                Swal.fire({
                    title: 'Confirmation!!',
                    text: "Are you sure ?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#dc3545',
                    confirmButtonText: 'Yes!',
                    cancelButtonText: 'No!',
                    showLoaderOnConfirm: true,
                    preConfirm: function () {
                        return new Promise(function (resolve, reject) {
                            $.ajax({
                                url: "@Url.Action("SUBMIT_NON_CONF")",
                                type: 'POST',
                                data: formData,
                                cache: false,
                                contentType: false,
                                processData: false
                            }).done(function (msg) {
                                let arr = msg.split(";");
                                if (arr[0] == "success") {
                                    swal.fire("Success!", arr[1], "success").then(function () {
                                        location.reload();
                                    })
                                }
                                else {
                                    swal.fire("Failed!", msg, "error");
                                }
                            })
                        })
                    },
                    allowOutsideClick: () => !Swal.isLoading()
                })
            })
        })

    </script>
}