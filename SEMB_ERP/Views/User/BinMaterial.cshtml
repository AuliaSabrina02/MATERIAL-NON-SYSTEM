@section Scripts
{
    <script>
        $(document).ready(function () {
            var table = $('#list_part').DataTable({
                "ajax": {
                    "url": '@Url.Action("GetBinItem")', // URL to your ASP.NET Web API endpoint
                    "dataSrc": function (json) {
                        console.log("AJAX response:", json);
                        return json.map(function (item) {
                            return {
                                PartNo: item.partNo,
                                PartName: item.partName,
                                Quantity: item.quantity,
                                Action: "<button type='button' class='btn btn-danger delete-part' data-partname='" + item.partName + "'><i class='fas fa-trash'></i></button>"
                            };
                        });
                    }
                },
                "columns": [
                    { data: "PartNo", title: "Part No" },
                    { data: "PartName", title: "Part Name" },
                    { data: "Quantity", title: "Quantity" },
                    { data: "Action", title: "Action" }
                ],
                "searching": true,
                "paging": true,
                "info": true,
                "order": [[0, "asc"]]
            });

            $('#list_part tbody').on('click', '.delete-part', function () {
                var partName = $(this).data('partname'); // Get the PartName from the button's data attribute

                // SweetAlert2 confirmation dialog
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You are about to delete " + partName + ".",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!',
                    cancelButtonText: 'No, cancel!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("DeleteBinItem")', // URL to your ASP.NET Web API endpoint for deletion
                            type: 'POST',
                            data: { partName: partName }, // Send the PartName to the server
                            success: function (response) {
                                // Handle success response
                                if (response.trim() === "OK") {
                                    Swal.fire(
                                        'Deleted!',
                                        'The part has been deleted.',
                                        'success'
                                    );
                                } else if (response.trim() === "NOK") {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error!',
                                        text: 'Error Deleting. Please try again.',
                                        confirmButtonText: 'OK'
                                    });
                                } else {
                                    // Handle unexpected responses
                                    Swal.fire({
                                        icon: 'warning',
                                        title: 'Warning!',
                                        text: 'Unexpected response received.',
                                        confirmButtonText: 'OK'
                                    });
                                }
                                table.ajax.reload(); // Reload the table data
                                
                            },
                            error: function (xhr, status, error) {
                                // Handle error response
                                Swal.fire(
                                    'Error!',
                                    'There was an error deleting the part: ' + error,
                                    'error'
                                );
                            }
                        });
                    }
                });
            });

            $('#box_id_input').on('keypress', function (e) {
                if (e.which === 13) { // 13 is the Enter key
                    e.preventDefault(); // Prevent the default form submission
                    var inputValue = $(this).val();
                    if (inputValue) {
                        var exists = false;
                        table.rows().every(function () {
                            var data = this.data();
                            console.log('Row data:', data);
                            console.log('Checking:', data['PartName'], 'against:', inputValue);
                            if (String(data['PartName']).trim() === String(inputValue).trim()) { // Assuming Part No is in the first column
                                exists = true;
                                return false; // Break the loop
                            }
                        });
                        console.log(exists)

                        if (exists) {
                            // Show alert if the value already exists
                            Swal.fire({
                                icon: 'warning',
                                title: 'Warning!',
                                text: 'Data is already in the table.',
                                confirmButtonText: 'OK'
                            });
                        } else {
                            var sesa_id = '@ViewBag.sesa_id'
                            console.log(sesa_id)
                            // Call your API to insert the new part
                            $.ajax({
                                url: '@Url.Action("InsertBinItem")', // URL to your API endpoint for inserting the part
                                type: 'POST',
                                data: { 
                                    box_id: inputValue,
                                    sesa_id: sesa_id
                                },
                                success: function (response) {
                                    // Optionally handle the response
                                    console.log(response);
                                    if (response.trim() === "OK") {
                                        Swal.fire({
                                            icon: 'success',
                                            title: 'Success!',
                                            text: 'Data has been added successfully.',
                                            confirmButtonText: 'OK'
                                        });
                                    } else if (response.trim() === "NOK") {
                                        Swal.fire({
                                            icon: 'error',
                                            title: 'Error!',
                                            text: 'No data found. Please try again.',
                                            confirmButtonText: 'OK'
                                        });
                                    } else {
                                        // Handle unexpected responses
                                        Swal.fire({
                                            icon: 'warning',
                                            title: 'Warning!',
                                            text: 'Unexpected response received.',
                                            confirmButtonText: 'OK'
                                        });
                                    }
                                    // Refresh the DataTable
                                    table.ajax.reload();
                                },
                                error: function (xhr, status, error) {
                                    console.error('Error inserting part:', error);
                                }
                            });
                        }
                    }
                }
            });

            $('#cancel_bin').on('click', function () {
                var sesa_id = "@ViewBag.sesa_id"
                $.ajax({
                    url: '@Url.Action("ClearBin")', // URL to your API endpoint for inserting the part
                    type: 'POST',
                    data: {                        
                        sesa_id: sesa_id
                    },
                    success: function (response) {
                        // Optionally handle the response
                        console.log(response);
                        if (response.trim() === "OK") {
                            window.location.href = '@Url.Action("Putaway")'; // Redirect to Putaway page
                        } else if (response.trim() === "NOK") {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: 'Please try again.',
                                confirmButtonText: 'OK'
                            });
                        } else {
                            // Handle unexpected responses
                            Swal.fire({
                                icon: 'warning',
                                title: 'Warning!',
                                text: 'Unexpected response received.',
                                confirmButtonText: 'OK'
                            });
                        }
                        // Refresh the DataTable
                        table.ajax.reload();
                    },
                    error: function (xhr, status, error) {
                        console.error('Error inserting part:', error);
                    }
                });                
            });

            // Confirm button functionality
            $('#confirm_bin').on('click', function () {
                // Add your AJAX request here for confirmation
                var binId = '@ViewBag.binId';
                var sesa_id = '@ViewBag.sesa_id';
                showLoadingSpinner("Checking Box...");
                $.ajax({
                    url: '@Url.Action("ConfirmBinItem")', // URL to your confirmation endpoint
                    type: 'POST',
                    data: { 
                        binId: binId,
                        sesa_id: sesa_id
                    }, //use viewbag binId if temp table wanna be seperated by BIN 
                    success: function (response) {
                        // Handle success response
                        if (response.trim() === "OK") {
                            Swal.fire({
                                icon: 'success',
                                title: 'Confirmed!',
                                text: 'Your action has been confirmed.',
                                confirmButtonText: 'OK'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    // Redirect to PutAWAY page
                                    window.location.href = '@Url.Action("Putaway")'; // Update with the correct action if needed
                                }
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: 'There was an error confirming your action.',
                                confirmButtonText: 'OK'
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        Swal.fire(
                            'Error!',
                            'There was an error processing your request: ' + error,
                            'error'
                        );
                    }
                });
            });
        });
    </script>

    <script>        
        function showLoadingSpinner(msg = 'Please wait...') {
            Swal.fire({
                title: 'Processing',
                html: '<i class="fa fa-spinner fa-spin" style="font-size: 50px"></i>',
                allowOutsideClick: false,
                showConfirmButton: false, // Hide the initial OK button
                onBeforeOpen: () => {
                    Swal.showLoading();
                }
            });
        }


        // new script for input to cross validate di DBBLP.dbo.packagedetail Part number sama atau tidak kalau sama masuk tempory table kalu tidak keluarin modal Wrong Part
        // script Buttton confim untukUpdate status di tbl order dan cancel untuk balik ke PutAway
    </script>

