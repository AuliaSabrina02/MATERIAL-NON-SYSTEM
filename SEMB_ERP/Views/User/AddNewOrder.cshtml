@using SEMB_ERP.Models
@*@model ViewModel*@
@using System.Globalization;
@using Microsoft.AspNetCore.Http;
@using SEMB_ERP.Controllers;
@inject IHttpContextAccessor Accessor

@{
    string sesa_id = ViewBag.sesa_id;
    string name = ViewBag.name;
    string plant = ViewBag.plant;
    string todayDate = DateTime.Today.ToString("yyyy-MM-dd");

    List<string> supplierList = ViewBag.supplierList;
}

<style>

    .table-row {
        cursor: pointer;
    }

    .modal {
        overflow-y: auto;
    }

    .box_form_input {
        background-color: #fcfcfc;
        border-radius: 5px;
        box-shadow: 1px 2px 8px 2px rgba(152,152,152,0.7);
    }

    /* .content {
            font-family: Verdana
        } */

</style>

<div class="content">
    <div class="container-fluid">
        <div class="row pt-3">
            <div class="col-md-12">
                <div class="card card-success card-outline">
                    <div class="card-header bg-success">
                        <h5 class="text-center"><i class="fa fa-plus"></i> Add New Request</h5>
                        @*<div class="card-tools">
                        <a href="~/Template/TemplateUploadPallet.xlsx" class="btn btn-danger mr-1">
                        <i class="fa fa-download"></i> Template
                        </a>
                        <button class="btn btn-success mr-1" name="btn_filter" data-bs-toggle="modal" data-bs-target="#ImportDataModel"><i class="fas fa-file-import"></i> Upload Pallet List</button>
                        </div>*@
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="offset-1 col-10 pt-2 pb-2 pl-4 pr-4 box_form_input">
                                <div class="text-center"><label class="badge bg-warning" style="font-size:16pt;border-radius:30px;padding:10px 20px"><i class="fas fa-upload"></i> Upload Request</label></div>
                                <form id="form_upload_order">
                                    <div class="row">
                                        <div class="offset-3 col-6 mb-4" style="border-top: 2px #e3e3e3 solid"></div>
                                        <div class="col-6 pl-4 pr-4">
                                            <div class="form-group">
                                                <label>Upload File Request (Excel File)<span class="text-danger">*</span></label>
                                                @* <input class="form-control" type="file" name="file_upload" required /> *@
                                                <div class="input-group">
                                                    <input type="file" class="form-control" id="file_upload" name="file_upload" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" aria-label="Upload" required>
                                                    <a href="~/Template/Template_Upload_Material.xlsx" class="btn btn-primary">
                                                        <i class="fas fa-file-download"></i> Download Template
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-6 pl-4 pr-4">

                                            <div class="form-group">
                                                <label>Supporting Documents (Excel or PDF)</label>
                                                <input type="file" class="form-control" name="file_support">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group text-center">
                                        <button type="submit" class="btn btn-success mt-2" name="btn_confirm_upload">Submit Order <i class="fa fa-arrow-right"></i></button>
                                    </div>
                                </form>
                            </div>

                            <div class="offset-1 col-10 text-center p-2">
                                <h4 style="color:grey">------------- OR -------------</h4>
                            </div>

                            <div class="offset-1 col-10 pt-2 pb-2 pl-4 pr-4 box_form_input">
                                <div class="text-center"><label class="badge bg-warning" style="font-size:16pt;border-radius:30px;padding:10px 20px"><i class="fas fa-file-alt"></i> Input Request</label></div>
                                <form id="form_add_order">
                                    <div class="row">
                                        <div class="offset-3 col-6 mb-4" style="border-top: 2px #e3e3e3 solid"></div>
                                        <div class="col-6 pl-4 pr-4">
                                            <div class="form-group">
                                                <label>Material Type<span class="text-danger">*</span></label>
                                                <select class="form-select" name="material_type" required>
                                                    <option value="">--SELECT--</option>
                                                    <option value="RM">Raw Material (RM)</option>
                                                    <option value="FG">Finish Goods (FG)</option>
                                                    <option value="WIP">Work In Progress (WIP)</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label>Part No<span class="text-danger">*</span></label>
                                                <input class="form-control" type="text" name="partno" placeholder="Part Number" autocomplete="off" required />
                                            </div>
                                            <div class="form-group">
                                                <label>PO No<span class="text-danger">*</span></label>
                                                <input class="form-control" type="text" name="po_no" placeholder="PO Number" autocomplete="off" required />
                                            </div>
                                            <div class="form-group">
                                                <label>Qty<span class="text-danger">*</span></label>
                                                <input class="form-control" type="number" name="qty" placeholder="Qty" step="any" autocomplete="off" required />
                                            </div>
                                            <div class="form-group">
                                                <label>UOM<span class="text-danger">*</span></label>
                                                <input class="form-control" type="text" name="uom" placeholder="PC, PALLET, ..." autocomplete="off" required />
                                            </div>
                                            <div class="form-group">
                                                <label>Revision<span class="text-danger">*</span></label>
                                                <input class="form-control" type="text" name="revision" placeholder="Revision" autocomplete="off" required />
                                            </div>
                                            <div class="form-group">
                                                <label>Project Name<span class="text-danger">*</span></label>
                                                <input class="form-control" type="text" name="project_name" placeholder="Project Name" autocomplete="off" required />
                                            </div>
                                            <div class="form-group">
                                                <label>Storage Requirement<span class="text-danger">*</span></label>
                                                <select class="form-select" name="storage_requirement" required>
                                                    <option value="">--SELECT--</option>
                                                    <option value="AC">AC</option>
                                                    <option value="Non AC">Non AC</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-6 pl-4 pr-4">
                                            <div class="form-group">
                                                <label>Supplier Name<span class="text-danger">*</span></label>
                                                <input class="form-control" type="text" name="supplier_name" placeholder="Supplier" autocomplete="off" required />
                                            </div>
                                            <div class="form-group">
                                                <label>PIC<span class="text-danger">*</span></label>
                                                <input class="form-control" type="hidden" name="pic" value="@sesa_id" />
                                                <input class="form-control" type="text" name="pic_display" value="@sesa_id - @name" autocomplete="off" required readonly />
                                            </div>
                                            <div class="form-group">
                                                <label>Order Type<span class="text-danger">*</span></label>
                                                <select class="form-select" name="order_type" required>
                                                    <option value="">--SELECT--</option>
                                                    <option value="Apollo">Apollo</option>
                                                    <option value="Coupa">Coupa</option>
                                                    <option value="FOC">FOC</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label>Price<span class="text-danger">*</span></label>
                                                <input class="form-control" type="number" name="unit_price" placeholder="Price" autocomplete="off" step="any" required />
                                            </div>
                                            <div class="form-group">
                                                <label>Priority Request<span class="text-danger">*</span></label>
                                                <select class="form-select" name="priority_request" required>
                                                    <option value="">--SELECT--</option>
                                                    <option value="High">High</option>
                                                    <option value="Medium">Medium</option>
                                                    <option value="Low">Low</option>
                                                </select>
                                            </div>
                                            <div class="row">
                                                <div class="col-4">
                                                    <div class="form-group">
                                                        <label>Length (mm)</label>
                                                        <input class="form-control" type="number" name="length_mm" placeholder="Length (mm)" step="any" autocomplete="off" />
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="form-group">
                                                        <label>Width (mm)</label>
                                                        <input class="form-control" type="number" name="width_mm" placeholder="Width (mm)" step="any" autocomplete="off" />
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="form-group">
                                                        <label>Height (mm)</label>
                                                        <input class="form-control" type="number" name="height_mm" placeholder="Height (mm)" step="any" autocomplete="off" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label>Remark</label>
                                                <textarea class="form-control" name="remark" rows="3"></textarea>
                                            </div>
                                            <div class="form-group">
                                                <label>Gatepass</label>
                                                <input class="form-control" type="text" name="gatepass" placeholder="Gatepass" autocomplete="off" />
                                            </div>
                                            <div class="form-group">
                                                <label>Supporting Documents (Excel or PDF)</label>
                                                <input type="file" class="form-control" name="file_support">
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-group text-center">
                                                <button type="button" class="btn btn-info mt-2" id="btn_save_template">
                                                <i class="fas fa-file-excel"></i> Save as Template
                                                </button>
                                                <button type="submit" class="btn btn-success mt-2" name="btn_confirm">Submit Order <i class="fa fa-arrow-right"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL REVIEW ORDER -->
<div id="modal_temp_order" class="modal fade">
    <div class="modal-dialog" role="document" style="min-width:80%">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-file-import"></i> Review Order</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row" id="body_temp_order"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times"></i> Cancel</button>
                <button class="btn btn-success" name="btn_confirm_order"><i class="fas fa-save"></i> Submit</button>
            </div>
        </div>
    </div>
</div>


@section Scripts
{
    <script>
        var Table;
        var loading = "<i class='fa fa-4x fa-spinner fa-spin'></i>";

        $(document).ready(function () {


              $("#btn_save_template").click(function(e) {
            e.preventDefault();

            // 1. Ambil data dari form input
            let materialType = $("select[name='material_type']").val();
            let partNo = $("input[name='partno']").val();
            let poNo = $("input[name='po_no']").val();
            let qty = $("input[name='qty']").val();
            let uom = $("input[name='uom']").val();
            let revision = $("input[name='revision']").val();
            let projectName = $("input[name='project_name']").val();
            let storageReq = $("select[name='storage_requirement']").val();
            let supplierName = $("input[name='supplier_name']").val();
            let orderType = $("select[name='order_type']").val();
            let price = $("input[name='unit_price']").val();

            // Pastikan select name='priority_request' ada di HTML Anda
            let priority = $("select[name='priority_request']").val();

            let lengthMm = $("input[name='length_mm']").val() || '0';
            let widthMm = $("input[name='width_mm']").val() || '0';
            let heightMm = $("input[name='height_mm']").val() || '0';
            let remark = $("textarea[name='remark']").val();
            let gatepass = $("input[name='gatepass']").val();
            let pic = $("input[name='pic']").val();

            // 2. Validasi minimal ada satu data terisi
            let hasData = materialType || partNo || poNo || qty || uom || revision ||
                          projectName || storageReq || supplierName || orderType || price || priority;

            if (!hasData) {
                Swal.fire({
                    icon: 'warning',
                    title: 'No Data',
                    text: 'Please fill at least one field before saving as template!'
                });
                return;
            }

            Swal.fire({
                title: 'Save as Template?',
                text: "Current form data will be saved to database and downloaded as Excel",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#17a2b8',
                confirmButtonText: 'Yes, Save & Download!',
            }).then((result) => {
                if (result.isConfirmed) {

                    // 3. Siapkan data untuk dikirim ke C# Controller
                    let formData = {
                        material_type: materialType,
                        partno: partNo,
                        po_no: poNo,
                        qty: qty,
                        uom: uom,
                        revision: revision,
                        project_name: projectName,
                        storage_requirement: storageReq,
                        supplier_name: supplierName,
                        order_type: orderType,
                        unit_price: price,
                        priority_request: priority, // Dikirim ke model.priority_request
                        length_mm: lengthMm,
                        width_mm: widthMm,
                        height_mm: heightMm,
                        remark: remark,
                        gatepass: gatepass,
                        pic: pic,
                        status_code: "TEMPLATE"
                    };

                    $.ajax({
                        url: "@Url.Action("SaveAsTemplate", "User")",
                        type: "POST",
                        data: formData,
                        success: function (res) {
                            // 4. Generate Excel dengan struktur kolom yang SINKRON (Priority di Kolom 12)
                            let wsData = [
                                [
                                    'Material Type*', 'Part No*', 'PO No*', 'Qty*', 'UOM*',
                                    'Revision*', 'Project Name*', 'Storage Requirement*', 'Supplier Name*',
                                    'Order Type*', 'Price ($)*', 'Priority Request*', 'Length (mm)',
                                    'Width (mm)', 'Height (mm)', 'Remark', 'Gatepass'
                                ],
                                [
                                    materialType || '', partNo || '', poNo || '', qty || '', uom || '',
                                    revision || '', projectName || '', storageReq || '', supplierName || '',
                                    orderType || '', price || '', priority || 'Low', lengthMm || '0',
                                    widthMm || '0', heightMm || '0', remark || '', gatepass || ''
                                ]
                            ];

                            let wb = XLSX.utils.book_new();
                            let ws = XLSX.utils.aoa_to_sheet(wsData);

                            // Setup lebar kolom (Total 17 Kolom)
                            ws['!cols'] = [
                                { wch: 15 }, { wch: 15 }, { wch: 15 }, { wch: 8 }, { wch: 8 },
                                { wch: 10 }, { wch: 15 }, { wch: 20 }, { wch: 15 }, { wch: 12 },
                                { wch: 12 }, { wch: 15 }, { wch: 12 }, { wch: 12 }, { wch: 12 },
                                { wch: 20 }, { wch: 15 }
                            ];

                            XLSX.utils.book_append_sheet(wb, ws, "Order Template");
                            let timestamp = new Date().toISOString().slice(0,19).replace(/:/g,'-');
                            XLSX.writeFile(wb, `Order_Template_${timestamp}.xlsx`);

                            Swal.fire("Success!", "Template saved and downloaded", "success");
                        },
                        error: function (xhr) {
                            Swal.fire("Error!", "Failed to save template: " + xhr.responseText, "error");
                        }
                    });
                }
            });
        });


          $("form#form_upload_order").submit(function (e) {
                e.preventDefault();
                $("div#body_temp_order").html("<div class='text-center'>" + loading + "</div>");
                $("div#modal_temp_order").modal("show");
                let formData = new FormData(this);
                $.ajax({
                    url: "@Url.Action("UploadOrder")",
                    type: 'POST',
                    data: formData,
                    cache: false,
                    contentType: false,
                    processData: false,
                    success: function(res) {
                        $("div#body_temp_order").html(res);
                    },
                    error: function(xhr, status, error) {
                        Swal.fire("Error", "Upload Failed", "error");
                        $("div#modal_temp_order").modal("hide");
                    }
                });
            });


            $("button[name=btn_confirm_order]").click(function(){
                let total_error = $("input[name=total_error]").val();
                let total_upload = $("input[name=total_upload]").val();
                if (total_error > 0) {
                    swal.fire("Error!", "Cannot submit with error data!!", "error");
                }
                else if (total_upload == 0) {
                    swal.fire("Error!", "No data!!", "error");
                }
                else {
                    let id_upload = $("input[name=id_upload]").val();
                    let file_support = $("form#form_upload_order").find("input[name=file_support]")[0].files[0];

                    // var fileInput = $('#fileInput')[0];
                    // var file = fileInput.files[0];
                    let formData = new FormData();
                    formData.append('id_upload', id_upload);
                    formData.append('file_support', file_support);

                    Swal.fire({
                        title: 'Confirmation!!',
                        text: "Are you sure ?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#28a745',
                        cancelButtonColor: '#dc3545',
                        confirmButtonText: 'Yes!',
                        cancelButtonText: 'No!',
                        showLoaderOnConfirm: true,
                        preConfirm: function () {
                            return new Promise(function (resolve, reject) {
                                $.ajax({
                                    url: "@Url.Action("SubmitUploadOrder")",
                                    type: 'POST',
                                    data: formData,
                                    processData: false, // Important: prevent jQuery from processing the data
                                    contentType: false// Important: prevent jQuery from setting contentType
                                }).done(function (msg) {
                                    let arr = msg.split(";");
                                    if (arr[0] == "success") {
                                        swal.fire("Success!", arr[1], "success").then(function () {
                                            location.reload();
                                        })
                                    }
                                    else {
                                        swal.fire("Failed!", msg, "error");
                                    }
                                })
                            })
                        },
                        allowOutsideClick: () => !Swal.isLoading()
                    })
                }
            })

            $("form#form_add_order").submit(function (e) {
                e.preventDefault();
                let formData = new FormData(this);
                // console.log(formData);
                Swal.fire({
                    title: 'Confirmation!!',
                    text: "Are you sure ?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#dc3545',
                    confirmButtonText: 'Yes!',
                    cancelButtonText: 'No!',
                    showLoaderOnConfirm: true,
                    preConfirm: function () {
                        return new Promise(function (resolve, reject) {
                            $.ajax({
                                url: "@Url.Action("SubmitOrder")",
                                type: 'POST',
                                data: formData,
                                cache: false,
                                contentType: false,
                                processData: false
                            }).done(function (msg) {
                                let arr = msg.split(";");   
                                if (arr[0] == "success") {
                                    swal.fire("Success!", arr[1], "success").then(function () {
                                        location.reload();
                                    })
                                }
                                else {
                                    swal.fire("Failed!", msg, "error");
                                }
                            })
                        })
                    },
                    allowOutsideClick: () => !Swal.isLoading()
                })
            })
        })

    </script>
}