@using System.Data;
@model List<SEMB_ERP.Models.MaterialReturnModel>
@using Microsoft.AspNetCore.Mvc.Rendering;
@{
    string sesa_id = ViewBag.sesa_id ?? "";
    List<string> listStatus = (ViewBag.listStatus as List<string>) ?? new List<string> { "Sent", "Approved", "In Transit", "Returned" };
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    .smaller-input {
        height: 25px;
        padding: 5px;
        font-size: 10px;
        line-height: 1;
    }

    .dataTables_info, .dataTables_paginate, .dataTables_filter {
        font-size: 10pt;
    }

    #table_return_filter.dataTables_filter {
        display: none;
    }

    table#table_return tr > th {
        padding: 5px;
    }

    table#table_return tr > td {
        padding: 5px;
    }

    #table_return {
        border-radius: 0.35rem;
        overflow: hidden;
    }

        #table_return td {
            border-bottom: 0.5px solid #FBF8EF !important;
            border-left: none !important;
            border: none !important;
            font-size: 13px;
            font-weight: 500;
        }

        #table_return thead th {
            border: none !important;
            font-size: 14px;
            vertical-align: middle;
            text-align: center;
        }

    .action-gap {
        display: flex;
        gap: 5px;
        justify-content: center;
    }

    .select2-container .select2-selection--single {
        height: 38px !important;
        border: 1px solid #ced4da !important;
        border-radius: 4px !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 38px !important;
        padding-left: 10px !important;
        color: #495057 !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 38px !important;
    }

    .select2-dropdown {
        border: 1px solid #ced4da !important;
        border-radius: 4px !important;
        z-index: 9999 !important;
    }
</style>

<section id="hero1" class="hero bg-dark position-relative">
    <div class="inner d-flex justify-content-between align-items-center px-3 py-2 w-100">
        <div class="position-absolute top-50 start-50 translate-middle text-center">
            <h3 class="text-white mb-0"><i class="fas fa-exchange-alt text-success"></i> <b>Material Return List</b></h3>
        </div>
    </div>
</section>

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 mt-3">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col col-12 mb-2 d-flex justify-content-end">
                                <button class="btn btn-sm btn-primary" onclick="open_modal_add()">
                                    <i class="fas fa-plus-circle"></i> Create Return
                                </button>
                            </div>
                            <div class="col-12 table-responsive">
                                <table class="table table-bordered table-striped align-center nowrap" id="table_return" style="font-size:10pt;width:100%;">
                                    <thead class="bg-navy-custom align-middle text-center">
                                        <tr>
                                            <th>Status</th>
                                            <th>Part Number</th>
                                            <th>PO Number</th>
                                            <th>Qty</th>
                                            <th>UOM</th>
                                            <th>Condition</th>
                                            <th>Remark</th>
                                            <th>PIC</th>
                                            <th>Return Date</th>
                                            <th>Document</th>
                                            <th>Action</th>
                                        </tr>
                                        <tr style="background-color: #3b6b85;">
                                            <td>
                                                <select class="form-control smaller-input filter_table" target="0">
                                                    <option value="">#ALL</option>
                                                    @foreach (var s in listStatus)
                                                    {
                                                        <option value="@s">@s</option>
                                                    }
                                                </select>
                                            </td>
                                            <td><input type="text" class="form-control smaller-input filter_table" placeholder="Filter..." target="1" /></td>
                                            <td><input type="text" class="form-control smaller-input filter_table" placeholder="Filter..." target="2" /></td>
                                            <td><input type="text" class="form-control smaller-input filter_table" placeholder="Filter..." target="3" /></td>
                                            <td><input type="text" class="form-control smaller-input filter_table" placeholder="Filter..." target="4" /></td>
                                            <td><input type="text" class="form-control smaller-input filter_table" placeholder="Filter..." target="5" /></td>
                                            <td><input type="text" class="form-control smaller-input filter_table" placeholder="Filter..." target="6" /></td>
                                            <td><input type="text" class="form-control smaller-input filter_table" placeholder="Filter..." target="7" /></td>
                                            <td><input type="text" class="form-control smaller-input filter_table" placeholder="Filter..." target="8" /></td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_return" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success">
                <h6 class="modal-title text-white" id="modalLabel"><i class="fas fa-exchange-alt"></i> Form Material Return</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="form_return" enctype="multipart/form-data" method="post">
                <input type="hidden" name="id_return" id="id_return" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label>Part Number <span class="text-danger">*</span></label>
                                <select id="sel_partno" class="form-control" style="width:100%;" required>
                                    <option value="">-- Select Part Number --</option>
                                </select>
                                <input type="hidden" name="partno" id="hidden_partno" />
                            </div>
                            <div class="form-group mb-2">
                                <label>PO Number <span class="text-danger">*</span></label>
                                <input type="text" name="po_no" id="po_no" class="form-control" readonly
                                       style="background:#f8f9fa;" required />
                            </div>
                            <div class="form-group mb-2">
                                <label>UOM <span class="text-danger">*</span></label>
                                <input type="text" name="uom" id="uom" class="form-control" readonly
                                       style="background:#f8f9fa;" />
                            </div>
                            <div class="form-group mb-2">
                                <label>Request Qty</label>
                                <input type="text" id="request_qty" class="form-control" readonly
                                       style="background:#f8f9fa;" />
                            </div>
                            <div class="form-group mb-2">
                                <label>Already Returned</label>
                                <input type="text" id="already_returned" class="form-control" readonly
                                       style="background:#f8f9fa;" />
                            </div>
                            <div class="form-group mb-2">
                                <label>Return Quantity <span class="text-danger">*</span></label>
                                <input type="number" name="qty_return" id="qty_return" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-2">
                                <label>Condition <span class="text-danger">*</span></label>
                                <select name="condition" id="condition" class="form-control" required>
                                    <option value="Good">Good</option>
                                    <option value="Damaged">Damaged</option>
                                    <option value="Incomplete">Incomplete</option>
                                </select>
                            </div>
                            <div class="form-group mb-2">
                                <label>Remark</label>
                                <textarea name="reason_return" id="remark" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="form-group mb-2">
                                <label>Document Support <small class="text-muted">(PDF)</small></label>
                                <input type="file" name="image_support_file" id="file_pdf"
                                       class="form-control" accept="application/pdf" />
                                <div id="current_file_info" class="mt-1" style="display:none;">
                                    <small class="text-muted">Current file: </small>
                                    <a id="current_file_link" href="#" target="_blank" class="text-primary">
                                        <i class="fas fa-file-pdf text-danger"></i>
                                        <span id="current_file_name"></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-sm btn-success">Save Data</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_view_image" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header bg-navy-custom text-white py-2">
                <h6 class="modal-title">Image Preview</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-1">
                <img id="img_zoom" src="" style="width: 100%; height: auto; border-radius: 4px;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        var table;

        $(document).ready(function () {

            table = $("#table_return").DataTable({
                "orderCellsTop": true,
                "processing": true,
                "serverSide": true,
                "ajax": { "url": "@Url.Action("GetReturnList", "User")", "type": "POST" },
                "columns": [
                    { "data": "status_desc", "className": "align-middle" },
                    { "data": "partno", "className": "align-middle" },
                    { "data": "po_no", "className": "align-middle" },
                    { "data": "qty_return", "className": "text-center align-middle" },
                    { "data": "uom", "className": "text-center align-middle" },
                    { "data": "condition", "className": "text-center align-middle" },
                    { "data": "reason_return", "className": "align-middle", "defaultContent": "" },
                    { "data": "name", "className": "align-middle" },
                    {
                        "data": "return_date",
                        "className": "text-center align-middle",
                        "render": function (data) {
                            if (!data) return "-";
                            return data.substring(0, 10);
                        }
                    },
                    {
                        "data": "image_support",
                        "className": "text-center align-middle",
                        "render": function (data) {
                            if (!data) return "-";
                            var pathNew = "/Uploads/returns/" + data;
                            return `<a href="${pathNew}" target="_blank" class="text-danger fw-bold" title="Open PDF">
                                        <i class="fas fa-file-pdf"></i> View
                                    </a>`;
                        }
                    },
                    {
                        "data": null,
                        "className": "text-center align-middle",
                        "render": function (data, type, row) {
                            if (row.status_desc === "Sent") {
                                return `
                                    <div class="action-gap">
                                        <button class="btn btn-xs btn-warning" onclick='open_modal_edit(${JSON.stringify(row)})' title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-xs btn-danger" onclick="delete_data('${row.id_return}')" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>`;
                            } else {
                                return `<i class="fas fa-lock text-muted" title="Locked"></i>`;
                            }
                        }
                    }
                ],
                "drawCallback": function () {
                    this.api().rows().every(function () {
                        var status = (this.data().status_desc || "").toLowerCase().trim();
                        var bg = status === "sent" ? "bg-warning"
                               : status === "approved" ? "bg-success"
                               : status === "in transit" ? "bg-info"
                               : "bg-secondary";
                        $(this.node()).find('td:eq(0)').addClass(bg);
                    });
                }
            });

            $('.filter_table').on('keyup change', function () {
                table.column($(this).attr('target')).search(this.value).draw();
            });

            var selectedOrderData = {};

            $('#sel_partno').select2({
                dropdownParent: $('#modal_return'),
                placeholder: '-- Select or Search Part Number --',
                allowClear: true,
                minimumInputLength: 0,
                ajax: {
                    url: '@Url.Action("GetOrderListByStatusJson", "User")',
                    type: 'GET',
                    delay: 300,
                    data: function (params) {
                        return {
                            status: 'Closed',
                            search: params.term || ''
                        };
                    },
                    processResults: function (res) {
                        if (!res || res.length === 0) return { results: [] };
                        var results = [];
                        res.forEach(function (item) {
                            results.push({
                                id: item.id_order,
                                text: item.partno + ' — ' + item.record_date.substring(0, 10) + ' (qty: ' + item.qty + ')',
                                orderData: item
                            });
                        });
                        return { results: results };
                    },
                    cache: true
                }
            });

            $('#sel_partno').on('select2:select', function (e) {
                var data = e.params.data;
                if (data.orderData) {
                    selectedOrderData = data.orderData;
                    $('#hidden_partno').val(data.orderData.partno);
                    $('#po_no').val(data.orderData.po_no || '');
                    $('#uom').val(data.orderData.uom || '');
                    $('#request_qty').val(data.orderData.qty || '');

                    $.get('@Url.Action("GetTotalReturned", "User")', {
                        partno: data.orderData.partno,
                        po_no: data.orderData.po_no
                    }).done(function (total) {
                        $('#already_returned').val(total);
                    });
                }
            });

            $('#sel_partno').on('select2:clear', function () {
                selectedOrderData = {};
                $('#hidden_partno').val('');
                $('#po_no').val('');
                $('#uom').val('');
                $('#request_qty').val('');
                $('#already_returned').val('');
            });

            $("#form_return").submit(function (e) {
                e.preventDefault();

                var partno = $("#hidden_partno").val();
                if (!partno) {
                    Swal.fire("Required!", "Please select a Part Number.", "warning");
                    return;
                }

                       // Ambil nilai request qty dari input field, kalau kosong default 0
        var request_qty = parseFloat($("#request_qty").val()) || 0;

        // Ambil nilai already returned dari input field, kalau kosong default 0
        var already_returned = parseFloat($("#already_returned").val()) || 0;

        // Ambil nilai return qty yang diinput user, kalau kosong default 0
        var qty_return = parseFloat($("#qty_return").val()) || 0;

        // Validasi: kalau return qty melebihi sisa yang belum di-return
        // Sisa = request_qty - already_returned
              var is_edit = $("#id_return").val() !== "";
        var original_qty = parseFloat($("#qty_return").data("original")) || 0;
        var max_qty = is_edit
            ? (request_qty - already_returned + original_qty) // perhitungan saat edit
            : (request_qty - already_returned); //untuk tambah

        if (qty_return > max_qty) {
            Swal.fire("Invalid!", "Return quantity cannot exceed remaining qty (" + max_qty + ").", "warning");
            return;
        }
                var fileInput = document.getElementById('file_pdf');
                if (fileInput.files.length > 0) {
                    var file = fileInput.files[0];
                    if (file.type !== 'application/pdf') {
                        Swal.fire("Invalid File!", "Only PDF files are allowed.", "warning");
                        return;
                    }
                }

                const url = $("#id_return").val()
                    ? "@Url.Action("UpdateReturn", "User")"
                    : "@Url.Action("CreateReturn", "User")";

                Swal.fire({
                    title: 'Confirmation!!',
                    text: "Are you sure you want to save this data?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    confirmButtonText: 'Yes, Save!',
                    showLoaderOnConfirm: true,
                    preConfirm: () => {
                        var formData = new FormData($("#form_return")[0]);
                        return $.ajax({
                            url: url,
                            type: 'POST',
                            data: formData,
                            contentType: false,
                            processData: false
                        }).done(function (msg) {
                            if (msg.trim().toUpperCase() === "OK") {
                                Swal.fire("Success!", "Data processed successfully.", "success");
                                $("#modal_return").modal("hide");
                                table.ajax.reload(null, false);
                            } else {
                                Swal.fire("Failed!", msg, "error");
                            }
                        });
                    }
                });
            });
        });

        function open_modal_add() {
            $("#form_return")[0].reset();
            $("#id_return").val("");
            $("#hidden_partno").val("");
            $('#sel_partno').val(null).trigger('change');
            $("#po_no").val('');
            $("#uom").val('');
            $("#request_qty").val('');
            $("#already_returned").val('');
             $("#qty_return").data("original", 0);
            $("#current_file_info").hide();
            $("#modalLabel").html('<i class="fas fa-plus-circle"></i> Create Material Return');
            $("#modal_return").modal("show");
        }

        function open_modal_edit(data) {
            $("#form_return")[0].reset();
            $("#id_return").val(data.id_return);
            $("#hidden_partno").val(data.partno || '');

            if (data.partno) {
                var option = new Option(data.partno, data.partno, true, true);
                $('#sel_partno').empty().append(option).trigger('change');
            } else {
                $('#sel_partno').val(null).trigger('change');
            }

            $("#po_no").val(data.po_no || '');
            $("#uom").val(data.uom || '');
            $("#request_qty").val(data.qty || '');
            $("#qty_return").val(data.qty_return);
            $("#qty_return").data("original", data.qty_return);
            $("#condition").val(data.condition);
            $("#remark").val(data.reason_return);

            // fetch already returned
                  if (data.partno && data.po_no) {
            $.get('@Url.Action("GetOrderListByStatusJson", "User")', {
                status: 'Closed',
                search: data.partno
            }).done(function (res) {
                if (res && res.length > 0) {
                    var order = res.find(o => o.po_no === data.po_no);
                    if (order) {
                        $('#request_qty').val(order.qty);
                    }
                }
            });

            $.get('@Url.Action("GetTotalReturned", "User")', {
                partno: data.partno,
                po_no: data.po_no
            }).done(function (total) {
                $('#already_returned').val(total);
            });
        }

            if (data.image_support) {
                $("#current_file_name").text(data.image_support);
                $("#current_file_link").attr("href", "/Uploads/returns/" + data.image_support);
                $("#current_file_info").show();
            } else {
                $("#current_file_info").hide();
            }

            $("#modalLabel").html('<i class="fas fa-edit"></i> Edit Material Return');
            $("#modal_return").modal("show");
        }

        function delete_data(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!',
                showLoaderOnConfirm: true,
                preConfirm: () => {
                    return $.ajax({
                        url: "@Url.Action("DeleteReturn", "User")",
                        type: 'POST',
                        data: { id: id }
                    }).done(function (msg) {
                        if (msg.trim().toUpperCase() === "OK") {
                            Swal.fire("Deleted!", "Your file has been deleted.", "success");
                            table.ajax.reload(null, false);
                        } else {
                            Swal.fire("Failed!", msg, "error");
                        }
                    });
                }
            });
        }
    </script>
}