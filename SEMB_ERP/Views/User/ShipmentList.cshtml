            });

            $('select[name=pic]').select2({
                dropdownParent: $("#modal_update_conf > .modal-dialog > .modal-content"),
                placeholder: '-- SELECT PIC --',
                width: '100%',
                ajax: {
                    url: "@Url.Action("GetPIC")",
                    data: function (params) {
                        return {
                            search_value: params.term
                        };
                    },
                    processResults: function (data) {
                        //console.log(data);
                        return {
                            results: data.items
                        }
                    },
                }
            })

            $('select[name=category_issue]').select2({
                dropdownParent: $("#modal_update_conf > .modal-dialog > .modal-content"),
                placeholder: '-- SELECT CATEGORY ISSUE --',
                width: '100%',
                ajax: {
                    url: "@Url.Action("GetCatNonConf")",
                    data: function (params) {
                        return {
                            search_value: params.term
                        };
                    },
                    processResults: function (data) {
                        //console.log(data);
                        return {
                            results: data.items
                        }
                    },
                }
            })

        });

        function updateSelectAllCheckbox() {
            var totalCheckboxes = $('.shipment-checkbox:visible').length;
            var checkedCheckboxes = $('.shipment-checkbox:visible:checked').length;
            $('#select_all_shipments').prop('checked', totalCheckboxes > 0 && totalCheckboxes === checkedCheckboxes);
        }

        function receive_shipment(id_shipment) {
            Swal.fire({
                title: 'Confirmation!!',
                text: "Mark this shipment as received?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#dc3545',
                confirmButtonText: 'Yes, Receive!',
                cancelButtonText: 'Cancel',
                showLoaderOnConfirm: true,
                preConfirm: function () {
                    return new Promise(function (resolve, reject) {
                        $.ajax({
                            url: "@Url.Action("ReceiveShipment")",
                            type: 'POST',
                            data: { id_shipment: id_shipment }
                        }).done(function (msg) {
                            let arr = msg.split(";");
                            if (arr[0] == "success") {
                                delete checkedShipments[id_shipment];
                                swal.fire("Success!", arr[1], "success").then(function () {
                                    location.reload();
                                })
                            }
                            else {
                                swal.fire("Failed!", msg, "error");
                            }
                        })
                    })
                },
                allowOutsideClick: () => !Swal.isLoading()
            })
        }

        function binning_to(id_shipment) {
            Swal.fire({
                title: 'Binning To',
                text: 'Select destination for binning',
                input: 'select',
                inputOptions: {
                    '': 'Select Destination',
                    'PEL': 'PEL',
                    'BLP': 'BLP'
                },
                inputPlaceholder: 'Select destination',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#dc3545',
                confirmButtonText: 'Continue',
                cancelButtonText: 'Cancel',
                inputValidator: (value) => {
                    if (!value) {
                        return 'Please select a destination!'
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    var storage_dest = result.value;

                    if (storage_dest === 'BLP') {
                        // BLP selected - ask for gatepass number
                        Swal.fire({
                            title: 'BLP Binning',
                            text: 'Please enter Gatepass Number',
                            input: 'text',
                            inputPlaceholder: 'Enter Gatepass Number',
                            showCancelButton: true,
                            confirmButtonColor: '#28a745',
                            cancelButtonColor: '#dc3545',
                            confirmButtonText: 'Submit',
                            inputValidator: (value) => {
                                if (!value) {
                                    return 'Gatepass Number is required for BLP!'
                                }
                            }
                        }).then((gatepassResult) => {
                            if (gatepassResult.isConfirmed) {
                                send_binning_request(id_shipment, 'BLP', gatepassResult.value);
                            }
                        });
                    } else if (storage_dest === 'PEL') {
                        // PEL selected - send immediately
                        send_binning_request(id_shipment, 'PEL', null);
                    }
                }
            });
        }

        function send_binning_request(id_shipment, storage_dest, gatepass_no) {
            Swal.fire({
                title: 'Processing...',
                text: 'Please wait',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.ajax({
                url: "@Url.Action("BinningShipment")",
                type: 'POST',
                data: { 
                    id_shipment: id_shipment,
                    storage_dest: storage_dest,
                    gatepass_no: gatepass_no
                }
            }).done(function (msg) {
                let arr = msg.split(";");
                if (arr[0] == "success") {
                    delete checkedShipments[id_shipment];
                    Swal.fire("Success!", arr[1], "success").then(function () {
                        location.reload();
                    });
                } else {
                    Swal.fire("Failed!", msg, "error");
                }
            }).fail(function () {
                Swal.fire("Error!", "An error occurred while processing your request", "error");
            });
        }

        // Update batch action buttons visibility
        function updateBatchButtons() {
            var checkedCount = Object.keys(checkedShipments).length;
            var shippedCount = 0;
            var receivedCount = 0;

            // Count by status
            for (var id in checkedShipments) {
                if (checkedShipments.hasOwnProperty(id)) {
                    var status = checkedShipments[id];
                    if (status === 'SHIPPED') shippedCount++;
                    if (status === 'RECEIVED') receivedCount++;
                }
            }

            if (checkedCount > 0) {
                $('#selected_count').show().text(checkedCount + ' selected');

                if (shippedCount > 0) {
                    $('#btn_receive_selected').show();
                } else {
                    $('#btn_receive_selected').hide();
                }

                if (receivedCount > 0) {
                    $('#btn_binning_selected').show();
                } else {
                    $('#btn_binning_selected').hide();
                }

                // Show delete button if user has permission
                if (user_roles.includes('requestor') || user_roles.includes('admin')) {
                    $('#btn_delete_selected').show();
                } else {
                    $('#btn_delete_selected').hide();
                }
            } else {
                $('#selected_count').hide();
                $('#btn_receive_selected').hide();
                $('#btn_binning_selected').hide();
                $('#btn_delete_selected').hide();
            }
        }

