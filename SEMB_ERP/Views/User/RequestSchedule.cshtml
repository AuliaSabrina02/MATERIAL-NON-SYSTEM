@{
    ViewData["Title"] = "Project Schedule";
}

<link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css' rel='stylesheet' />

<style>
    .kpi-card-wh {
        background: #ffffff;
        border-radius: 12px;
        padding: 12px 14px;
        margin-bottom: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
        border: 1px solid #e9ecef;
        cursor: default;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        display: flex;
        align-items: center;
        gap: 10px;
        height: 100%;
    }

        .kpi-card-wh:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
        }

    .kpi-icon-wh {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }

        .kpi-icon-wh i {
            color: #fff;
        }

    .kpi-body {
        flex: 1;
        min-width: 0;
    }

    .kpi-label-wh {
        font-size: 9.5px;
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        line-height: 1.3;
        margin-bottom: 2px;
    }

    .kpi-value-wh {
        font-size: 18px;
        font-weight: 700;
        color: #2c3e50;
        line-height: 1;
    }

    .kpi-col {
        padding-left: 4px !important;
        padding-right: 4px !important;
    }

    .card-header {
        background-color: #2f3d57 !important;
        border-radius: 12px 12px 0 0 !important;
    }

        .card-header h3, .card-header h5 {
            color: #ffffff !important;
        }

        .card-header i {
            color: #3DCD58 !important;
        }

    .hero {
        min-height: 70px;
        position: relative;
        display: flex;
        align-items: center;
        color: #fff;
        margin-bottom: 15px;
    }

        .hero .inner {
            background: rgba(0,0,0,0.7);
            height: 70px;
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 0 1rem;
        }

    .hero-title-container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        width: 100%;
    }

        .hero-title-container h3 {
            margin-bottom: 0;
            font-weight: 700;
            font-size: 1.75rem;
        }

    .fc .fc-toolbar {
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px 8px 0 0;
        margin-bottom: 0;
    }

    .fc .fc-toolbar-title {
        font-size: 18px;
        font-weight: 700;
        color: #2c3e50;
    }

    .fc .fc-button {
        background-color: white;
        border: 1px solid #dee2e6;
        color: #495057;
        text-transform: capitalize;
        padding: 6px 14px;
        font-weight: 500;
        transition: all 0.3s;
    }

        .fc .fc-button:hover,
        .fc .fc-button-primary:not(:disabled).fc-button-active,
        .fc .fc-button-primary:not(:disabled):active {
            background-color: #2f3d57 !important;
            border-color: #2f3d57 !important;
            color: white !important;
        }

    .fc .fc-col-header-cell {
        background-color: #2f3d57;
        color: white;
        padding: 10px 0;
        border-color: #2f3d57;
    }

        .fc .fc-col-header-cell a {
            color: white !important;
        }

    .fc .fc-daygrid-day.fc-day-today {
        background-color: #e8f5e9 !important;
    }

        .fc .fc-daygrid-day.fc-day-today .fc-daygrid-day-number {
            background-color: #3DCD58;
            color: white;
            border-radius: 50%;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 4px;
        }

    .fc .fc-event {
        background-color: #2f3d57;
        border: none;
        border-radius: 5px;
        padding: 3px 7px;
        font-size: 11px;
        font-weight: 500;
        cursor: pointer;
        color: #ffffff !important; /* ← tambah ini */
    }

        .fc .fc-event:hover {
            background-color: #3DCD58;
        }

    .fc .fc-list-event:hover td {
        background-color: #1e7e34 !important;
        color: #ffffff !important;
    }

    .fc .fc-list-event:hover .fc-list-event-title a {
        color: #ffffff !important;
    }

    .fc .fc-daygrid-day:hover {
        background-color: #f0f9f4;
        cursor: pointer;
    }


    .fc .fc-event.event-completed {
        background-color: #1e7e34 !important;
        border-left: 3px solid #3DCD58 !important;
    }

    .fc .fc-event.event-upcoming {
        background-color: #2f3d57 !important;
    }

    .fc .fc-event.event-overdue {
        background-color: #dc3545 !important;
    }
</style>

<!-- Hero -->
<section id="hero" class="hero bg-dark position-relative"
         style="background: url('@Url.Content("~/images/background/bg-am.jpg")') center center / cover no-repeat fixed;">
    <div class="inner">
        <div></div>
        <div class="hero-title-container">
            <h3 class="text-white">
                <i class="fas fa-calendar text-success me-2"></i>
                Project Schedule
            </h3>
        </div>
        <div class="ms-auto"></div>
    </div>
</section>

<div class="container-fluid px-2 pb-4">

    <!-- KPI Cards -->
    <div class="row flex-nowrap overflow-auto mb-3 pb-1" style="margin-left: 0; margin-right: 0;">

        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" style="cursor: pointer;" onclick="openDetailsModal('TOTAL')">
                <div class="kpi-icon-wh" style="background-color: #17a2b8;">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Total Schedules</div>
                    <div class="kpi-value-wh" id="totalSchedules">0</div>
                </div>
            </div>
        </div>

        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" style="cursor: pointer;" onclick="openDetailsModal('UPCOMING')">
                <div class="kpi-icon-wh" style="background-color: #dc3545;">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Upcoming This Week</div>
                    <div class="kpi-value-wh" id="upcomingSchedules">0</div>
                </div>
            </div>
        </div>

        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" style="cursor: pointer;" onclick="openDetailsModal('COMPLETED')">
                <div class="kpi-icon-wh" style="background-color: #28a745;">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Completed</div>
                    <div class="kpi-value-wh" id="completedSchedules">0</div>
                </div>
            </div>
        </div>

    </div>

    <!-- Calendar Card -->
    <div class="row px-1">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold mb-0">
                        <i class="fas fa-calendar-alt me-1"></i> Project Schedule
                    </h3>
                    <div class="ms-auto">
                        <button class="btn btn-sm"
                                style="background-color: #3DCD58; color: #fff; border-radius: 8px; font-weight: 600;"
                                onclick="openModal()">
                            <i class="fas fa-plus-circle me-1"></i> Add Schedule
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div id='calendar'></div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Modal Add Schedule -->
<div class="modal fade" id="scheduleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #2f3d57;">
                <h5 class="modal-title text-white">
                    <i class="fas fa-calendar-plus me-1"></i> Add Project Schedule
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="scheduleForm">
                <div class="modal-body p-4">

                    <!-- Summary Bar -->
                    <div class="d-flex align-items-center justify-content-between mb-3 p-3"
                         style="background: #f8f9fa; border-radius: 10px; border: 1px solid #e9ecef;">
                        <div>
                            <span style="font-size: 11px; color: #6c757d; text-transform: uppercase; font-weight: 600;">
                                <i class="fas fa-info-circle me-1" style="color: #3DCD58;"></i> New Schedule Entry
                            </span>
                            <div>
                                <span class="badge" style="background-color: #2f3d57; font-size: 11px; padding: 4px 10px; border-radius: 6px;">
                                    Fill in the details below
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold small">Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm" id="title" name="title"
                               required placeholder="e.g., MCB 123 Project Review">
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold small">Schedule Date & Time <span class="text-danger">*</span></label>
                        <input type="datetime-local" class="form-control form-control-sm" id="scheduleDate"
                               name="scheduleDate" required>
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold small">Description</label>
                        <textarea class="form-control form-control-sm" id="description" name="description"
                                  rows="3" placeholder="Add additional details about this schedule..."></textarea>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="sendEmail" name="sendEmail" checked>
                            <label class="form-check-label small" for="sendEmail">
                                <i class="fas fa-envelope me-1"></i> Send email notification on scheduled date
                            </label>
                        </div>
                    </div>

                </div>
                <div class="modal-footer" style="background: #f8f9fa; border-top: 1px solid #e9ecef;">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-sm"
                            style="background-color: #3DCD58; color: #fff; font-weight: 600;">
                        <i class="fas fa-save me-1"></i> Save Schedule
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="kpiDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #2f3d57;">
                <h5 class="modal-title text-white" id="kpiModalTitle">
                    <i class="fas fa-list me-2"></i> Schedule Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div id="kpiModalContent">
                <div class="text-center p-5">
                    <div class="spinner-border text-success" role="status"></div>
                    <p class="mt-2">Loading data...</p>
                </div>
            </div>
        </div>
    </div>
</div>
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    let calendar;

    document.addEventListener('DOMContentLoaded', function () {
        initializeCalendar();
    });

        function initializeCalendar() {
        const calendarEl = document.getElementById('calendar');
        calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,listWeek'
            },
            themeSystem: 'bootstrap5',
            height: 650,
            eventContent: function(arg) {
                let timeText = arg.timeText;
                let title = arg.event.title;
                let isCompleted = arg.event.extendedProps.isCompleted;
                return {
                    html: `<div style="display:flex; align-items:center; gap:3px; padding:2px 5px;">
                            ${isCompleted ? '<span style="color:#fff; font-weight:bold; font-size:10px;">✓</span>' : ''}
                            <span style="color:#fff; font-size:10px;">${timeText}</span>
                            <span style="color:#fff; font-size:11px;">${title}</span>
                           </div>`
                };
            },
            eventClick: function (info) {
                showEventDetails(info.event);
            },
            dateClick: function (info) {
                openModal(info.dateStr);
            }
        });

        calendar.render();
        loadSchedules();
    }


         function openDetailsModal(category) {
        let title = category === 'TOTAL' ? 'All Schedules' :
                    category === 'UPCOMING' ? 'Upcoming This Week' : 'Completed Schedules';
        $('#kpiModalTitle').html('<i class="fas fa-list me-2"></i> ' + title);
        $('#kpiDetailModal').modal('show');
        $('#kpiModalContent').html('<div class="text-center p-5"><div class="spinner-border text-success"></div><p class="mt-2">Fetching data...</p></div>');
        $.get('/User/GetScheduleDetailsPartial', { category: category }, function (data) {
            $('#kpiModalContent').html(data);
            Swal.fire({
                icon: 'success',
                title: 'Data Loaded',
                text: 'Showing ' + title,
                timer: 1500,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
            });
        }).fail(function() {
            $('#kpiModalContent').html('<div class="alert alert-danger m-3">Failed to load data.</div>');
        });
    }
      function loadSchedules() {
        fetch('/User/GetSchedules')
            .then(response => {
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                return response.json();
            })
            .then(res => {
                if (res.success && res.data) {
                    calendar.removeAllEventSources();
                    calendar.getEvents().forEach(event => event.remove());

                    const events = res.data.map(item => ({
                        id: item.id,

                   title: item.title,
                        start: item.start,
                        allDay: false,
                        extendedProps: {
                            description: item.description,
                            isCompleted: item.isCompleted   // ← tambah
                        },
                      classNames: [item.isCompleted ? 'event-completed'
                 : new Date(item.start) < new Date() ? 'event-overdue'
                 : 'event-upcoming'],
    backgroundColor: item.isCompleted ? '#1e7e34'
     : new Date(item.start) < new Date() ? '#dc3545'
                   : '#2f3d57',                    // biru = upcoming
                        borderColor: 'transparent'
                    }));

                    calendar.addEventSource(events);
                    setTimeout(() => updateStats(), 500);
                }
            })
            .catch(err => console.error('❌ Fetch error:', err));
    }

      function updateStats() {
        const events = calendar.getEvents();
        const now = new Date();
        const nextWeek = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);

        const notCompleted = events.filter(e => !e.extendedProps.isCompleted);

        document.getElementById('totalSchedules').textContent = events.length;
        document.getElementById('upcomingSchedules').textContent =
            notCompleted.filter(e => e.start >= now && e.start <= nextWeek).length;
        document.getElementById('completedSchedules').textContent =
            events.filter(e => e.extendedProps.isCompleted).length;  // ← dari flag
    }

    document.getElementById('scheduleForm').addEventListener('submit', function (e) {
        e.preventDefault();

        const payload = {
            Title: document.getElementById('title').value,
            ScheduledDate: document.getElementById('scheduleDate').value,
            Description: document.getElementById('description').value,
            SendEmail: document.getElementById('sendEmail').checked
        };

        Swal.fire({
            title: 'Saving...',
            text: 'Please wait',
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });

        fetch('/User/CreateSchedule', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                // ✅ Tutup modal pakai Bootstrap
                $('#scheduleModal').modal('hide');
                document.getElementById('scheduleForm').reset();

                Swal.fire({
                    icon: 'success',
                    title: 'Saved!',
                    text: 'Schedule added successfully.',
                    timer: 1500,
                    showConfirmButton: false
                });

                loadSchedules();
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: res.message });
            }
        })
        .catch(err => {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to save: ' + err.message });
        });
    });

    function openModal(date) {
        // ✅ Pakai Bootstrap modal
        $('#scheduleModal').modal('show');

        if (date) {
            document.getElementById('scheduleDate').value =
                date.includes('T') ? date : date + 'T09:00';
        }
    }

    function closeModal() {
        // ✅ Pakai Bootstrap modal
        $('#scheduleModal').modal('hide');
        document.getElementById('scheduleForm').reset();
    }
       function showEventDetails(event) {
        const eventDate = new Date(event.start);
        const isCompleted = event.extendedProps.isCompleted;
        const isPast = eventDate < new Date();

        Swal.fire({
            title: event.title,
            html: `
                <div style="text-align: left; padding: 10px;">
                    <p><strong>Date:</strong> ${eventDate.toLocaleString('en-GB')}</p>
                    <p><strong>Description:</strong> ${event.extendedProps.description || 'No description'}</p>
                    <p><strong>Status:</strong>
                        <span style="color: ${isCompleted ? '#28a745' : isPast ? '#ffc107' : '#17a2b8'}; font-weight: bold;">
                            ${isCompleted ? '✅ Completed' : isPast ? '⚠️ Overdue' : '🕐 Upcoming'}
                        </span>
                    </p>
                </div>
            `,
            icon: 'info',
            showCancelButton: true,
            showConfirmButton: !isCompleted,
            showDenyButton: true,
            confirmButtonText: 'Mark as Done',
            confirmButtonColor: '#2f3d57',
            denyButtonText: '🗑️ Delete',
            denyButtonColor: '#dc3545',
            cancelButtonText: 'Close',
            cancelButtonColor: '#6c757d'
        }).then((result) => {
            if (result.isConfirmed) {
                markScheduleCompleted(event.id);
            } else if (result.isDenied) {
                deleteSchedule(event.id);
            }
        });
    }


        function deleteSchedule(scheduleId) {
        Swal.fire({
            title: 'Delete Schedule?',
            text: 'This schedule will be permanently deleted and email notification will be cancelled.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Delete',
            confirmButtonColor: '#dc3545',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch('/User/DeleteSchedule', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(scheduleId)
                })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: 'Schedule has been deleted.',
                            timer: 1500,
                            showConfirmButton: false
                        });
                        loadSchedules();
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                });
            }
        });
    }
    function markScheduleCompleted(scheduleId) {
        fetch('/User/MarkScheduleCompleted', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(scheduleId)
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Done!',
                    text: 'Schedule marked as completed.',
                    timer: 1500,
                    showConfirmButton: false
                });
                loadSchedules();
            } else {
                Swal.fire('Error', res.message, 'error');
            }
        });
    }
</script>