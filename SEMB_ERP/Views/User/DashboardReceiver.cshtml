@model List<UserDetailModel>
@{
    ViewData["Title"] = "Dashboard Receiver";
    var user = Model.First();
}

<style>
    .kpi-card-wh {
        background: #ffffff;
        border-radius: 12px;
        padding: 12px 14px;
        margin-bottom: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
        border: 1px solid #e9ecef;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        display: flex;
        align-items: center;
        gap: 10px;
        height: 100%;
    }

        .kpi-card-wh:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
        }

    .kpi-icon-wh {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }

        .kpi-icon-wh i {
            color: #fff;
        }

    .kpi-body {
        flex: 1;
        min-width: 0;
    }

    .kpi-label-wh {
        font-size: 9.5px;
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        white-space: normal;
        word-break: break-word;
        line-height: 1.3;
        margin-bottom: 2px;
    }

    .kpi-value-wh {
        font-size: 18px;
        font-weight: 700;
        color: #2c3e50;
        line-height: 1;
    }

    .kpi-col {
        padding-left: 4px !important;
        padding-right: 4px !important;
    }

    .card {
        margin-bottom: 0;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }

    .card-header {
        background-color: #2f3d57;
        border-radius: 12px 12px 0 0 !important;
    }

        .card-header h3.card-title,
        .card-header .card-title {
            color: #ffffff !important;
        }

        .card-header i {
            color: #3DCD58 !important;
        }

        .card-header .btn-outline-secondary {
            color: #ffffff;
            border-color: rgba(255,255,255,0.4);
        }

            .card-header .btn-outline-secondary:hover {
                background-color: rgba(255,255,255,0.1);
            }

        .card-header .btn-tool {
            color: rgba(255,255,255,0.7);
        }

            .card-header .btn-tool:hover {
                color: #ffffff;
            }

    .hero {
        min-height: 70px;
        position: relative;
        display: flex;
        align-items: center;
        color: #fff;
        margin-bottom: 15px;
    }

        .hero .inner {
            background: rgba(0,0,0,0.7);
            height: 70px;
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 0 1rem;
        }

    .hero-title-container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        width: 100%;
    }

        .hero-title-container h3 {
            margin-bottom: 0;
            font-weight: 700;
            font-size: 1.75rem;
        }

    .status-badge {
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 0.85rem;
        font-weight: bold;
    }

    .table-sm td, .table-sm th {
        font-size: 0.9rem;
    }
</style>

<section id="hero" class="hero bg-dark position-relative"
         style="background: url('@Url.Content("~/images/background/bg-am.jpg")') center center / cover no-repeat fixed;">
    <div class="inner">
        <div></div>
        <div class="hero-title-container">
            <h3 class="text-white">
                <i class="fas fa-chart-pie text-success me-2"></i>
                Dashboard Receiver
            </h3>
        </div>
        <div class="ms-auto"></div>
    </div>
</section>

<div class="container-fluid px-2 pb-4">

    <!-- KPI Cards -->
    <div class="row flex-nowrap overflow-auto mb-2 pb-1" style="margin-left: 0; margin-right: 0;">

        <!-- Submission -->
        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" onclick="filterTableByStatus('Submission')">
                <div class="kpi-icon-wh" style="background-color: #FFBF00;">
                    <i class="fas fa-file-import"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Submission</div>
                    <div class="kpi-value-wh" id="total-submission">0</div>
                </div>
            </div>
        </div>

        <!-- Received -->
        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" onclick="filterTableByStatus('Received')">
                <div class="kpi-icon-wh" style="background-color: #22A855;">
                    <i class="fas fa-box-open"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Received</div>
                    <div class="kpi-value-wh" id="total-received">0</div>
                </div>
            </div>
        </div>

        <!-- Putaway -->
        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" onclick="filterTableByStatus('Putaway')">
                <div class="kpi-icon-wh" style="background-color: #2196C9;">
                    <i class="fas fa-warehouse"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Putaway</div>
                    <div class="kpi-value-wh" id="total-putaway">0</div>
                </div>
            </div>
        </div>

        <!-- Partially Picked -->
        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" onclick="filterTableByStatus('Partial')">
                <div class="kpi-icon-wh" style="background-color: #F45C1B;">
                    <i class="fas fa-tasks"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Partially Picked</div>
                    <div class="kpi-value-wh" id="total-partially-picked">0</div>
                </div>
            </div>
        </div>

        <!-- Closed -->
        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" onclick="filterTableByStatus('Closed')">
                <div class="kpi-icon-wh" style="background-color: #9E9E8E;">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Closed</div>
                    <div class="kpi-value-wh" id="total-closed">0</div>
                </div>
            </div>
        </div>

    </div>

    <!-- Chart Cards -->
    <div class="row g-3 px-1 mb-3">

        <!-- Request Status -->
        <div class="col-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-chart-bar me-1"></i> Request Status
                    </h3>
                </div>
                <div class="card-body">
                    <div id="bar_chart" style="width:100%; height:300px;"></div>
                </div>
            </div>
        </div>

        <!-- Picking Progress -->
        <div class="col-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-chart-pie me-1"></i> Picking Progress
                    </h3>
                </div>
                <div class="card-body">
                    <div id="pie_chart" style="width:100%; height:300px;"></div>
                </div>
            </div>
        </div>

        <!-- Block Bin Summary -->
        <div class="col-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-ban me-1"></i> Block Bin Summary (Top 10 Part Numbers)
                    </h3>
                </div>
                <div class="card-body">
                    <div id="block_bin_chart" style="width:100%; height:300px;"></div>
                </div>
            </div>
        </div>

        <!-- Return Status -->
        <div class="col-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-undo me-1"></i> Return Status
                    </h3>
                </div>
                <div class="card-body">
                    <div id="return_chart" style="width:100%; height:280px;"></div>
                </div>
            </div>
        </div>

        <!-- Pallet Problem Trend -->
        <div class="col-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-pallet me-1"></i> Pallet Problem Trend
                    </h3>
                </div>
                <div class="card-body">
                    <div id="pallet_problem_chart" style="width:100%; height:300px;"></div>
                </div>
            </div>
        </div>

        <!-- Aging Movement Chart -->
        <div class="col-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-chart-line me-1"></i> Aging Movement Chart
                    </h3>
                </div>
                <div class="card-body">
                    <div id="aging_chart" style="width:100%; height:300px;"></div>
                </div>
            </div>
        </div>

        <!-- Recent Variance History -->
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-exclamation-triangle me-1"></i> Recent Variance History
                    </h3>
                    <div class="card-tools ms-auto">
                        <a href="@Url.Action("VarianceHistory", "User")" class="btn btn-sm btn-outline-secondary">
                            View All
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive" id="variance-table-container">
                        <!-- ✅ Ganti ini -->
                        <div class="text-center p-3">
                            <i class="fas fa-spinner fa-spin"></i> Loading...
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Non-Conf -->
        <!-- Recent Non-Conf -->
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-exclamation-circle me-1"></i> Recent Non-Conf
                    </h3>
                    <div class="card-tools ms-auto">
                        <a href="@Url.Action("NonConfList", "User")" class="btn btn-sm btn-outline-secondary">
                            View All
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div id="nonconf-table-container">
                        <!-- ✅ Ganti ini -->
                        <div class="text-center p-3">
                            <i class="fas fa-spinner fa-spin"></i> Loading...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Filtered Orders -->
<div class="modal fade" id="modal_filtered_orders" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width: 85%;">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-list"></i> Order List by Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="body_filtered_orders">
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x"></i>
                    <p class="mt-3">Loading...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Filtered Requests -->
<div class="modal fade" id="modal_filtered_requests" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width: 85%;">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="fas fa-list"></i> Request List by Picking Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="body_filtered_requests">
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x"></i>
                    <p class="mt-3">Loading...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Request Detail -->
<div class="modal fade" id="modal_req_detail_dashboard" tabindex="-1">
    <div class="modal-dialog modal-xl" style="max-width: 85%;">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-list"></i> Request Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="body_req_detail_dashboard">
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x"></i>
                    <p class="mt-3">Loading...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Filtered Reservations -->
<div class="modal fade" id="modal_filtered_reservations" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width: 85%;">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-box"></i> Reservation List by Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="body_filtered_reservations">
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x"></i>
                    <p class="mt-3">Loading...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Filtered Returns -->
<div class="modal fade" id="modal_filtered_returns" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width: 85%;">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="fas fa-undo"></i> Return List by Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="body_filtered_returns">
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x"></i>
                    <p class="mt-3">Loading...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Block Bin Detail -->
<div class="modal fade" id="modal_filtered_blockbin" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width: 85%;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-ban"></i> Block Bin Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="body_filtered_blockbin">
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x"></i>
                    <p class="mt-3">Loading...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Pallet Problem Detail -->
<div class="modal fade" id="modal_pallet_container" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-pallet"></i> Pallet Problem Detail</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="modal_content_detail">
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x"></i>
                    <p class="mt-3">Loading...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal_aging_movement" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width: 85%;">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="fas fa-undo"></i> Aging - <span id="aging-modal-title"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="aging-modal-content-wrapper">
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-warning"></i>
                    <p class="mt-3">Preparing data...</p>
                </div>
            </div>
        </div>
    </div>
</div>
                    </section>
@section Scripts {
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/modules/heatmap.js"></script>

    <script>
        $(document).ready(function () {

                 Highcharts.setOptions({
            chart: {
                style: { fontFamily: 'inherit' }
            },
            legend: {
                itemStyle: {
                    color: '#000000',
                    fontFamily: 'inherit',
                    fontWeight: 'bold'
                }
            },
            xAxis: {
                labels: { style: { color: '#000000', fontFamily: 'inherit' } }
            },
            yAxis: {
                labels: { style: { color: '#000000', fontFamily: 'inherit' } },
                title: { style: { color: '#000000', fontFamily: 'inherit' } }
            },
            tooltip: {
                style: { fontFamily: 'inherit' }
            }
        });
            loadData();
            loadReserveReturnData();
            loadNonConfData();
            loadAgingMovementChart();
            loadBlockBinChart();
            loadPalletProblemChart();
             loadRecentVariance(); // ✅ Tambahkan ini


            setInterval(function() {
                loadData();
                loadReserveReturnData();
                loadNonConfData();
                loadAgingMovementChart();
                loadBlockBinChart();
                loadPalletProblemChart();
                 loadRecentVariance(); // ✅ Tambahkan ini

            }, 300000);
        });

        // ✅ FUNGSI BARU: Filter dengan Modal + Partial View
        function filterTableByStatus(statusName) {
            const statusMapping = {
                    'Submission': 'SUBMISSION',
        'Received': 'RECEIVED',
        'Putaway': 'PUTAWAY',
        'Partial': 'PARTIALLY PICKED',
        'Closed': 'CLOSED'
            };

            const statusValue = statusMapping[statusName] || statusName;
            console.log('Loading orders with status:', statusValue);

            $('#modal_filtered_orders').modal('show');
            $('#body_filtered_orders').html(`
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-primary"></i>
                    <p class="mt-3">Loading <strong>${statusName}</strong> orders...</p>
                </div>
            `);

            $.ajax({
                type: "GET",
                url: "@Url.Action("GetOrderListByStatus", "User")",
                data: { status: statusValue },
                success: function(response) {
                    $('#body_filtered_orders').html(response);
                    Swal.fire({
                        icon: 'success',
                        title: 'Data Loaded',
                        text: 'Showing ' + statusName + ' orders',
                        timer: 1500,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                },
                error: function(xhr, status, error) {
                    $('#body_filtered_orders').html(`
                        <div class="alert alert-danger m-3">
                            <i class="fas fa-exclamation-triangle"></i>
                            Error loading data: ${error}
                        </div>
                    `);
                    console.error('Error:', error);
                }
            });
        }

        function filterRequestByPickingStatus(statusName) {
                   const statusMapping = {
            'Request': 'REQUEST',
            'Start Picking': 'START PICKING',
            'Picking': 'PICKING',
            'Consolidation': 'CONSOLIDATION',
            'Transfering': 'TRANSFERING',
            'Supplied': 'SUPPLIED',
            'Done Picking': 'DONE PICKING'  // tambah ini
        };
            const statusValue = statusMapping[statusName] || statusName;
            console.log('Loading requests with status:', statusValue);

            $('#modal_filtered_requests').modal('show');
            $('#body_filtered_requests').html(`
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-primary"></i>
                    <p class="mt-3">Loading <strong>${statusName}</strong> requests...</p>
                </div>
            `);

            $.ajax({
                type: "GET",
                url: "@Url.Action("GetRequestListByStatus", "User")",
                data: { status: statusValue },
                success: function(response) {
                    $('#body_filtered_requests').html(response);
                    Swal.fire({
                        icon: 'success',
                        title: 'Data Loaded',
                        text: 'Showing ' + statusName + ' requests',
                        timer: 1500,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                },
                error: function(xhr, status, error) {
                    $('#body_filtered_requests').html(`
                        <div class="alert alert-danger m-3">
                            <i class="fas fa-exclamation-triangle"></i>
                            Error loading data: ${error}
                        </div>
                    `);
                    console.error('Error:', error);
                }
            });
        }

                 function loadData() {
            $.post('@Url.Action("GetReceiverSummary", "User")', function (data) {
                // Update Box Angka
                $('#total-submission').text(data.submission);
                $('#total-received').text(data.received);
                $('#total-putaway').text(data.putaway);
                $('#total-partially-picked').text(data.partiallyPicked);
                $('#total-closed').text(data.closed);

                // Update Charts
                renderCharts(data);

                // ✅ Bagian variance dihapus, sudah dipindah ke loadRecentVariance()

            }).fail(function(xhr, status, error) {
                console.error("❌ AJAX Error:", error);
            });
        }



                function loadRecentVariance() {
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetRecentVariance", "User")",
                success: function (response) {
                    $('#variance-table-container').html(response);
                },
                error: function () {
                    $('#variance-table-container').html(`
                        <div class="alert alert-danger m-2">
                            <i class="fas fa-exclamation-triangle"></i> Failed to load variance data
                        </div>
                    `);
                }
            });
        }
            function filterBlockBinByPartNo(partNo) {
            console.log('Loading block bin detail for part:', partNo);

            $('#modal_filtered_blockbin').modal('show');
            $('#body_filtered_blockbin').html(`
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-danger"></i>
                    <p class="mt-3">Loading block bin detail for <strong>${partNo}</strong>...</p>
                </div>
            `);

            $.ajax({
                type: "GET",
                url: "@Url.Action("GetBlockBinDetail", "User")",
                data: { partno: partNo },
                success: function(response) {
                    $('#body_filtered_blockbin').html(response);

                    Swal.fire({
                        icon: 'success',
                        title: 'Data Loaded',
                        text: 'Showing block bin detail for ' + partNo,
