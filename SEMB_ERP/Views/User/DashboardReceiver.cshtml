        function getStatusBadge(status) {
            status = status.toLowerCase();
            if (status.includes('picking')) return `<span class="badge bg-warning text-dark">PICKING</span>`;
            if (status.includes('close')) return `<span class="badge bg-secondary">CLOSED</span>`;
            if (status.includes('done')) return `<span class="badge bg-success">DONE</span>`;
            return `<span class="badge bg-info">${status.toUpperCase()}</span>`;
        }

        function renderCharts(data) {
            // === DATA UNTUK BAR CHART ===
            const barChartData = [
                { name: 'Submission', y: data.submission, color: '#FFBF00' },
                { name: 'Received', y: data.received, color: '#22A855' },
                { name: 'Putaway', y: data.putaway, color: '#2196C9' },
                { name: 'Partial', y: data.partiallyPicked, color: '#F45C1B' },
                { name: 'Closed', y: data.closed, color: '#9E9E8E' }
            ];

            // === DATA UNTUK PIE CHART ===
                const pickingColors = {
            'REQUEST': '#6c757d',
            'START PICKING': '#17a2b8',
            'PICKING': '#ffc107',
            'CONSOLIDATION': '#fd7e14',
            'TRANSFERING': '#007bff',
            'SUPPLIED': '#28a745',
            'DONE PICKING': '#20c997',
            'PLANT RECEIVED': '#e83e8c'
        };

            const pieChartData = data.pickingStatusStats.map(item => {
                let formattedName = item.label.toLowerCase().split(' ').map(word =>
                    word.charAt(0).toUpperCase() + word.slice(1)
                ).join(' ');

                return {
                    name: formattedName,
                    y: item.count,
                    color: pickingColors[item.label.toUpperCase()] || '#dee2e6'
                };
            });

            // === RENDER BAR CHART ===
                  Highcharts.chart('bar_chart', {
            chart: {
                type: 'column',
                style: {
                    fontFamily: 'inherit'  // ✅ ikut font dari CSS web
                }
            },
            title: { text: null },
            credits: { enabled: false },
            xAxis: {
                categories: barChartData.map(x => x.name),
                labels: { enabled: false },
                lineWidth: 0,
                tickWidth: 0
            },
            yAxis: {
                title: { text: 'Total Requests', style: { fontSize: '11px' } }
            },
            tooltip: {
                formatter: function () {
                    return '<b>' + this.point.name + '</b><br/>' +
                           this.y + ' requests<br/><i>Click to view details</i>';
                },
                style: { fontSize: '11px', fontFamily: 'inherit' }
            },
            legend: {
                enabled: true,
                align: 'center',
                verticalAlign: 'bottom',
                layout: 'horizontal',
                itemStyle: {
                    fontSize: '11px',
                    fontWeight: 'bold',
                    color: '#000000',        // ✅ teks hitam
                    fontFamily: 'inherit'    // ✅ font ikut web
                },
                symbolRadius: 6
            },
            plotOptions: {
                column: {
                    cursor: 'pointer',
                    colorByPoint: false,
                     borderRadius: 6,
                    dataLabels: {
                        enabled: true,
                        style: { fontWeight: 'bold', fontSize: '11px', textOutline: 'none' }
                    },
                    point: {
                        events: {
                            click: function () {
                                filterTableByStatus(this.series.name);
                            }
                        }
                    }
                }
            },
            series: barChartData.map(function(item) {
                return {
                    name: item.name,
                    color: item.color,
                    showInLegend: true,
                    data: [{ name: item.name, y: item.y }]
                };
            })
        });
            // === RENDER PIE CHART ===
            Highcharts.chart('pie_chart', {
                chart: { type: 'pie' },
                title: { text: null },
                credits: { enabled: false },
                tooltip: {
                    pointFormat: '{series.name}: <b>{point.y}</b><br/><i>Click to view details</i>',
