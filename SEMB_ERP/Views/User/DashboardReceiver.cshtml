        function getStatusBadge(status) {
            status = status.toLowerCase();
            if (status.includes('picking')) return `<span class="badge bg-warning text-dark">PICKING</span>`;
            if (status.includes('close')) return `<span class="badge bg-secondary">CLOSED</span>`;
            if (status.includes('done')) return `<span class="badge bg-success">DONE</span>`;
            return `<span class="badge bg-info">${status.toUpperCase()}</span>`;
        }

        function renderCharts(data) {
            // === DATA UNTUK BAR CHART ===
            const barChartData = [
                { name: 'Submission', y: data.submission, color: '#6c757d' },
                { name: 'Received', y: data.received, color: '#007bff' },
                { name: 'Putaway', y: data.putaway, color: '#ffc107' },
                { name: 'Partial', y: data.partiallyPicked, color: '#fd7e14' },
                { name: 'Closed', y: data.closed, color: '#28a745' }
            ];

            // === DATA UNTUK PIE CHART ===
            const pickingColors = {
                'REQUEST': '#6c757d',
                'START PICKING': '#17a2b8',
                'PICKING': '#ffc107',
                'CONSOLIDATION': '#fd7e14',
                'TRANSFERING': '#007bff',
                'SUPPLIED': '#28a745'
            };

            const pieChartData = data.pickingStatusStats.map(item => {
                let formattedName = item.label.toLowerCase().split(' ').map(word =>
                    word.charAt(0).toUpperCase() + word.slice(1)
                ).join(' ');

                return {
                    name: formattedName,
                    y: item.count,
                    color: pickingColors[item.label.toUpperCase()] || '#dee2e6'
                };
            });

            // === RENDER BAR CHART ===
            Highcharts.chart('bar_chart', {
            chart: { type: 'column' },
            title: {
                text: null,
                style: { fontSize: '12px' }
            },
            subtitle: {
                style: { fontSize: '10px', color: '#666' }
            },
            credits: { enabled: false },
            xAxis: {
                categories: barChartData.map(x => x.name),
                labels: {
                    style: { fontSize: '11px', fontWeight: 'bold' }
                }
            },
            yAxis: {
                title: { text: 'Total Requests', style: { fontSize: '11px' } }
            },
            tooltip: {
                pointFormat: '<b>{point.y}</b> requests<br/><i>Click to view details</i>',
                style: { fontSize: '11px' }
            },
            legend: {
                enabled: true,
                align: 'center',
                verticalAlign: 'bottom',
                layout: 'horizontal',
                itemStyle: {
                    fontSize: '11px',
                    fontWeight: 'bold'
                },
                symbolRadius: 6
            },
            plotOptions: {
                column: {
                    cursor: 'pointer',
                    dataLabels: {
                        enabled: true,
                        style: {
                            fontWeight: 'bold',
                            fontSize: '11px',
                            textOutline: 'none'
                        }
                    }
                }
            },
            series: barChartData.map(function (item) {
                return {
                    name: item.name,
                    data: [item.y],
                    color: item.color,
                    showInLegend: true,
                    dataLabels: {
                        enabled: true,
                        style: {
                            fontWeight: 'bold',
                            fontSize: '11px',
                            textOutline: 'none'
                        }
                    },
                    point: {
                        events: {
                            click: function () {
                                filterTableByStatus(item.name);
                            }
                        }
                    }
                };
            })
        });
            // === RENDER PIE CHART ===
            Highcharts.chart('pie_chart', {
                chart: { type: 'pie' },
                title: { text: null },
                credits: { enabled: false },
                tooltip: {
                    pointFormat: '{series.name}: <b>{point.y}</b><br/><i>Click to view details</i>',
                    style: { fontSize: '11px' }
                },
                legend: {
                    enabled: true,
                    align: 'center',
                    verticalAlign: 'bottom',
                    layout: 'horizontal',
