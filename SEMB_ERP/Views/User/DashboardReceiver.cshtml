                    function loadPalletProblemChart() {
            $.post('@Url.Action("GetPalletProblems", "User")', {
                draw: 1, start: 0, length: 1000
            }, function (response) {
                if (!response.data || response.data.length === 0) return;

                const grouped = {};
                response.data.forEach(x => {
                    // ✅ PERBAIKAN: Ambil langsung dari string, jangan pakai new Date()
                    // Format dari server: "2026-02-01T00:00:00" atau "2026-02-01"
                    const d = x.date.split('T')[0]; // Langsung split, tanpa new Date()
                    grouped[d] = (grouped[d] || 0) + 1;
                });

                // ✅ Sort tanggal ascending
                const categories = Object.keys(grouped).sort();
                const values = categories.map(k => grouped[k]);

                Highcharts.chart('pallet_problem_chart', {
                    chart: { type: 'column' },
                    title: { text: null },
                    credits: { enabled: false },
                    xAxis: {
                        categories: categories,
                        labels: {
                            style: { fontSize: '10px' },
                            rotation: -45
                        }
                    },
                    yAxis: {
                        title: { text: 'Total Problems' },
                        allowDecimals: false
                    },
                    tooltip: {
                        pointFormat: '<b>{point.y}</b> problem(s)<br/><i>Click to view details</i>',
                        style: { fontSize: '11px' }
                    },
                    plotOptions: {
                        column: {
                            cursor: 'pointer',
                            borderRadius: 6,
                            dataLabels: {
                                enabled: true,
                                style: {
                                    fontWeight: 'bold',
                                    fontSize: '11px'
                                }
                            },
                            point: {
                                events: {
                                    click: function () {
                                        // ✅ this.category sudah format yyyy-MM-dd dari categories array
                                        filterPalletByDate(this.category);
                                    }
                                }
                            }
                        }
                    },
                    series: [{
                        name: 'Pallet Problem',
                        data: values,
                        color: '#dc3545',
                        showInLegend: false
                    }]
                });
            });
        }

