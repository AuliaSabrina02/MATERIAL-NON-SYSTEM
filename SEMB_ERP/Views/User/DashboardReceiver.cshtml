@section Scripts {
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/modules/heatmap.js"></script>

    <script>
        $(document).ready(function () {
            loadData();
            loadReserveReturnData();
            loadNonConfData();
            loadAgingMovementChart();
            loadBlockBinChart();
            loadPalletProblemChart();

            setInterval(function() {
                loadData();
                loadReserveReturnData();
                loadNonConfData();
                loadAgingMovementChart();
                loadBlockBinChart();
                loadPalletProblemChart();
            }, 300000);
        });

        // ✅ FUNGSI BARU: Filter dengan Modal + Partial View
        function filterTableByStatus(statusName) {
            const statusMapping = {
                'Submission': 'SUBMISSION',
                'Received': 'RECEIVED',
                'Putaway': 'PUTAWAY',
                'Partial': 'PARTIALLY PICKED',
                'Closed': 'CLOSED'
            };

            const statusValue = statusMapping[statusName] || statusName;
            console.log('Loading orders with status:', statusValue);

            $('#modal_filtered_orders').modal('show');
            $('#body_filtered_orders').html(`
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-primary"></i>
                    <p class="mt-3">Loading <strong>${statusName}</strong> orders...</p>
                </div>
            `);

            $.ajax({
                type: "GET",
                url: "@Url.Action("GetOrderListByStatus", "User")",
                data: { status: statusValue },
                success: function(response) {
                    $('#body_filtered_orders').html(response);
                    Swal.fire({
                        icon: 'success',
                        title: 'Data Loaded',
                        text: 'Showing ' + statusName + ' orders',
                        timer: 1500,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                },
                error: function(xhr, status, error) {
                    $('#body_filtered_orders').html(`
                        <div class="alert alert-danger m-3">
                            <i class="fas fa-exclamation-triangle"></i>
                            Error loading data: ${error}
                        </div>
                    `);
                    console.error('Error:', error);
                }
            });
        }

        function filterRequestByPickingStatus(statusName) {
            const statusMapping = {
                'Request': 'REQUEST',
                'Start Picking': 'START PICKING',
                'Picking': 'PICKING',
                'Consolidation': 'CONSOLIDATION',
                'Transfering': 'TRANSFERING',
                'Supplied': 'SUPPLIED'
            };

            const statusValue = statusMapping[statusName] || statusName;
            console.log('Loading requests with status:', statusValue);

            $('#modal_filtered_requests').modal('show');
            $('#body_filtered_requests').html(`
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-primary"></i>
                    <p class="mt-3">Loading <strong>${statusName}</strong> requests...</p>
                </div>
            `);

            $.ajax({
                type: "GET",
                url: "@Url.Action("GetRequestListByStatus", "User")",
                data: { status: statusValue },
                success: function(response) {
                    $('#body_filtered_requests').html(response);
                    Swal.fire({
                        icon: 'success',
                        title: 'Data Loaded',
                        text: 'Showing ' + statusName + ' requests',
                        timer: 1500,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                },
                error: function(xhr, status, error) {
                    $('#body_filtered_requests').html(`
                        <div class="alert alert-danger m-3">
                            <i class="fas fa-exclamation-triangle"></i>
                            Error loading data: ${error}
                        </div>
                    `);
                    console.error('Error:', error);
                }
            });
        }

            function loadData() {
            $.post('@Url.Action("GetReceiverSummary", "User")', function (data) {
                // Update Box Angka
                $('#total-submission').text(data.submission);
                $('#total-received').text(data.received);
                $('#total-putaway').text(data.putaway);
                $('#total-partially-picked').text(data.partiallyPicked);
                $('#total-closed').text(data.closed);

                // Update Charts
                renderCharts(data);

                // Update Tabel Variance
                var html = '';
                if (data.recentVariance && data.recentVariance.length > 0) {
                    $.each(data.recentVariance, function(i, item) {
                        html += `<tr>
                            <td>${item.partno}</td>
                            <td>${item.sbin}</td>
                            <td><span class="badge badge-danger">${item.qty}</span></td>
                            <td><b>${item.request_no}</b></td>
                            <td><small>${item.record_date}</small></td>
                        </tr>`;
                    });
                } else {
                    html = '<tr><td colspan="5" class="text-center">No recent variance found</td></tr>';
                }

                $('#table-variance-body').html(html);

            }).fail(function(xhr, status, error) {
                console.error("❌ AJAX Error:", error);
            });
        }

            function filterBlockBinByPartNo(partNo) {
            console.log('Loading block bin detail for part:', partNo);

            $('#modal_filtered_blockbin').modal('show');
            $('#body_filtered_blockbin').html(`
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-danger"></i>
                    <p class="mt-3">Loading block bin detail for <strong>${partNo}</strong>...</p>
                </div>
            `);

            $.ajax({
                type: "GET",
                url: "@Url.Action("GetBlockBinDetail", "User")",
                data: { partno: partNo },
                success: function(response) {
                    $('#body_filtered_blockbin').html(response);

                    Swal.fire({
                        icon: 'success',
                        title: 'Data Loaded',
                        text: 'Showing block bin detail for ' + partNo,
                        timer: 1500,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                },
                error: function(xhr, status, error) {
                    $('#body_filtered_blockbin').html(`
                        <div class="alert alert-danger m-3">
                            <i class="fas fa-exclamation-triangle"></i>
                            Error loading data: ${error}
                        </div>
                    `);
                    console.error('Error:', error);
                }
            });
        }

        function loadBlockBinChart() {
            $.post('@Url.Action("GetBlockBin", "User")', {
                draw: 1,
                start: 0,
                length: 10,
                'order[0][column]': 0,
                'order[0][dir]': 'desc',
                'columns[0][data]': 'partno'
            }, function (response) {
                if (response.data) {
                    var categories = [];
                    var dataValues = [];

                    $.each(response.data, function (i, item) {
                        categories.push(item.partno);
                        dataValues.push(1);
                    });

                    Highcharts.chart('block_bin_chart', {
                        chart: { type: 'bar' },
                        title: { text: '' },
                        xAxis: {
                            categories: categories,
                            title: { text: 'Part Number' }
                        },
                        yAxis: {
                            min: 0,
                            title: { text: 'Occurrence' }
                        },
                        credits: { enabled: false },
                        tooltip: {
                            pointFormat: '<b>{point.y}</b> occurrence(s)<br/><i>Click to view details</i>',
                            style: { fontSize: '11px' }
                        },
                        plotOptions: {
                            bar: {
                                cursor: 'pointer', // ✅ Cursor pointer
                                dataLabels: {
                                    enabled: true,
                                    style: {
                                        fontWeight: 'bold',
                                        fontSize: '11px'
                                    }
                                },
                                point: {
                                    events: {
                                        click: function() {
                                            // ✅ EVENT CLICK - Filter by part number
                                            filterBlockBinByPartNo(this.category);
                                        }
                                    }
                                }
                            }
                        },
                        series: [{
                            name: 'Blocked Item',
                            data: dataValues,
                            color: '#dc3545',
                            showInLegend: false
                        }]
                    });
                }
            });
        }


                function filterPalletByDate(date) {
            console.log('Loading pallet problems for date:', date);

            $('#modal_pallet_container').modal('show');
            $('#modal_content_detail').html(`
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-danger"></i>
                    <p class="mt-3">Loading pallet problems for <strong>${date}</strong>...</p>
                </div>
            `);

            $.ajax({
                type: "GET",
                url: "@Url.Action("GetPalletProblemByDate", "User")",
                data: { date: date },
                success: function(response) {
                    $('#modal_content_detail').html(response);

                    Swal.fire({
                        icon: 'success',
                        title: 'Data Loaded',
                        text: 'Showing pallet problems for ' + date,
