        function processReservationChart(data) {
            let statusCount = {
                submission: 0,
                approved: 0,
                cancelled: 0
            };

            data.forEach(function(item) {
                let status = (item.status_desc || '').toLowerCase();
                if (status.includes('submission')) {
                    statusCount.submission++;
                } else if (status.includes('approved')) {
                    statusCount.approved++;
                } else if (status.includes('cancelled')) {
                    statusCount.cancelled++;
                }
            });

            renderReservationChart(statusCount);
        }

        function processReturnChart(data) {
            let statusCount = {
                sent: 0,
                approved: 0,
                inTransit: 0,
                returned: 0
            };

            data.forEach(function(item) {
                let status = (item.status_desc || '').toLowerCase();
                if (status.includes('sent')) {
                    statusCount.sent++;
                } else if (status.includes('approved')) {
                    statusCount.approved++;
                } else if (status.includes('transit')) {
                    statusCount.inTransit++;
                } else if (status.includes('returned')) {
                    statusCount.returned++;
                }
            });

            renderReturnChart(statusCount);
        }

