@model List<UserDetailModel>
@{
    var user = Model.First();
}

<style>
    .kpi-card-wh {
        background: #ffffff;
        border-radius: 12px;
        padding: 12px 14px;
        margin-bottom: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
        border: 1px solid #e9ecef;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        display: flex;
        align-items: center;
        gap: 10px;
        height: 100%;
    }

        .kpi-card-wh:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
        }

    .kpi-icon-wh {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }

        .kpi-icon-wh i {
            color: #fff;
        }

    .kpi-body {
        flex: 1;
        min-width: 0;
    }

    .kpi-label-wh {
        font-size: 9.5px;
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        white-space: normal;
        word-break: break-word;
        line-height: 1.3;
        margin-bottom: 2px;
    }

    .kpi-value-wh {
        font-size: 18px;
        font-weight: 700;
        color: #2c3e50;
        line-height: 1;
    }

    .kpi-col {
        padding-left: 4px !important;
        padding-right: 4px !important;
    }

    .card {
        margin-bottom: 0;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }

    .card-header {
        background-color: #2f3d57;
        border-radius: 12px 12px 0 0 !important;
    }

        .card-header h3.card-title,
        .card-header .card-title {
            color: #ffffff !important;
        }

        .card-header i {
            color: #3DCD58 !important;
        }

        .card-header .btn-outline-secondary {
            color: #ffffff;
            border-color: rgba(255,255,255,0.4);
        }

            .card-header .btn-outline-secondary:hover {
                background-color: rgba(255,255,255,0.1);
            }

    .hero {
        min-height: 70px;
        position: relative;
        display: flex;
        align-items: center;
        color: #fff;
        margin-bottom: 15px;
    }

        .hero .inner {
            background: rgba(0,0,0,0.7);
            height: 70px;
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 0 1rem;
        }

    .hero-title-container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        width: 100%;
    }

        .hero-title-container h3 {
            margin-bottom: 0;
            font-weight: 700;
            font-size: 1.75rem;
        }
</style>

<section id="hero" class="hero bg-dark position-relative"
         style="background: url('@Url.Content("~/images/background/bg-am.jpg")') center center / cover no-repeat fixed;">
    <div class="inner">
        <div></div>
        <div class="hero-title-container">
            <h3 class="text-white">
                <i class="fas fa-chart-pie text-success me-2"></i>
                Pallet Monitoring Dashboard
            </h3>
        </div>
        <div class="ms-auto"></div>
    </div>
</section>
<div class="container-fluid px-2 pb-4">

    <!-- KPI Cards -->
    <div class="row flex-nowrap overflow-auto mb-2 pb-1" style="margin-left: 0; margin-right: 0;">

        <!-- Pallet Created -->
        <!-- Pallet Created -->
        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" onclick="loadStatusModal('CREATION')">
                <!-- ✅ Tambahkan ini -->
                <div class="kpi-icon-wh" style="background-color: #17a2b8;">
                    <i class="fas fa-box"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Pallet Created</div>
                    <div class="kpi-value-wh" id="total-created">0</div>
                </div>
            </div>
        </div>

        <!-- Pallet Transferred -->
        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" onclick="loadStatusModal('TRANSFER')">
                <!-- ✅ Tambahkan ini -->
                <div class="kpi-icon-wh" style="background-color: #007bff;">
                    <i class="fas fa-dolly"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Pallet Transferred</div>
                    <div class="kpi-value-wh" id="total-transferred">0</div>
                </div>
            </div>
        </div>

        <!-- Pallet Completed -->
        <div class="kpi-col" style="min-width: 155px; flex: 1;">
            <div class="kpi-card-wh" onclick="loadStatusModal('SUPPLIED')">
                <!-- ✅ Tambahkan ini -->
                <div class="kpi-icon-wh" style="background-color: #28a745;">
                    <i class="fas fa-check-double"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-label-wh">Pallet Completed</div>
                    <div class="kpi-value-wh" id="total-supplied">0</div>
                </div>
            </div>
        </div>

    </div>

    <!-- Chart Cards -->
    <div class="row g-3 px-1">

        <!-- Pallet Movement -->
        <div class="col-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-chart-bar me-1"></i> Pallet Movement
                    </h3>
                </div>
                <div class="card-body">
                    <div id="pallet_main_chart" style="width:100%; height:300px;"></div>
                </div>
            </div>
        </div>

        <!-- Pallet Problem -->
        <div class="col-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-exclamation-triangle me-1"></i> Pallet Problem
                    </h3>
                </div>
                <div class="card-body">
                    <div id="pallet_problem_chart" style="width:100%; height:300px;"></div>
                </div>
            </div>
        </div>

        <!-- Recent Pallet History - full width -->
        <!-- Recent Pallet History - full width -->
        <div class="col-12">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center" style="min-height: 56px; padding: 12px 20px;">
                    <h3 class="card-title fw-bold" style="margin: 0;">
                        <i class="fas fa-history me-1"></i> Recent Pallet History
                    </h3>
                </div>
                <div class="card-body" id="pallet-history-container">
                    <!-- ✅ Ganti ini -->
                    <div class="text-center p-3">
                        <i class="fas fa-spinner fa-spin"></i> Loading...
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Modal Pallet Problem Detail -->
<div class="modal fade" id="modal_pallet_container" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-pallet"></i> Pallet Problem Detail
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="modal_content_detail">
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x"></i>
                    <p class="mt-3">Loading...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Pallet Detail -->
<div class="modal fade" id="modal_req_detail">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-list"></i> Pallet Detail</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="p-3">
                <div class="row">
                    <div class="col-12">
                        <table class="table table-borderless table-sm">
                            <tr>
                                <td width="20%">Request No</td>
                                <td id="request-no">:</td>
                            </tr>
                            <tr>
                                <td>Pallet No</td>
                                <td id="pallet-no">:</td>
                            </tr>
                            <tr>
                                <td>Status</td>
                                <td id="pallet-status">:</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-12 table-responsive">
                        <table class="table table-bordered table-striped align-center nowrap"
                               id="tbl-detail" style="font-size:12pt; width:100%;">
                            <thead class="bg-warning align-middle text-center">
                                <tr>
                                    <th width="12%">Box Id</th>
                                    <th width="12%">Part No</th>
                                    <th width="12%">Quantity</th>
                                    <th width="12%">S-Bin</th>
                                    <th width="12%">Picked By</th>
                                    <th width="12%">Record Date</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
    @section Scripts {
    <script src="https://code.highcharts.com/highcharts.js"></script>

    <script>
        var chartInstance;

            Highcharts.setOptions({
            chart: {
                style: { fontFamily: 'inherit' }
            },
            legend: {
                itemStyle: {
                    color: '#000000',
                    fontFamily: 'inherit',
                    fontWeight: 'bold'
                }
            },
            xAxis: {
                labels: { style: { color: '#000000', fontFamily: 'inherit' } }
            },
            yAxis: {
                labels: { style: { color: '#000000', fontFamily: 'inherit' } },
                title: { style: { color: '#000000', fontFamily: 'inherit' } }
            },
            tooltip: {
                style: { fontFamily: 'inherit' }
            }
        });

               $(document).ready(function () {
            loadSummary();
            loadChartData();
            loadRecentPalletHistory();  // ✅ Tambahkan () — sebelumnya tidak ada ()
            loadPalletProblemChart();

            setInterval(function () {
                loadSummary();
                loadChartData();
                loadRecentPalletHistory();  // ✅ Tambahkan () — sebelumnya tidak ada ()
                loadPalletProblemChart();
            }, 300000);
        });

        function loadSummary() {
            $.ajax({
                url: '@Url.Action("GetPalletSummary")',
                type: 'POST',
                dataType: 'json',
                success: function (data) {
                    $('#total-created').text(data.totalCreated);
                    $('#total-transferred').text(data.totalTransferred);
                    $('#total-supplied').text(data.totalSupplied);
                },
                error: function (xhr, status, error) {
                    console.error('Error loading summary:', error);
                }
            });
        }

        function loadChartData() {
            $.ajax({
                url: '@Url.Action("GetPalletStatusChartData")', // Pastikan arahkan ke method baru
                type: 'POST',
                dataType: 'json',
                success: function (data) {
                    renderStatusChart(data.categories, data.dataValues);
                },
                error: function (xhr, status, error) {
                    console.error('Error loading chart data:', error);
                }
            });
        }


                  function renderStatusChart(categories, dataValues) {
            const colorMap = {
                'CREATION': '#6c757d',
                'TRANSFER': '#007bff',
                'RECEIVED': '#17a2b8',
                'SUPPLIED': '#28a745'
            };

            const seriesData = categories.map((cat, index) => {
                return {
                    name: cat.charAt(0).toUpperCase() + cat.slice(1).toLowerCase(),
                    data: [dataValues[index]],
                    color: colorMap[cat.toUpperCase()] || '#000',
                    statusRaw: cat.toUpperCase() // Parameter status asli
                };
            });

            Highcharts.chart('pallet_main_chart', {
                chart: { type: 'column' },
                title: { text: null },
                credits: { enabled: false }, // Menghilangkan tulisan highcharts.com
                xAxis: { visible: false },
                yAxis: {
                    min: 0,
                    title: { text: 'Total Pallets' }
                },
                plotOptions: {
                    column: {
                        cursor: 'pointer',
                            borderRadius: 6,
                        dataLabels: { enabled: true },
                        point: {
                            events: {
                                click: function () {
                                    // Ambil status dari batang yang diklik
                                    var statusName = this.series.name.toUpperCase();
                                    const status = this.series.options.statusRaw;
                                    loadStatusModal(status);
                                }
                            }
                        }
                    }
                },
                series: seriesData
            });
        }

             // Fungsi AJAX Loader
        function loadStatusModal(status) {
            // 1. Tampilkan modal container
            $('#modal_pallet_container').modal('show');

            // 2. Set judul modal secara dinamis
            $('#modal_pallet_container .modal-title').html('<i class="fas fa-pallet"></i> Detail Status: ' + status);

            // 3. Tampilkan loading spinner sementara data diambil
            $('#modal_content_detail').html(`
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-primary"></i>
                    <p class="mt-3">Loading data ${status}...</p>
                </div>
            `);

            // 4. Jalankan AJAX
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetPalletListByStatus", "User")",
                data: { status: status },
                success: function (response) {
                    // Masukkan data partial view ke dalam modal
                    $('#modal_content_detail').html(response);

                    // Munculkan notifikasi SweetAlert2 (Data Loaded)
                    Swal.fire({
                        icon: 'success',
                        title: 'Data Loaded',
                        text: 'Showing pallet detail for ' + status,
                        timer: 1500,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                },
                error: function (xhr, status, error) {
                    // Tampilkan pesan error di dalam modal jika request gagal
                    $('#modal_content_detail').html(`
                        <div class="modal-body">
                            <div class="alert alert-danger m-3">
                                <i class="fas fa-exclamation-triangle"></i>
                                Error loading data: ${error}
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fas fa-times"></i> Close
                            </button>
                        </div>
                    `);
                    console.error('Error:', error);
                }
            });
        }


        // Initialize/Update Chart
        function initChart(categories, createdData, transferredData, suppliedData) {
            if (chartInstance) {
                // Update existing chart
                chartInstance.xAxis[0].setCategories(categories);
                chartInstance.series[0].setData(createdData);
                chartInstance.series[1].setData(transferredData);
                chartInstance.series[2].setData(suppliedData);
            } else {
                // Create new chart
                chartInstance = Highcharts.chart('pallet_main_chart', {
                    chart: { type: 'column' },
                    title: { text: '' },
                    xAxis: {
                        categories: categories,
                        crosshair: true
                    },
                    yAxis: {
                        min: 0,
                        title: { text: 'Total Pallets' }
                    },
                    tooltip: {
                        headerFormat: '<span style="font-size:10px">{point.key}</span><table>',
                        pointFormat: '<tr><td style="color:{series.color};padding:0">{series.name}: </td>' +
                            '<td style="padding:0"><b>{point.y}</b></td></tr>',
                        footerFormat: '</table>',
                        shared: true,
                        useHTML: true
                    },
                    plotOptions: {
                        column: {
                            pointPadding: 0.2,
                            borderWidth: 0
                        }
                    },
                    series: [
                        { name: 'Created', data: createdData, color: '#6c757d' },
                        { name: 'Transferred', data: transferredData, color: '#007bff' },
                        { name: 'Supplied', data: suppliedData, color: '#28a745' }
                    ]
                });
            }
        }


                function filterPalletByDate(date) {
            console.log('Loading pallet problems for date:', date);

            $('#modal_pallet_container').modal('show');
            $('#modal_content_detail').html(`
                <div class="text-center p-5">
                    <i class="fas fa-spinner fa-spin fa-3x text-danger"></i>
                    <p class="mt-3">Loading pallet problems for <strong>${date}</strong>...</p>
                </div>
            `);

            $.ajax({
                type: "GET",
                url: "@Url.Action("GetPalletProblemByDate", "User")",
                data: { date: date },
                success: function(response) {
                    $('#modal_content_detail').html(response);

                    Swal.fire({
                        icon: 'success',
                        title: 'Data Loaded',
                        text: 'Showing pallet problems for ' + date,
                        timer: 1500,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                },
                error: function(xhr, status, error) {
                    $('#modal_content_detail').html(`
                        <div class="modal-body">
                            <div class="alert alert-danger m-3">
                                <i class="fas fa-exclamation-triangle"></i>
                                Error loading data: ${error}
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fas fa-times"></i> Close
                            </button>
                        </div>
                    `);
                    console.error('Error:', error);
                }
            });
        }
                function loadRecentPalletHistory() {
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetRecentPalletHistory", "User")",
                success: function (response) {
                    $('#pallet-history-container').html(response);
                },
                error: function () {
                    $('#pallet-history-container').html(`
                        <div class="alert alert-danger m-2">
                            <i class="fas fa-exclamation-triangle"></i> Failed to load pallet history
                        </div>
                    `);
                }
            });
        }
                    function loadPalletProblemChart() {
            $.post('@Url.Action("GetPalletProblems", "User")', {
                draw: 1, start: 0, length: 1000
            }, function (response) {
                if (!response.data || response.data.length === 0) return;

                const grouped = {};
                response.data.forEach(x => {
                    // ✅ PERBAIKAN: Ambil langsung dari string, jangan pakai new Date()
                    // Format dari server: "2026-02-01T00:00:00" atau "2026-02-01"
                    const d = x.date.split('T')[0]; // Langsung split, tanpa new Date()
                    grouped[d] = (grouped[d] || 0) + 1;
                });

                // ✅ Sort tanggal ascending
                const categories = Object.keys(grouped).sort();
                const values = categories.map(k => grouped[k]);

                Highcharts.chart('pallet_problem_chart', {
                    chart: { type: 'column' },
                    title: { text: null },
                    credits: { enabled: false },
                    xAxis: {
                        categories: categories,
                        labels: {
                            style: { fontSize: '10px' },
                            rotation: -45
                        }
                    },
                    yAxis: {
                        title: { text: 'Total Problems' },
                        allowDecimals: false
                    },
                    tooltip: {
                        pointFormat: '<b>{point.y}</b> problem(s)<br/><i>Click to view details</i>',
                        style: { fontSize: '11px' }
                    },
                    plotOptions: {
                        column: {
                            cursor: 'pointer',
                            borderRadius: 6,
                            dataLabels: {
                                enabled: true,
                                style: {
                                    fontWeight: 'bold',
                                    fontSize: '11px'
                                }
                            },
                            point: {
                                events: {
                                    click: function () {
                                        // ✅ this.category sudah format yyyy-MM-dd dari categories array
                                        filterPalletByDate(this.category);
                                    }
                                }
                            }
                        }
                    },
                    series: [{
                        name: 'Pallet Problem',
                        data: values,
                        color: '#dc3545',
                        showInLegend: false
                    }]
                });
            });
        }
        // Show Detail Modal
        function show_detail(id_pallet, palletNo, status, requestNo) {
            $('#request-no').text(': ' + requestNo);
            $('#pallet-no').text(': ' + palletNo);
            $('#pallet-status').text(': ' + status);

            if ($.fn.dataTable.isDataTable('#tbl-detail')) {
                $('#tbl-detail').DataTable().destroy();
            }

            var table2 = $('#tbl-detail').DataTable({
                "ajax": {
                    "url": "@Url.Action("GetPalletDetail")",
                    "data": {
                        plt_id: id_pallet
                    },
                    "dataSrc": function (json) {
                        return json.map(function (item) {
                            return {
                                BoxId: item.box_id,
                                PartNo: item.partno,
                                Qty: item.qty,
                                Bin: item.sbin,
                                PickedBy: item.picked_by,
                                RecordDate: item.record_date
                            }
                        });
                    }
                },
                "columns": [
                    { "data": "BoxId" },
                    { "data": "PartNo" },
                    { "data": "Qty" },
                    { "data": "Bin" },
                    { "data": "PickedBy" },
                    { "data": "RecordDate" }
                ]
            });

            $('#modal_req_detail').modal('show');
        }
    </script>
    }