@model List<PartModel>
@{
    int no = 0;
}

<table class="table table-bordered table-sm text-center" id="list_sbin">
    <thead class="bg-info">
        <tr>
            <th>No.</th>
            <th>SBIN</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var part in Model)
        {
            no++;
            <tr>
                <td>@no</td>
                <td>@part.sbin</td>
                <td>
                    <button class="btn btn-sm btn-primary select-bin" data-sbin="@part.sbin">Select Bin <i class="fas fa-arrow-right"></i></button>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-end">
                <button class="btn btn-warning select-any-bin"><i class="fa fa-search"></i> Any Bin</button>
            </td>
        </tr>
    </tfoot>
</table>

