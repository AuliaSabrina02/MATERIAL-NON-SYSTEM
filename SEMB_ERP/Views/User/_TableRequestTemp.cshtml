@model List<RequestTempModel>
@{
    int no = 0;
    int total_shortage = 0;
}
<style>
    #body_req_list tbody tr.row_body:hover {
        background-color: #95db72;
        color: white;
    }

    #body_req_list {
        border-radius: 0.35rem; /* sudut tumpul */
        overflow: hidden; /* supaya border-radius bekerja */
    }

        #body_req_list td {
            border-bottom: 0.5px solid #FBF8EF !important; /* garis horizontal bawah */
            border-left: none !important; /* hilangkan garis vertikal kiri */
            border: none !important; /* hilangkan garis vertikal kiri */
            font-size: 10px;
        }

        #body_req_list thead th {
            border: none !important;
            font-size: 12px;
        }
</style>
<div class="row m-4">
    <div class="col-12">
        <table class="table table-bordered table-striped table-sm text-center table-custom" id="body_req_list">
            <thead class="bg-secondary">
                <tr>
                    <th>No.</th>
                    <th>Part</th>
                    <th>Req Qty</th>
                    <th>Available Qty</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var temp in Model)
                {
                    if (temp.status_stock == "Shortage")
                    {
                        total_shortage++;
                    }
                    var bg_status = temp.status_stock == "OK" ? "bg-success" : "bg-danger";
                    no++;
                    <tr>
                        <td>@no</td>
                        <td>@temp.partno</td>
                        <td>@temp.qty</td>
                        <td>@temp.available_qty</td>
                        <td class="@bg_status">@temp.status_stock</td>
                        <td>
                            <button class="btn btn-danger" onclick="delete_temp_req(@temp.id_temp)"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-4">
        <div class="form-group">
            <label>Plant :</label>
            <select class="form-select" id="picking_plant">
                <option value="PEM">PEM</option>
                <option value="PEL">PEL</option>
            </select>
        </div>
    </div>
    <div class="col-12">
        <div class="form-group">
            <label>Remark :</label>
            <textarea class="form-control" rowspan="3" name="picking_remark"></textarea>
        </div>
    </div>
    <div class="col-12 text-end">
        <button class="btn btn-success" name="btn_submit_picking" @((no <= 0 || total_shortage > 0) ? "disabled" : "")> SUBMIT <i class="fas fa-arrow-right"></i></button>
    </div>
</div>
<script>
    $(document).ready(function () {
        $("button[name=btn_submit_picking]").click(function () {
            let remark = $("textarea[name=picking_remark]").val();
            let plant = $('#picking_plant option:selected').val();

            Swal.fire({
                title: 'Confirmation !',
                text: "Are you sure want to request picking ?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#dc3545',
                confirmButtonText: 'Yes!',
                cancelButtonText: 'No!',
                showLoaderOnConfirm: true,
                preConfirm: function () {
                    return new Promise(function (resolve, reject) {
                        $.ajax({
                            type: "POST",
                            url: "@Url.Action("SubmitReqPicking")",
                            data: {
                                remark: remark,
                                plant: plant
                            }
                        }).done(function (res) {
                            let arr = res.split(";");
                            if (arr[0] == "OK") {
                                swal.fire("Success", "Request Picking Number Created " + arr[1], "success").then(function(){
                                    location.reload();
                                })
                            }
                            else {
                                swal.fire("Failed!", res, "error");
                            }
                        }).fail(function (err) {
                            swal.fire("Error!", err, "error");
                        })
                    })
                },
                allowOutsideClick: () => !Swal.isLoading()
            })
        })
    })
</script>