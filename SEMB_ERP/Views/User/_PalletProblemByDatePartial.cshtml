@model List<PalletProblem>
@{
    var dateFilter = ViewBag.DateFilter;
    var totalRecords = ViewBag.TotalRecords;
}

<style>
    .professional-table-pallet {
        font-size: 12px;
        border-collapse: separate;
        border-spacing: 0;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        background-color: white;
        overflow: hidden;
        min-width: 900px;
        width: 100%;
        table-layout: auto;
    }

        .professional-table-pallet thead th {
            background-color: #2f3d57;
            color: white;
            font-weight: 600;
            padding: 8px 12px;
            text-align: center;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .professional-table-pallet tbody td {
            padding: 6px 10px;
            border: 1px solid #f0f0f0;
            vertical-align: middle;
            font-size: 11px;
            white-space: nowrap;
        }

        .professional-table-pallet tbody tr:hover {
            background-color: #f0faf2 !important;
        }
</style>

<div class="modal-body p-3">

    <!-- Summary Bar -->
    <div class="d-flex align-items-center justify-content-between mb-3 p-3"
         style="background: #f8f9fa; border-radius: 10px; border: 1px solid #e9ecef;">
        <div>
            <span style="font-size: 11px; color: #6c757d; text-transform: uppercase; font-weight: 600;">
                <i class="fas fa-filter me-1" style="color: #3DCD58;"></i> Date Filter
            </span>
            <div>
                <span class="badge" style="background-color: #2f3d57; font-size: 12px; padding: 5px 12px; border-radius: 6px;">
                    @dateFilter
                </span>
            </div>
        </div>
        <div class="text-end">
            <span style="font-size: 11px; color: #6c757d; text-transform: uppercase; font-weight: 600;">
                Total Records
            </span>
            <div>
                <span class="badge" style="background-color: #3DCD58; font-size: 12px; padding: 5px 12px; border-radius: 6px;">
                    @totalRecords
                </span>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div style="overflow-x: auto; width: 100%;">
        <table class="table table-bordered table-striped professional-table-pallet" id="tbl_filtered_pallets">
            <thead>
                <tr>
                    <th>No.</th>
                    <th>Pallet No</th>
                    @* <th>Request No</th> *@
                    <th>Date</th>
                    <th>Issue</th>
                    <th>Status</th>
                    <th>Created By</th>
                    <th>Created Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    int no = 0;
                    foreach (var item in Model)
                    {
                        no++;
                        var statusClass = "";
                        var statusLower = (item.status ?? "").ToLower();
                        if (statusLower == "open") statusClass = "bg-warning text-dark";
                        else if (statusLower == "resolved") statusClass = "bg-success text-white";
                        else if (statusLower == "closed") statusClass = "bg-secondary text-white";
                        else statusClass = "bg-info text-white";

                        <tr>
                            <td class="text-center">@no</td>
                            <td><strong>@(item.pallet_no ?? "-")</strong></td>
                            @* <td>@(item.req_no ?? "-")</td> *@
                            <td>@(item.date.ToString("dd-MM-yyyy"))</td>
                            <td>@(item.issue ?? "-")</td>
                            <td class="text-center @statusClass">@(item.status ?? "-")</td>
                            <td>@(item.created_by ?? "-")</td>
                            <td>@(item.created_date.ToString("dd-MM-yyyy HH:mm"))</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="fas fa-inbox fa-2x mb-2 d-block" style="color: #dee2e6;"></i>
                            No pallet problems found for this date
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal-footer" style="background: #f8f9fa; border-top: 1px solid #e9ecef;">
    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">
        <i class="fas fa-times me-1"></i> Close
    </button>
</div>

<script>
    $(document).ready(function () {
        if ($.fn.DataTable.isDataTable('#tbl_filtered_pallets')) {
            $('#tbl_filtered_pallets').DataTable().destroy();
        }
        if (@totalRecords > 0)
        {
            $('#tbl_filtered_pallets').DataTable({
                pageLength: 10,
                ordering: true,
                searching: true,
                scrollX: false,
                autoWidth: false,
                order: [[7, 'desc']],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    paginate: { first: "First", last: "Last", next: "Next", previous: "Previous" }
                },
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
                     '<"row"<"col-sm-12"tr>>' +
                     '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>'
            });
        }
    });
</script>