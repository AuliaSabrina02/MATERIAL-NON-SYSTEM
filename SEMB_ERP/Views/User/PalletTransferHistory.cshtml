@section Scripts {

    <script>
        var table;
        var loading = "<div class='text-center'><i class='fa fa-4x fa-spinner fa-spin'></i></div>";
        var sesa_id = "@user.sesa_id".toUpperCase();

        $(document).ready(function () {

            var table = $("#table_req").DataTable({
                // "searching": false,
                // "scrollX": true,
                // "fixedColumns": {
                //     rightColumns: 1
                // },
                "orderCellsTop": true,
                "processing": true,
                "serverSide": true,
                "filter": true,
                "ajax": {
                    "url": "@Url.Action("GetPalletTransferHistory")",
                    "type": "POST",
                    "datatype": "json"
                },
                "columns": [
                    {   "data": "pallet_no",
                        "className": "align-middle text-center",
                        "render": function(data, type, row){
                            return `<span style="cursor: pointer;" onclick="show_detail(${row["id_pallet"]}, '${data}', '${row["status_pallet"]}', '${row["request_no"]}')">
                                        <b>${data}</b>
                                    </span>` ;
                        }
                    },
                    { "data": "request_no",  "className": "align-middle text-center" },
                    { "data": "status_pallet", "className": "align-middle text-center"},
                    { "data": "receive_date", "className": "align-middle text-center"},
                    { "data": "received_by_name", "className": "align-middle text-center"},
                    { "data": "supply_date", "className": "align-middle text-center"},
                    { "data": "supply_comment", "className": "align-middle text-center" },
                ],
                "drawCallback": function (settings) {
                    // Set the background color for the second column (index 1)
                    this.api().rows().every(function () {
                        var rowNode = this.node();
                        let receive_status = $(rowNode).find('td:eq(2)').html();
                        let supply_status = $(rowNode).find('td:eq(3)').html();
                        receive_status = receive_status ? receive_status.toLowerCase() : "";
                        supply_status = supply_status ? supply_status.toLowerCase() : "";
                        let bg_color = "";
                        //console.log(receive_status);
                        if(receive_status=="received"){
                            bg_color = "bg-success";
                            $(rowNode).find('td:eq(2)').addClass(bg_color);
                        }
                        if(supply_status=="supplied"){
                            bg_color = "bg-success";
                            $(rowNode).find('td:eq(3)').addClass(bg_color);
                        }
                        // $(rowNode).find('td').css("background-color", "#edfcf1")
                        // $(rowNode).find('td:eq(2)').addClass(bg_color);
                        // $(rowNode).find('td:eq(3)').addClass(bg_color);

                    });
                }
            });


            $('input.filter_table, select.filter_table', this).on('keyup change', function () {
                let trgt = $(this).attr('target');
                // alert(trgt);
                if (table.column(trgt).search() !== this.value) {
                    table
                        .column(trgt)
                        .search(this.value)
                        .draw();
                }
            });
        })

        function open_detail(id_request) {
            $("div#body_req_detail").html(loading);
            $("div#modal_req_detail").modal("show");
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetReqDetail")",
                data: {
                    id_request: id_request
                }
            }).done(function (res) {
                $("div#body_req_detail").html(res);
            }).fail(function(err){
                swal.fire("Error!", err, "error");
            })
        }

        function show_detail(id_pallet, palletNo, palletStatus, requestNo) {
            $('#request-no').text(': ' + requestNo);
            $('#pallet-no').text(': ' + palletNo);
            $('#pallet-status').text(': ' + palletStatus);

            if ($.fn.dataTable.isDataTable('#tbl-detail')) {
                $('#tbl-detail').DataTable().destroy();
            }
            var table2 = $('#tbl-detail').DataTable({
                "ajax": {
                    "url": "@Url.Action("GetPalletDetail")",
                    "data": {
                        plt_id : id_pallet
                    },
                    "dataSrc": function (json) {
                        return json.map(function (item) {
                            return {
                                BinId: item.id_pick,
                                RequestId: item.id_request,
                                DetID: item.id_det,
                                BoxId: item.box_id,
                                PartNo: item.partno,
                                Qty: item.qty,
                                Bin: item.sbin,
                                PickedBy: item.picked_by,
                                RecordDate: item.record_date
                            }
                        });
                    }
                },
                "columns": [
                    { "data": "BoxId" },
                    { "data": "PartNo" },
                    { "data": "Qty" },
                    { "data": "Bin" },
                    { "data": "PickedBy" },
                    { "data": "RecordDate" }
                ]
            });
            $("div#modal_pallet_detail").modal("show");
        }
    </script>
}