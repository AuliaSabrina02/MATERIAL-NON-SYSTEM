@section Scripts {

    <script>
        var table;
        var loading = "<div class='text-center'><i class='fa fa-4x fa-spinner fa-spin'></i></div>";
        var sesa_id = "@user.sesa_id".toUpperCase();

        $(document).ready(function () {

            var table = $("#table_req").DataTable({
                // "searching": false,
                // "scrollX": true,
                // "fixedColumns": {
                //     rightColumns: 1
                // },
                "orderCellsTop": true,
                "processing": true,
                "serverSide": true,
                "filter": true,
                "order": [],
                "ajax": {
                    "url": "@Url.Action("GetRequestList")",
                    "type": "POST",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "request_no", 
                        "className": "align-middle",
                        "render": function (data, type, row) {
                            return `<button class="btn btn-sm btn-secondary" onclick="open_detail(${row["id_request"]})">${data}</button>`;
                        }
                    },
                    { "data": "status_desc", "className": "align-middle" },
                    { "data": "requested_by_name", "className": "align-middle" },
                    { "data": "record_date", "className": "text-center" }
                ],
                "drawCallback": function (settings) {
                    // Set the background color for the second column (index 1)
                    this.api().rows().every(function () {
                        var rowNode = this.node();
                        let status_desc = $(rowNode).find('td:eq(1)').html();
                        status_desc = status_desc.toLowerCase();
                        let bg_color = "";
                        if(status_desc=="request"){
                            bg_color = "bg-light";
                        }
                        else if(status_desc=="start picking"){
                            bg_color = "bg-warning";
                        }
                        else if (status_desc=="picking") {
                            bg_color = "bg-warning";
                        } 
                        else if (status_desc=="done picking") {
                            bg_color = "bg-info";
                        }
                        else if (status_desc == "consolidation") {
                            bg_color = "bg-info";
                        }
                        else if (status_desc == "transfering") {
                            bg_color = "bg-primary";
                        }
                        else if (status_desc == "plant received") {
                            bg_color = "bg-success";
                        }
                        else if (status_desc == "supplied") {
                            bg_color = "bg-success";
                        }
                        else if (status_desc=="close") {
                            bg_color = "bg-secondary";
                        }
                        // $(rowNode).find('td').css("background-color", "#edfcf1")
                        $(rowNode).find('td:eq(1)').addClass(bg_color); // Change to desired color

                    });
                }
            });


            $('input.filter_table, select.filter_table', this).on('keyup change', function () {
                let trgt = $(this).attr('target');
                // alert(trgt);
                if (table.column(trgt).search() !== this.value) {
                    table
                        .column(trgt)
                        .search(this.value)
                        .draw();
                }
            });
        })

        function open_detail(id_request) {
            $("div#body_req_detail").html(loading);
            $("div#modal_req_detail").modal("show");
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetReqDetail")",
                data: {
                    id_request: id_request
                }
            }).done(function (res) {
                $("div#body_req_detail").html(res);
            }).fail(function(err){
                swal.fire("Error!", err, "error");
            })
        }


        var list_printers = @Html.Raw(Json.Serialize(listPrinter));
        const printInputOptions = list_printers.reduce((acc, text) => {
            acc[text] = text;
            return acc;
        }, {});


        function print_pallet(pallet_no){
            Swal.fire({
                title: 'Confirm',
                input: 'select',
                inputOptions: printInputOptions,
                text: 'Are you sure want to print this pallet ?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes!'
            }).then((result) => {
                if (result.value) {
                    var print = result.value;
                    // console.log(printer);
                    if (print == '0') {
                        swal.fire("Failed!", "Pilih printer terlebih dahulu!", "warning");
                        // alert("pilih printer")
                    }
                    else{
                        $.ajax({
                            type: "GET",
                            url: "https://warehouse.semb.se.com/wh_trans/Printlabel_project_pallet_Webservices.aspx",
                            data: {
                                print: print,
                                pallet_no: pallet_no,
                            }
                        }).done(function (res) {
                            swal.fire("Done!", "Print Succesfully", "success").then(function () {
                                location.reload();
                            })
                        }).fail(function (err) {
                            swal.fire("Done!", "Print Succesfully", "success").then(function () {
                                location.reload();
                            })
                        })
                    }
                    // $("#loading_modal").modal('show');
                }
            })
        }

        function download() {
            window.location.href = "@Url.Action("ExportRequestList", "User")";
        }

    </script>
}