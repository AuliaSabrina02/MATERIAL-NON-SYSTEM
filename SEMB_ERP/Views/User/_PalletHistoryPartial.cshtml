@model IEnumerable<dynamic>

<style>
    .professional-table-pallet {
        font-size: 12px;
        border-collapse: separate;
        border-spacing: 0;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        background-color: white;
        overflow: hidden;
        min-width: 600px;
        width: 100%;
        table-layout: auto;
    }

        .professional-table-pallet thead th {
            background-color: #2f3d57;
            color: white;
            font-weight: 600;
            padding: 8px 12px;
            text-align: center;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .professional-table-pallet tbody td {
            padding: 6px 10px;
            border: 1px solid #f0f0f0;
            vertical-align: middle;
            font-size: 11px;
            white-space: nowrap;
        }

        .professional-table-pallet tbody tr:hover {
            background-color: #f0faf2 !important;
        }
</style>

<div class="modal-body p-3">

    <!-- Summary Bar -->
    <div class="d-flex align-items-center justify-content-between mb-3 p-3"
         style="background: #f8f9fa; border-radius: 10px; border: 1px solid #e9ecef;">
        <div>
            <span style="font-size: 11px; color: #6c757d; text-transform: uppercase; font-weight: 600;">
                <i class="fas fa-filter me-1" style="color: #3DCD58;"></i> Status Filter
            </span>
            <div>
                <span class="badge" style="background-color: #2f3d57; font-size: 12px; padding: 5px 12px; border-radius: 6px;">
                    @ViewBag.StatusFilter
                </span>
            </div>
        </div>
        <div class="text-end">
            <span style="font-size: 11px; color: #6c757d; text-transform: uppercase; font-weight: 600;">
                Total Records
            </span>
            <div>
                <span class="badge" style="background-color: #3DCD58; font-size: 12px; padding: 5px 12px; border-radius: 6px;">
                    @(Model != null ? Model.Count() : 0)
                </span>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div style="overflow-x: auto; width: 100%;">
        <table class="table table-bordered table-striped professional-table-pallet" id="tbl_status_detail">
            <thead>
                <tr>
                    <th>Pallet No</th>
                    <th>Request No</th>
                    <th>Status</th>
                    <th>Record Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        string status = item.status_pallet?.ToString() ?? "";
                        string statusUpper = status.ToUpper();
                        string badgeColor = "#6c757d";

                        if (statusUpper == "SUPPLIED") badgeColor = "#28a745";
                        else if (statusUpper == "TRANSFER") badgeColor = "#007bff";
                        else if (statusUpper == "RECEIVED") badgeColor = "#17a2b8";
                        else if (statusUpper == "CREATION") badgeColor = "#6c757d";

                        // Parse record_date safely
                        string recordDateDisplay = "Not Available";
                        string recordDateRaw = item.record_date?.ToString() ?? "";
                        if (DateTime.TryParse(recordDateRaw, out DateTime parsedDate))
                        {
                            recordDateDisplay = parsedDate.ToString("dd-MMM-yyyy HH:mm");
                        }

                                <tr>
                                    <td class="text-center"><strong>@(item.pallet_no?.ToString() ?? "Not Available")</strong></td>
                                    <td class="text-center">@(item.request_no?.ToString() ?? "Not Available")</td>
                                    <td class="text-center">
                                        <span class="badge" style="background-color: @badgeColor; font-size: 11px; padding: 4px 10px; border-radius: 5px;">
                                    @(status != "" ? status : "Not Available")
                                        </span>
                                    </td>
                                    <td class="text-center">@recordDateDisplay</td>
                                </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal-footer" style="background: #f8f9fa; border-top: 1px solid #e9ecef;">
    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">
        <i class="fas fa-times me-1"></i> Close
    </button>
</div>

<script>
    $(document).ready(function () {
        if ($.fn.DataTable.isDataTable('#tbl_status_detail')) {
            $('#tbl_status_detail').DataTable().destroy();
        }

        $('#tbl_status_detail').DataTable({
            pageLength: 10,
            ordering: true,
            searching: true,
            order: [[3, 'desc']],
            scrollX: false,
            autoWidth: false,
            language: {
                search: "Search:",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                emptyTable: "Not Available",
                zeroRecords: "Not Available",
                paginate: {
                    first: "First",
                    last: "Last",
                    next: "Next",
                    previous: "Previous"
                }
            },
            dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
                 '<"row"<"col-sm-12"tr>>' +
                 '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>'
        });
    });
</script>