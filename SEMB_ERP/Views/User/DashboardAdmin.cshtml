                            }, 400);
                        },
                        error: function () { $('#aging-modal-content-wrapper').html('<div class="alert alert-danger m-3">Failed to load data.</div>'); }
                    });
                }

                function filterScheduleByCategory(category) {
                    let title = category === 'TOTAL' ? 'All Schedules' : category === 'UPCOMING' ? 'Upcoming This Week' : 'Completed Schedules';
                    $('#scheduleModalTitle').text(title);
                    $('#scheduleModalContent').html(`<div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-3x text-success"></i><p class="mt-3">Loading ${title}...</p></div>`);
                    $('#modal_schedule_detail').modal('show');
                    $.get('/User/GetScheduleDetailsPartial', { category: category }, function (data) {
                        $('#scheduleModalContent').html(data);
                        Swal.fire({ icon:'success', title:'Data Loaded', text:'Showing '+title, timer:1500, showConfirmButton:false, toast:true, position:'top-end' });
                    }).fail(function () {
                        $('#scheduleModalContent').html('<div class="alert alert-danger m-3">Failed to load data.</div>');
                    });
                }

