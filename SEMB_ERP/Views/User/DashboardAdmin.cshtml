                /* ── Modal Openers ── */
                function openOrderModal(status) {
                    const map = { 'Submission':'SUBMISSION','Received':'RECEIVED','Putaway':'PUTAWAY','Partial':'PARTIALLY PICKED','Closed':'CLOSED' };
                    const mapped = map[status] || status;
                    $('#modalOrderList').modal('show');
                    $('#modalOrderListBody').html(`<div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-3x text-primary"></i><p class="mt-3">Loading <strong>${status}</strong> orders...</p></div>`);
                    $.ajax({
                        type: "GET", url: '@Url.Action("GetOrderListByStatus", "User")', data: { status: mapped },
                      success: function (res) {
            $('#modalOrderListBody').html(res);
            setTimeout(function () {
                // ✅ Destroy dulu sebelum reinit
                if ($.fn.dataTable.isDataTable('#modalOrderListBody table')) {
                    $('#modalOrderListBody table').DataTable().destroy();
                }
                $('#modalOrderListBody table').DataTable({
                    paging: true, searching: true, ordering: true,
                    pageLength: 10, responsive: true
                });
                Swal.fire({ icon:'success', title:'Data Loaded', text:'Showing '+status+' orders', timer:1500, showConfirmButton:false, toast:true, position:'top-end' });
            }, 300);
        },
                        error: function (xhr) {
                            $('#modalOrderListBody').html(`<div class="alert alert-danger m-3"><i class="fas fa-exclamation-triangle"></i> Error: ${xhr.statusText}</div>`);
                        }
                    });
                }



                function openAgingModal(agingCategory) {
                    $('#aging-modal-title').text(agingCategory);
                    $('#aging-modal-content-wrapper').html(`<div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-3x text-primary"></i><p class="mt-3">Loading ${agingCategory} data...</p></div>`);
                    $('#modal_aging_movement').modal('show');
                    $.ajax({
                        type: 'GET', url: '@Url.Action("AgingMovementPartial", "User")', data: { agingCategory: agingCategory },
                        success: function (res) {
                            setTimeout(function () {
                                $('#aging-modal-content-wrapper').html(res);
