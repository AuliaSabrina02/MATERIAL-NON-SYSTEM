@{
    ViewData["Title"] = "Dashboard Admin";
}

<style>
    .kpi-card-wh {
        background: #ffffff;
        border-radius: 12px;
        padding: 12px 14px;
        margin-bottom: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
        border: 1px solid #e9ecef;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        display: flex;
        align-items: center;
        gap: 10px;
        height: 100%;
    }

        .kpi-card-wh:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
        }

    .kpi-icon-wh {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }

        .kpi-icon-wh i {
            color: #fff;
        }

    .kpi-body {
        flex: 1;
        min-width: 0;
    }

    .kpi-label-wh {
        font-size: 9.5px;
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        white-space: normal;
        word-break: break-word;
        line-height: 1.3;
        margin-bottom: 2px;
    }

    .kpi-value-wh {
        font-size: 18px;
        font-weight: 700;
        color: #2c3e50;
        line-height: 1;
    }

    .kpi-col {
        padding-left: 4px !important;
        padding-right: 4px !important;
    }

    .hero {
        min-height: 70px;
        position: relative;
        display: flex;
        align-items: center;
        color: #fff;
        margin-bottom: 15px;
    }

        .hero .inner {
            background: rgba(0,0,0,0.7);
            height: 70px;
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 0 1rem;
        }

    .hero-title-container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        width: 100%;
    }

        .hero-title-container h3 {
            margin-bottom: 0;
            font-weight: 700;
            font-size: 1.75rem;
        }

    #adminDashboardTabs {
        padding: 0px 0px 16px 0px;
    }

        #adminDashboardTabs .nav-link {
            border: none;
            border-radius: 6px;
            padding: 12px 20px;
            font-weight: 500;
            color: #6c757d;
            transition: all 0.3s ease;
            margin: 0 2px;
        }

            #adminDashboardTabs .nav-link:hover {
                background-color: #f8f9fa;
                color: #2c3e50;
            }

            #adminDashboardTabs .nav-link.active {
                background-color: #3DCD58 !important;
                color: white !important;
                box-shadow: 0 2px 8px rgba(61,205,88,0.3);
            }

    .dashboard-card {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.07);
        border: 1px solid #e9ecef;
        margin-bottom: 16px;
    }

    .card-header {
        background-color: #2f3d57 !important;
        border-radius: 12px 12px 0 0 !important;
    }

        .card-header h3.card-title,
        .card-header .card-title {
            color: #ffffff !important;
        }

        .card-header i {
            color: #3DCD58 !important;
        }

        .card-header .btn-outline-secondary {
            color: #ffffff;
            border-color: rgba(255,255,255,0.4);
        }

            .card-header .btn-outline-secondary:hover {
                background-color: rgba(255,255,255,0.1);
            }

    .coming-soon-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 80px 20px;
        color: #adb5bd;
    }

        .coming-soon-box i {
            font-size: 64px;
            margin-bottom: 16px;
            color: #dee2e6;
        }

        .coming-soon-box h4 {
            font-weight: 700;
            color: #6c757d;
            margin-bottom: 8px;
        }

        .coming-soon-box p {
            font-size: 14px;
            color: #adb5bd;
        }
</style>

<!-- Hero -->
<section id="hero" class="hero bg-dark position-relative"
         style="background: url('@Url.Content("~/images/background/bg-am.jpg")') center center / cover no-repeat fixed;">
    <div class="inner">
        <div></div>
        <div class="hero-title-container">
            <h3 class="text-white">
                <i class="fas fa-chart-pie text-success me-2"></i>
                Dashboard Admin
            </h3>
        </div>
        <div class="ms-auto"></div>
    </div>
</section>

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12 mt-3">
                <div class="dashboard-card">
                    <div class="card-body">

                        <!-- Tabs -->
                        <ul class="nav nav-pills justify-content-center" id="adminDashboardTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="tab-requestor"
                                        data-bs-toggle="tab" data-bs-target="#pane-requestor"
                                        type="button" role="tab" aria-selected="true">
                                    <i class="fas fa-user me-1"></i> Requestor
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-receiver"
                                        data-bs-toggle="tab" data-bs-target="#pane-receiver"
                                        type="button" role="tab" aria-selected="false">
                                    <i class="fas fa-box-open me-1"></i> Receiver
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-plant-receiver"
                                        data-bs-toggle="tab" data-bs-target="#pane-plant-receiver"
                                        type="button" role="tab" aria-selected="false">
                                    <i class="fas fa-industry me-1"></i> Plant Receiver
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content" id="adminDashboardTabContent">

                            <!-- ══════════════════════════════════════
                                 TAB 1 : REQUESTOR
                            ══════════════════════════════════════ -->
                            <div class="tab-pane fade show active" id="pane-requestor" role="tabpanel">

                                <!-- KPI Cards -->
                                <div class="row flex-nowrap overflow-auto mb-2 pb-1" style="margin-left:0;margin-right:0;">
                                    <div class="kpi-col" style="min-width:155px;flex:1;">
                                        <div class="kpi-card-wh" onclick="openOrderModal('Submission')">
                                            <div class="kpi-icon-wh" style="background-color:#6c757d;">
                                                <i class="fas fa-file-import"></i>
                                            </div>
                                            <div class="kpi-body">
                                                <div class="kpi-label-wh">Submission</div>
                                                <div class="kpi-value-wh" id="total-submission">0</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="kpi-col" style="min-width:155px;flex:1;">
                                        <div class="kpi-card-wh" onclick="openOrderModal('Received')">
                                            <div class="kpi-icon-wh" style="background-color:#007bff;">
                                                <i class="fas fa-box-open"></i>
                                            </div>
                                            <div class="kpi-body">
                                                <div class="kpi-label-wh">Received</div>
                                                <div class="kpi-value-wh" id="total-received">0</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="kpi-col" style="min-width:155px;flex:1;">
                                        <div class="kpi-card-wh" onclick="openOrderModal('Putaway')">
                                            <div class="kpi-icon-wh" style="background-color:#ffc107;">
                                                <i class="fas fa-warehouse"></i>
                                            </div>
                                            <div class="kpi-body">
                                                <div class="kpi-label-wh">Putaway</div>
                                                <div class="kpi-value-wh" id="total-putaway">0</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="kpi-col" style="min-width:155px;flex:1;">
                                        <div class="kpi-card-wh" onclick="openOrderModal('Partial')">
                                            <div class="kpi-icon-wh" style="background-color:#fd7e14;">
                                                <i class="fas fa-tasks"></i>
                                            </div>
                                            <div class="kpi-body">
                                                <div class="kpi-label-wh">Partially Picked</div>
                                                <div class="kpi-value-wh" id="total-partially-picked">0</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="kpi-col" style="min-width:155px;flex:1;">
                                        <div class="kpi-card-wh" onclick="openOrderModal('Closed')">
                                            <div class="kpi-icon-wh" style="background-color:#28a745;">
                                                <i class="fas fa-check-circle"></i>
                                            </div>
                                            <div class="kpi-body">
                                                <div class="kpi-label-wh">Closed</div>
                                                <div class="kpi-value-wh" id="total-closed">0</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Charts Row 1 -->
                                <div class="row g-3 px-1">
                                    <div class="col-6">
                                        <div class="card h-100">
                                            <div class="card-header d-flex align-items-center" style="min-height:56px;padding:12px 20px;">
                                                <h3 class="card-title fw-bold mb-0">
                                                    <i class="fas fa-chart-bar me-1"></i> Request Status
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <div id="bar_chart" style="width:100%;height:300px;"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="card h-100">
                                            <div class="card-header d-flex align-items-center" style="min-height:56px;padding:12px 20px;">
                                                <h3 class="card-title fw-bold mb-0">
                                                    <i class="fas fa-chart-pie me-1"></i> Picking Progress
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <div id="pie_chart" style="width:100%;height:300px;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Charts Row 2 -->
                                    <div class="col-6">
                                        <div class="card h-100">
                                            <div class="card-header d-flex align-items-center" style="min-height:56px;padding:12px 20px;">
                                                <h3 class="card-title fw-bold mb-0">
                                                    <i class="fas fa-chart-line me-1"></i> Aging Movement Chart
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <div id="aging_chart" style="width:100%;height:280px;"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="card h-100">
                                            <div class="card-header d-flex align-items-center" style="min-height:56px;padding:12px 20px;">
                                                <h3 class="card-title fw-bold mb-0">
                                                    <i class="fas fa-undo me-1"></i> Return Status
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <div id="return_chart" style="width:100%;height:280px;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Request Schedule -->
                                    <div class="col-12">
                                        <div class="card h-100">
                                            <div class="card-header d-flex align-items-center" style="min-height:56px;padding:12px 20px;">
                                                <h3 class="card-title fw-bold mb-0">
                                                    <i class="fas fa-chart-bar me-1"></i> Request Schedule
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <div id="summary_chart" style="width:100%;height:350px;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Recent Non-Conf -->
                                    <div class="col-12">
                                        <div class="card">
                                            <div class="card-header d-flex align-items-center" style="min-height:56px;padding:12px 20px;">
                                                <h3 class="card-title fw-bold mb-0">
                                                    <i class="fas fa-exclamation-circle me-1"></i> Recent Non-Conf
                                                </h3>
                                                <div class="card-tools ms-auto">
                                                    <a href="@Url.Action("NonConfList", "User")" class="btn btn-sm btn-outline-secondary">
                                                        View All
                                                    </a>
                                                </div>
                                            </div>
                                            <div class="card-body">
                                                <div id="nonconf-table-container">
                                                    <div class="text-center p-3">
                                                        <i class="fas fa-spinner fa-spin"></i> Loading...
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div><!-- /pane-requestor -->
                            <!-- ══════════════════════════════════════
                                 TAB 2 : RECEIVER  (placeholder)
                            ══════════════════════════════════════ -->
                            <div class="tab-pane fade" id="pane-receiver" role="tabpanel">

                                <!-- Charts Row -->
                                <div class="row g-3 px-1 mb-3">

                                    <!-- Block Bin Summary -->
                                    <div class="col-6">
                                        <div class="card h-100">
                                            <div class="card-header d-flex align-items-center" style="min-height:56px;padding:12px 20px;">
                                                <h3 class="card-title fw-bold mb-0">
                                                    <i class="fas fa-ban me-1"></i> Block Bin Summary (Top 10 Part Numbers)
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <div id="block_bin_chart" style="width:100%;height:300px;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Pallet Problem Trend -->
                                    <div class="col-6">
                                        <div class="card h-100">
                                            <div class="card-header d-flex align-items-center" style="min-height:56px;padding:12px 20px;">
                                                <h3 class="card-title fw-bold mb-0">
                                                    <i class="fas fa-pallet me-1"></i> Pallet Problem Trend
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <div id="pallet_problem_chart" style="width:100%;height:300px;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Recent Variance History -->
                                    <div class="col-12">
                                        <div class="card">
                                            <div class="card-header d-flex align-items-center" style="min-height:56px;padding:12px 20px;">
                                                <h3 class="card-title fw-bold mb-0">
                                                    <i class="fas fa-exclamation-triangle me-1"></i> Recent Variance History
                                                </h3>
                                                <div class="card-tools ms-auto">
                                                    <a href="@Url.Action("VarianceHistory", "User")" class="btn btn-sm btn-outline-secondary">
                                                        View All
                                                    </a>
                                                </div>
                                            </div>
                                            <div class="card-body">
                                                <div id="variance-table-container">
                                                    <div class="text-center p-3">
                                                        <i class="fas fa-spinner fa-spin"></i> Loading...
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <!-- ══════════════════════════════════════
                                 TAB 3 : PLANT RECEIVER  (placeholder)
                            ══════════════════════════════════════ -->
                            <div class="tab-pane fade" id="pane-plant-receiver" role="tabpanel">

                                <!-- KPI Cards -->
                                <div class="row flex-nowrap overflow-auto mb-2 pb-1" style="margin-left:0;margin-right:0;">
                                    <div class="kpi-col" style="min-width:155px;flex:1;">
                                        <div class="kpi-card-wh" onclick="loadPrStatusModal('CREATION')">
                                            <div class="kpi-icon-wh" style="background-color:#17a2b8;">
                                                <i class="fas fa-box"></i>
                                            </div>
                                            <div class="kpi-body">
                                                <div class="kpi-label-wh">Pallet Created</div>
                                                <div class="kpi-value-wh" id="pr-total-created">0</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="kpi-col" style="min-width:155px;flex:1;">
                                        <div class="kpi-card-wh" onclick="loadPrStatusModal('TRANSFER')">
                                            <div class="kpi-icon-wh" style="background-color:#007bff;">
                                                <i class="fas fa-dolly"></i>
                                            </div>
                                            <div class="kpi-body">
                                                <div class="kpi-label-wh">Pallet Transferred</div>
                                                <div class="kpi-value-wh" id="pr-total-transferred">0</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="kpi-col" style="min-width:155px;flex:1;">
                                        <div class="kpi-card-wh" onclick="loadPrStatusModal('SUPPLIED')">
                                            <div class="kpi-icon-wh" style="background-color:#28a745;">
                                                <i class="fas fa-check-double"></i>
                                            </div>
                                            <div class="kpi-body">
                                                <div class="kpi-label-wh">Pallet Completed</div>
                                                <div class="kpi-value-wh" id="pr-total-supplied">0</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Charts -->
                                <div class="row g-3 px-1">
                                    <!-- Pallet Movement -->
                                    <div class="col-12">
                                        <div class="card h-100">
                                            <div class="card-header d-flex align-items-center" style="min-height:56px;padding:12px 20px;">
                                                <h3 class="card-title fw-bold mb-0">
                                                    <i class="fas fa-chart-bar me-1"></i> Pallet Movement
                                                </h3>
                                            </div>
                                            <div class="card-body">
                                                <div id="pr-pallet-main-chart" style="width:100%;height:300px;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Placeholder col-6 biar sejajar -->
                                    <div class="col-6"></div>

                                    <!-- Recent Pallet History -->
                                    <div class="col-12">
                                        <div class="card h-100">
                                            <div class="card-header d-flex align-items-center" style="min-height:56px;padding:12px 20px;">
                                                <h3 class="card-title fw-bold mb-0">
                                                    <i class="fas fa-history me-1"></i> Recent Pallet History
                                                </h3>
                                            </div>
                                            <div class="card-body" id="pr-pallet-history-container">
                                                <div class="text-center p-3">
                                                    <i class="fas fa-spinner fa-spin"></i> Loading...
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div><!-- /tab-content -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- ══════════════════ MODALS ══════════════════ -->
<!-- Modal Order List -->
<div class="modal fade" id="modalOrderList" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width:85%;">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-list"></i> Order List</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalOrderListBody">
                <div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-3x"></i><p class="mt-3">Loading...</p></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Filtered Requests -->
<div class="modal fade" id="modal_filtered_requests" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width:85%;">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="fas fa-list"></i> Request List by Picking Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="body_filtered_requests">
                <div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-3x"></i><p class="mt-3">Loading...</p></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Filtered Reservations -->
<div class="modal fade" id="modal_filtered_reservations" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width:85%;">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-box"></i> Reservation List by Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div id="body_filtered_reservations">
                <div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-3x"></i><p class="mt-3">Loading...</p></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Filtered Returns -->
<div class="modal fade" id="modal_filtered_returns" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width:85%;">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="fas fa-undo"></i> Return List by Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div id="body_filtered_returns">
                <div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-3x"></i><p class="mt-3">Loading...</p></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Aging Movement -->
<div class="modal fade" id="modal_aging_movement" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width:85%;">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="fas fa-clock"></i> Aging - <span id="aging-modal-title"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div id="aging-modal-content-wrapper">
                <div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-3x text-warning"></i><p class="mt-3">Loading...</p></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Block Bin Detail -->
<div class="modal fade" id="modal_filtered_blockbin" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width:85%;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-ban"></i> Block Bin Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div id="body_filtered_blockbin">
                <div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-3x"></i><p class="mt-3">Loading...</p></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Pallet Problem Detail -->
<div class="modal fade" id="modal_pallet_container" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width:85%;">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-pallet"></i> Pallet Problem Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div id="modal_content_detail">
                <div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-3x"></i><p class="mt-3">Loading...</p></div>
            </div>
        </div>
