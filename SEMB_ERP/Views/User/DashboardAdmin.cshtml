@section Scripts {
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script>
                $(document).ready(function () {
                    Highcharts.setOptions({
                        chart: { style: { fontFamily: 'inherit' } },
                        legend: { itemStyle: { color: '#000000', fontWeight: 'bold' } },
                        xAxis: { labels: { style: { color: '#000000' } } },
                        yAxis: {
                            labels: { style: { color: '#000000' } },
                            title: { style: { color: '#000000' } }
                        }
                    });

                            $('#tab-receiver').on('shown.bs.tab', function () {
                    loadBlockBinChart();
                    loadPalletProblemChart();
                    loadRecentVariance();
                });

                        // Load plant receiver saat tab diklik
                $('#tab-plant-receiver').on('shown.bs.tab', function () {
                    loadPrSummary();
                    loadPrChartData();
                    loadPrRecentPalletHistory();
                });

                    loadData();
                    loadReserveReturnData();
                    loadNonConfData();
                    loadAgingMovementChart();
                    loadScheduleSummary();

                    setInterval(function () {
                        loadData();
                        loadReserveReturnData();
                        loadNonConfData();
                        loadAgingMovementChart();
                        loadScheduleSummary();
                    }, 300000);
                });

                /* ── Data Loaders ── */
                function loadData() {
                    $.post('@Url.Action("GetRequestorSummary", "User")', function (data) {
                        $('#total-submission').text(data.submission);
                        $('#total-received').text(data.received);
                        $('#total-putaway').text(data.putaway);
                        $('#total-partially-picked').text(data.partiallyPicked);
                        $('#total-closed').text(data.closed);
                        renderCharts(data);
                    });
                }

                function loadNonConfData() {
                    $.ajax({
                        type: "GET",
                        url: "@Url.Action("GetRecentNonConf", "User")",
                        success: function (res) { $('#nonconf-table-container').html(res); },
                        error: function () {
                            $('#nonconf-table-container').html('<div class="alert alert-danger m-2"><i class="fas fa-exclamation-triangle"></i> Failed to load non-conformance data</div>');
                        }
                    });
                }

                function loadReserveReturnData() {
                    $.post('@Url.Action("GetReservationList", "User")', { draw:1, start:0, length:1000 }, function (res) {
                        if (res.data) processReservationChart(res.data);
                    });
                    $.post('@Url.Action("GetReturnList", "User")', { draw:1, start:0, length:1000 }, function (res) {
                        if (res.data) processReturnChart(res.data);
                    });
                }

                function loadAgingMovementChart() {
                    $.ajax({
                        type: "GET",
                        url: "@Url.Action("GetAgingMovementChart", "User")",
                        success: function (res) {
                            var categories = [], s1 = [], s2 = [], s3 = [], s4 = [];
                            $.each(res, function (i, item) {
                                categories.push(item.label);
                                s1.push(item.value1); s2.push(item.value2);
                                s3.push(item.value3); s4.push(item.value4);
                            });
                            Highcharts.chart('aging_chart', {
                                chart: { type: 'column' },
                                title: { text: '' },
                                credits: { enabled: false },
                                xAxis: { categories: categories },
                                yAxis: { min: 0, title: { text: 'Total' } },
                                legend: { align: 'center', verticalAlign: 'bottom', itemStyle: { fontSize: '11px', fontWeight: 'normal' } },
                                tooltip: { headerFormat: '<b>{point.key}</b><br/>', pointFormat: '{series.name}: {point.y}<br/>Total: {point.stackTotal}' },
                                plotOptions: {
                                    column: {
                                                stacking: 'normal', dataLabels: { enabled: true }, cursor: 'pointer',     borderRadius: 6,
                                                point: { events: { click: function () { openAgingModal(this.series.name); } } }
                                    }
                                },
                                series: [
                                    { name: '<= 3 Months', data: s1, color: '#bcff47' },
                                    { name: '<= 6 Months', data: s2, color: '#ff9147' },
                                    { name: '<= 12 Months', data: s3, color: '#ff478a' },
                                    { name: '> 1 Year',    data: s4, color: '#c247ff' }
                                ]
                            });
                        }
                    });
                }

                function loadScheduleSummary() {
                    $.ajax({
                        url: '@Url.Action("GetSchedules", "User")',
                        type: 'GET',
                        success: function (res) {
                            if (!res.success || !res.data) return;
                            const now = new Date();
                            const nextWeek = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
                            let total = res.data.length, upcoming = 0, completed = 0;
                            res.data.forEach(item => {
                                if (item.isCompleted) { completed++; }
                                else if (new Date(item.start) >= now && new Date(item.start) <= nextWeek) { upcoming++; }
                            });
                            renderSummaryChart({ total, upcoming, completed });
                        }
                    });
                }

                /* ── Chart Renderers ── */
                function renderCharts(data) {
                    Highcharts.chart('bar_chart', {
                        chart: { type: 'column' }, title: { text: null }, credits: { enabled: false },
                        xAxis: { categories: ['Picking Volume'] },
                        yAxis: { title: { text: 'Total Requests' } },
                        legend: { enabled: true, align: 'center', verticalAlign: 'bottom', layout: 'horizontal', itemStyle: { fontSize: '11px', fontWeight: 'normal' } },
                        tooltip: { pointFormat: '<b>{series.name}</b>: {point.y}<br/><i>Click to view details</i>' },
                        plotOptions: {
                            column: {
                                        dataLabels: { enabled: true }, cursor: 'pointer',    borderRadius: 6,
                                        point: { events: { click: function () { openOrderModal(this.series.name); } } }
                            }
                        },
                        series: [
                            { name: 'Submission', data: [data.submission],       color: '#6c757d' },
                            { name: 'Received',   data: [data.received],         color: '#007bff' },
                            { name: 'Putaway',    data: [data.putaway],          color: '#ffc107' },
                            { name: 'Partial',    data: [data.partiallyPicked],  color: '#fd7e14' },
                            { name: 'Closed',     data: [data.closed],           color: '#28a745' }
                        ]
                    });

                    Highcharts.chart('pie_chart', {
                        chart: { type: 'pie' }, title: { text: null }, credits: { enabled: false },
                        legend: { enabled: true, align: 'center', verticalAlign: 'bottom', layout: 'horizontal', itemStyle: { fontSize: '11px', fontWeight: 'normal' }, symbolRadius: 6 },
                        plotOptions: {
                            pie: {
                                cursor: 'pointer',
                                dataLabels: { enabled: true, format: '{point.name}: {point.y} ({point.percentage:.1f}%)' },
                                showInLegend: true,
                                point: { events: { click: function () { filterRequestByPickingStatus(this.name); } } }
                            }
                        },
                        series: [{
                            name: 'Picking Status', colorByPoint: true,
                            data: [
                                { name: 'Request',       y: data.pickingSummary?.request       || 0, color: '#6c757d' },
                                { name: 'Start Picking', y: data.pickingSummary?.startPicking  || 0, color: '#17a2b8' },
                                // { name: 'Picking',       y: data.pickingSummary?.picking       || 0, color: '#ffc107' },
                                { name: 'Consolidation', y: data.pickingSummary?.consolidation || 0, color: '#fd7e14' },
                                { name: 'Transferring',  y: data.pickingSummary?.transferring  || 0, color: '#007bff' },
                                { name: 'Supplied',      y: data.pickingSummary?.supplied      || 0, color: '#28a745' },
                                         { name: 'Done Picking', y: data.pickingSummary?.donePicking || 0, color: '#20c997' }

                            ]
                        }]
                    });
                }

                function renderSummaryChart(data) {
                    Highcharts.chart('summary_chart', {
                        chart: { type: 'column' }, title: { text: null }, credits: { enabled: false },
                        xAxis: { categories: ['Schedule Status'] },
                        yAxis: { min: 0, title: { text: 'Total Schedule' } },
                        legend: { enabled: true, align: 'center', verticalAlign: 'bottom', layout: 'horizontal', itemStyle: { fontSize: '11px', fontWeight: 'normal' } },
                        tooltip: { pointFormat: '<b>{series.name}</b>: {point.y}<br/><i>Click to view details</i>' },
                        plotOptions: {
                            column: {
                                        dataLabels: { enabled: true }, cursor: 'pointer',    borderRadius: 6,
                                        point: { events: { click: function () {
                                    const map = { 'Total': 'TOTAL', 'Upcoming': 'UPCOMING', 'Completed': 'COMPLETED' };
                                    filterScheduleByCategory(map[this.series.name] || this.series.name);
                                }}}
                            }
                        },
                        series: [
                            { name: 'Total',     data: [data.total],     color: '#007bff' },
                            { name: 'Upcoming',  data: [data.upcoming],  color: '#ffc107' },
                            { name: 'Completed', data: [data.completed], color: '#28a745' }
                        ]
                    });
                }

                function processReservationChart(data) {
                    let s = { submission: 0, approved: 0, cancelled: 0 };
                    data.forEach(function (item) {
                        let st = (item.status_desc || '').toLowerCase();
                        if (st.includes('submission')) s.submission++;
                        else if (st.includes('approved')) s.approved++;
                        else if (st.includes('cancelled')) s.cancelled++;
                    });
                    renderReservationChart(s);
                }

                function processReturnChart(data) {
                    let s = { sent: 0, approved: 0, inTransit: 0, returned: 0 };
                    data.forEach(function (item) {
                        let st = (item.status_desc || '').toLowerCase();
                        if (st.includes('sent')) s.sent++;
                        else if (st.includes('approved')) s.approved++;
                        else if (st.includes('transit')) s.inTransit++;
                        else if (st.includes('returned')) s.returned++;
                    });
                    renderReturnChart(s);
                }

                function renderReservationChart(s) {
                    Highcharts.chart('reserve_chart', {
                        chart: { type: 'pie' }, title: { text: null }, credits: { enabled: false },
                        tooltip: { pointFormat: '{series.name}: <b>{point.y}</b> ({point.percentage:.1f}%)' },
                        plotOptions: {
                            pie: {
                                innerSize: '60%', allowPointSelect: true, cursor: 'pointer',
                                dataLabels: { enabled: true, format: '<b>{point.name}</b>: {point.y} ({point.percentage:.1f}%)', style: { fontSize: '11px', textOutline: 'none' } },
                                showInLegend: true,
                                point: { events: { click: function () { filterReservationByStatus(this.name); } } }
                            }
                        },
                        series: [{ name: 'Reservations', colorByPoint: true, data: [
                            { name: 'Submission', y: s.submission, color: '#17a2b8' },
                            { name: 'Approved',   y: s.approved,   color: '#28a745' },
                            { name: 'Cancelled',  y: s.cancelled,  color: '#dc3545' }
                        ]}]
                    });
                }

                function renderReturnChart(s) {
                    Highcharts.chart('return_chart', {
                        chart: { type: 'column' }, title: { text: null }, credits: { enabled: false },
                        xAxis: { categories: ['Return Status'] },
                        yAxis: { min: 0, title: { text: 'Total Returns' }, stackLabels: { enabled: true } },
                        legend: { align: 'center', verticalAlign: 'bottom', layout: 'horizontal', itemStyle: { fontSize: '11px' } },
                        tooltip: { pointFormat: '<b>{series.name}</b>: {point.y}<br/>Total: {point.stackTotal}<br/><i>Click to view details</i>' },
                        plotOptions: {
                            column: {
                                        stacking: 'normal', cursor: 'pointer',     borderRadius: 6,  dataLabels: { enabled: true },
                                point: { events: { click: function () { filterReturnByStatus(this.series.name); } } }
                            }
                        },
                        series: [
                            { name: 'Sent',       data: [s.sent],       color: '#ffc107' },
                            { name: 'Approved',   data: [s.approved],   color: '#28a745' },
                            { name: 'In Transit', data: [s.inTransit],  color: '#007bff' },
                            { name: 'Returned',   data: [s.returned],   color: '#6c757d' }
                        ]
                    });
                }


                function loadPrSummary() {
            $.ajax({
                url: '@Url.Action("GetPalletSummary")',
                type: 'POST',
                dataType: 'json',
                success: function (data) {
                    $('#pr-total-created').text(data.totalCreated);
                    $('#pr-total-transferred').text(data.totalTransferred);
                    $('#pr-total-supplied').text(data.totalSupplied);
                },
                error: function () { console.error('Error loading pallet summary'); }
            });
        }

        function loadPrChartData() {
            $.ajax({
                url: '@Url.Action("GetPalletStatusChartData")',
                type: 'POST',
                dataType: 'json',
                success: function (data) {
                    const colorMap = {
                        'CREATION': '#6c757d', 'TRANSFER': '#007bff',
                        'RECEIVED': '#17a2b8', 'SUPPLIED': '#28a745'
                    };
                    const seriesData = data.categories.map((cat, i) => ({
                        name: cat.charAt(0).toUpperCase() + cat.slice(1).toLowerCase(),
                        data: [data.dataValues[i]],
                        color: colorMap[cat.toUpperCase()] || '#000',
                        statusRaw: cat.toUpperCase()
                    }));
                    Highcharts.chart('pr-pallet-main-chart', {
                        chart: { type: 'column' }, title: { text: null }, credits: { enabled: false },
                        xAxis: { visible: false },
                        yAxis: { min: 0, title: { text: 'Total Pallets' } },
                        plotOptions: {
                            column: {
                                        cursor: 'pointer',     borderRadius: 6,  dataLabels: { enabled: true },
                                point: { events: { click: function () { loadPrStatusModal(this.series.options.statusRaw); } } }
                            }
                        },
                        series: seriesData
                    });
                },
                error: function () { console.error('Error loading pallet chart data'); }
            });
        }

        function loadPrRecentPalletHistory() {
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetRecentPalletHistory", "User")",
                success: function (res) { $('#pr-pallet-history-container').html(res); },
                error: function () {
                    $('#pr-pallet-history-container').html('<div class="alert alert-danger m-2"><i class="fas fa-exclamation-triangle"></i> Failed to load pallet history</div>');
                }
            });
        }

        function loadPrStatusModal(status) {
            $('#modal_pallet_status_title').html('<i class="fas fa-pallet"></i> Detail Status: ' + status);
            $('#modal_pallet_status_content').html(`<div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-3x text-primary"></i><p class="mt-3">Loading data ${status}...</p></div>`);
            $('#modal_pallet_status').modal('show');
            $.ajax({
                type: "GET", url: "@Url.Action("GetPalletListByStatus", "User")", data: { status: status },
                success: function (res) {
                    $('#modal_pallet_status_content').html(res);
                    Swal.fire({ icon:'success', title:'Data Loaded', text:'Showing pallet detail for '+status, timer:1500, showConfirmButton:false, toast:true, position:'top-end' });
                },
                error: function (xhr) { $('#modal_pallet_status_content').html(`<div class="alert alert-danger m-3">Error: ${xhr.statusText}</div>`); }
            });
        }

        function prShowDetail(id_pallet, palletNo, status, requestNo) {
            $('#pr-request-no').text(': ' + requestNo);
            $('#pr-pallet-no').text(': ' + palletNo);
            $('#pr-pallet-status').text(': ' + status);
            if ($.fn.dataTable.isDataTable('#pr-tbl-detail')) { $('#pr-tbl-detail').DataTable().destroy(); }
            $('#pr-tbl-detail').DataTable({
                ajax: {
                    url: "@Url.Action("GetPalletDetail")",
                    data: { plt_id: id_pallet },
                    dataSrc: function (json) {
                        return json.map(item => ({
                            BoxId: item.box_id, PartNo: item.partno, Qty: item.qty,
                            Bin: item.sbin, PickedBy: item.picked_by, RecordDate: item.record_date
                        }));
                    }
                },
                columns: [
                    { data: 'BoxId' }, { data: 'PartNo' }, { data: 'Qty' },
                    { data: 'Bin' }, { data: 'PickedBy' }, { data: 'RecordDate' }
                ]
            });
            $('#modal_pallet_req_detail').modal('show');
        }


                // ✅ Alias untuk partial view GetRecentPalletHistory yang memanggil show_detail()
                function show_detail(id_pallet, palletNo, status, requestNo) {
                    $('#pr-request-no').text(': ' + requestNo);
                    $('#pr-pallet-no').text(': ' + palletNo);
                    $('#pr-pallet-status').text(': ' + status);

                    if ($.fn.dataTable.isDataTable('#pr-tbl-detail')) {
                        $('#pr-tbl-detail').DataTable().destroy();
                    }

                    $('#pr-tbl-detail').DataTable({
                        ajax: {
                            url: "@Url.Action("GetPalletDetail")",
                            data: { plt_id: id_pallet },
                            dataSrc: function (json) {
                                return json.map(item => ({
                                    BoxId: item.box_id,
                                    PartNo: item.partno,
                                    Qty: item.qty,
                                    Bin: item.sbin,
                                    PickedBy: item.picked_by,
                                    RecordDate: item.record_date
                                }));
                            }
                        },
                        columns: [
                            { data: 'BoxId' }, { data: 'PartNo' }, { data: 'Qty' },
                            { data: 'Bin' }, { data: 'PickedBy' }, { data: 'RecordDate' }
                        ]
                    });

                    $('#modal_pallet_req_detail').modal('show');
                }

                        function loadRecentVariance() {
                    $.ajax({
                        type: "GET",
                        url: "@Url.Action("GetRecentVariance", "User")",
                        success: function (res) { $('#variance-table-container').html(res); },
                        error: function () {
                            $('#variance-table-container').html('<div class="alert alert-danger m-2"><i class="fas fa-exclamation-triangle"></i> Failed to load variance data</div>');
                        }
                    });
                }

                function loadBlockBinChart() {
                    $.post('@Url.Action("GetBlockBin", "User")', {
                        draw: 1, start: 0, length: 10,
                        'order[0][column]': 0, 'order[0][dir]': 'desc', 'columns[0][data]': 'partno'
                    }, function (response) {
                        if (!response.data) return;
                        var categories = [], dataValues = [];
                        $.each(response.data, function (i, item) {
                            categories.push(item.partno);
                            dataValues.push(1);
                        });
                        Highcharts.chart('block_bin_chart', {
                            chart: { type: 'bar' }, title: { text: '' }, credits: { enabled: false },
                            xAxis: { categories: categories, title: { text: 'Part Number' } },
                            yAxis: { min: 0, title: { text: 'Occurrence' } },
                            tooltip: { pointFormat: '<b>{point.y}</b> occurrence(s)<br/><i>Click to view details</i>' },
                            plotOptions: {
                                bar: {
                                            cursor: 'pointer',    borderRadius: 6,
                                            dataLabels: { enabled: true, style: { fontWeight: 'bold', fontSize: '11px' } },
                                    point: { events: { click: function () { filterBlockBinByPartNo(this.category); } } }
                                }
                            },
                            series: [{ name: 'Blocked Item', data: dataValues, color: '#dc3545', showInLegend: false }]
                        });
                    });
                }

                function filterBlockBinByPartNo(partNo) {
                    $('#modal_filtered_blockbin').modal('show');
                    $('#body_filtered_blockbin').html(`<div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-3x text-danger"></i><p class="mt-3">Loading block bin detail for <strong>${partNo}</strong>...</p></div>`);
                    $.ajax({
                        type: "GET", url: "@Url.Action("GetBlockBinDetail", "User")", data: { partno: partNo },
                        success: function (res) {
                            $('#body_filtered_blockbin').html(res);
                            Swal.fire({ icon:'success', title:'Data Loaded', text:'Showing block bin detail for '+partNo, timer:1500, showConfirmButton:false, toast:true, position:'top-end' });
                        },
                        error: function (xhr) { $('#body_filtered_blockbin').html(`<div class="alert alert-danger m-3">Error: ${xhr.statusText}</div>`); }
                    });
                }

                function loadPalletProblemChart() {
                    $.post('@Url.Action("GetPalletProblems", "User")', { draw:1, start:0, length:1000 }, function (response) {
                        if (!response.data || response.data.length === 0) return;
                        const grouped = {};
                        response.data.forEach(x => {
                            const d = x.date.split('T')[0];
                            grouped[d] = (grouped[d] || 0) + 1;
                        });
                        const categories = Object.keys(grouped).sort();
                        const values = categories.map(k => grouped[k]);
                        Highcharts.chart('pallet_problem_chart', {
                            chart: { type: 'column' }, title: { text: null }, credits: { enabled: false },
                            xAxis: { categories: categories, labels: { style: { fontSize: '10px' }, rotation: -45 } },
                            yAxis: { title: { text: 'Total Problems' }, allowDecimals: false },
                            tooltip: { pointFormat: '<b>{point.y}</b> problem(s)<br/><i>Click to view details</i>' },
                            plotOptions: {
                                column: {
                                    cursor: 'pointer', borderRadius: 6,
                                    dataLabels: { enabled: true, style: { fontWeight: 'bold', fontSize: '11px' } },
                                    point: { events: { click: function () { filterPalletByDate(this.category); } } }
                                }
                            },
                            series: [{ name: 'Pallet Problem', data: values, color: '#dc3545', showInLegend: false }]
                        });
                    });
                }

                function filterPalletByDate(date) {
                    $('#modal_pallet_container').modal('show');
                    $('#modal_content_detail').html(`<div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-3x text-danger"></i><p class="mt-3">Loading pallet problems for <strong>${date}</strong>...</p></div>`);
                    $.ajax({
                        type: "GET", url: "@Url.Action("GetPalletProblemByDate", "User")", data: { date: date },
                        success: function (res) {
