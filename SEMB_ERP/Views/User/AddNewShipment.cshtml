@using SEMB_ERP.Models
@*@model ViewModel*@
@using System.Globalization;
@using Microsoft.AspNetCore.Http;
@using SEMB_ERP.Controllers;
@inject IHttpContextAccessor Accessor

@{
    string sesa_id = ViewBag.sesa_id;
    string name = ViewBag.name;
    string plant = ViewBag.plant;
    string todayDate = DateTime.Today.ToString("yyyy-MM-dd");

    List<string> supplierList = ViewBag.supplierList;
}

<style>

    .table-row {
        cursor: pointer;
    }

    .modal {
        overflow-y: auto;
    }

    .box_form_input {
        background-color: #fcfcfc;
        border-radius: 5px;
        box-shadow: 1px 2px 8px 2px rgba(152,152,152,0.7);
    }

    /* .content {
        font-family: Verdana
    } */

</style>
<section id="hero1" class="hero bg-dark position-relative">
    <div class="inner d-flex justify-content-between align-items-center px-3 py-2 w-100">

        <!-- Kiri (kosong / placeholder) -->
        <div class="extract-info">
        </div>

        <!-- Tengah: Judul (absolutely centered) -->
        <div class="position-absolute top-50 start-50 translate-middle text-center">
            <h3 class="text-white mb-0">
                <i class="fas fa-exclamation text-success"></i>
                <b>Shipment Tracker</b>
            </h3>
        </div>
    </div>
</section>
<div class="content">
    <div class="container-fluid">
        <div class="row pt-3">
            <div class="col-md-12">
                <div class="offset-1 col-10 py-4 px-5 mb-4" style="background: #f8f9fa; border-radius: 15px; box-shadow: 0 8px 20px rgba(0,0,0,0.1);">
                    <!-- HEADER -->
                    <div class="text-center mb-4">
                        <label class="badge bg-warning text-dark shadow-sm" style="font-size:18pt; border-radius:50px; padding:12px 30px; cursor: default;">
                            <i class="fas fa-plus me-2"></i> Add New Shipment
                        </label>
                    </div>
                    @* <div class="card-header bg-success">
                        <h5 class="text-center"><i class="fa fa-plus"></i> Add New Shipment</h5>
                    </div> *@
                    <div class="card-body">
                        <div class="row">
                            <form id="form_upload_shipment">
                                <div class="row">
                                    <div class="offset-3 col-6 mb-4" style="border-top: 2px #e3e3e3 solid"></div>
                                    <div class="col-12 pl-4 pr-4">
                                        <div class="form-group">
                                            <label>Upload File Request (Excel File)<span class="text-danger">*</span></label>
                                            @* <input class="form-control" type="file" name="file_upload" required /> *@
                                            <div class="input-group">
                                                <input type="file" class="form-control" id="file_upload" name="file_upload" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" aria-label="Upload" required>
                                                <a href="~/Template/Template_Upload_Material_Shipment.xlsx" class="btn btn-primary">
                                                    <i class="fas fa-file-download"></i> Download Template
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    @* <div class="col-6 pl-4 pr-4">

                                        <div class="form-group">
                                            <label>Supporting Documents (Excel or PDF)</label>
                                            <input type="file" class="form-control" name="file_support" >
                                        </div>
                                    </div> *@
                                </div>

                                <div class="form-group text-center">
                                    <button type="submit" class="btn btn-success mt-2" name="btn_confirm_upload">Submit Shipment <i class="fa fa-arrow-right"></i></button>
                                </div>
                            </form>

                            <!-- Separator -->
                            <div class="offset-3 col-6 mb-4 mt-5" style="border-top: 2px #e3e3e3 solid"></div>
                            <div class="text-center mb-4">
                                <label class="badge bg-info text-white shadow-sm" style="font-size:14pt; border-radius:50px; padding:10px 25px; cursor: default;">
                                    <i class="fas fa-keyboard me-2"></i> OR Add Manually
                                </label>
                            </div>

                            <!-- Manual Input Form -->
                            <form id="form_manual_shipment">
                                <div class="row">
                                    <div class="col-6 pl-4 pr-4">
                                        <div class="form-group">
                                            <label>Project Name<span class="text-danger">*</span></label>
                                            <input class="form-control" type="text" name="project_name" placeholder="Project Name" autocomplete="off" required />
                                        </div>
                                        <div class="form-group">
                                            <label>Stage Name<span class="text-danger">*</span></label>
                                            <input class="form-control" type="text" name="stage_name" placeholder="Stage Name" autocomplete="off" required />
                                        </div>
                                        <div class="form-group">
                                            <label>WO No<span class="text-danger">*</span></label>
                                            <input class="form-control" type="text" name="wo_no" placeholder="WO Number" autocomplete="off" required />
                                        </div>
                                        <div class="form-group">
                                            <label>Part No<span class="text-danger">*</span></label>
                                            <input class="form-control" type="text" name="partno" placeholder="Part Number" autocomplete="off" required />
                                        </div>
                                    </div>
                                    <div class="col-6 pl-4 pr-4">
                                        <div class="form-group">
                                            <label>Revision<span class="text-danger">*</span></label>
                                            <input class="form-control" type="text" name="revision" placeholder="Revision" autocomplete="off" required />
                                        </div>
                                        <div class="form-group">
                                            <label>Qty<span class="text-danger">*</span></label>
                                            <input class="form-control" type="number" name="qty" placeholder="Quantity" autocomplete="off" step="any" required />
                                        </div>
                                        <div class="form-group">
                                            <label>Is Coated<span class="text-danger">*</span></label>
                                            <select class="form-control" name="is_coated" required>
                                                <option value="">-- SELECT --</option>
                                                <option value="COATED">COATED</option>
                                                <option value="NON COATED">NON COATED</option>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label>Ship Date<span class="text-danger">*</span></label>
                                            <input class="form-control" type="date" name="ship_date" autocomplete="off" value="@todayDate" required />
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group text-center">
                                    <button type="submit" class="btn btn-success mt-2" name="btn_submit_manual">Submit Shipment <i class="fa fa-arrow-right"></i></button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="modal_temp_order" class="modal fade">
    <div class="modal-dialog" role="document" style="min-width:80%">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-file-import"></i> Review Shipment</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row" id="body_temp_shipment"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-danger" data-bs-dismiss="modal"><i class="fas fa-times"></i> Cancel</button>
                <button class="btn btn-success" name="btn_confirm_shipment"><i class="fas fa-save"></i> Submit</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        var Table;
        var loading = "<i class='fa fa-4x fa-spinner fa-spin'></i>";

        $(document).ready(function () {

            $("form#form_upload_shipment").submit(function (e) {
                e.preventDefault();
                $("div#body_temp_shipment").html("<div class='text-center'>" + loading + "</div>");
                $("div#modal_temp_order").modal("show");
                let formData = new FormData(this);
                $.ajax({
                    url: "@Url.Action("UploadShipment")",
                    type: 'POST',
                    data: formData,
                    cache: false,
                    contentType: false,
                    processData: false
                }).done(function (res) {
                    $("div#body_temp_shipment").html(res);
                }).fail(function (err) {
                    swal.fire("Error", "Upload Failed -> " + err, "error");
                })
            })

            $("button[name=btn_confirm_shipment]").click(function(){
                let total_error = $("input[name=total_error]").val();
                let total_upload = $("input[name=total_upload]").val();
                if (total_error > 0) {
                    swal.fire("Error!", "Cannot submit with error data!!", "error");
                }
                else if (total_upload == 0) {
                    swal.fire("Error!", "No data!!", "error");
                }
                else {
                    let id_upload = $("input[name=id_upload]").val();
                    // let file_support = $("form#form_upload_shipment").find("input[name=file_support]")[0].files[0];

                    // var fileInput = $('#fileInput')[0];
                    // var file = fileInput.files[0];
                    let formData = new FormData();
                    formData.append('id_upload', id_upload);
                    // formData.append('file_support', file_support);

                    Swal.fire({
                        title: 'Confirmation!!',
                        text: "Are you sure ?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#28a745',
                        cancelButtonColor: '#dc3545',
                        confirmButtonText: 'Yes!',
                        cancelButtonText: 'No!',
                        showLoaderOnConfirm: true,
                        preConfirm: function () {
                            return new Promise(function (resolve, reject) {
                                $.ajax({
                                    url: "@Url.Action("SubmitUploadShipment")",
                                    type: 'POST',
                                    data: formData,
                                    processData: false, // Important: prevent jQuery from processing the data
                                    contentType: false// Important: prevent jQuery from setting contentType
                                }).done(function (msg) {
                                    let arr = msg.split(";");
                                    if (arr[0] == "success") {
                                        swal.fire("Success!", arr[1], "success").then(function () {
                                            location.reload();
                                        })
                                    }
                                    else {
                                        swal.fire("Failed!", msg, "error");
                                    }
                                })
                            })
                        },
                        allowOutsideClick: () => !Swal.isLoading()
                    })
                }
            })

            // Handle Manual Shipment form submission
            $("form#form_manual_shipment").submit(function (e) {
                e.preventDefault();

                let formData = new FormData(this);

                Swal.fire({
                    title: 'Confirmation!!',
                    text: "Submit this shipment?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#dc3545',
                    confirmButtonText: 'Yes, Submit!',
                    cancelButtonText: 'Cancel',
                    showLoaderOnConfirm: true,
                    preConfirm: function () {
                        return new Promise(function (resolve, reject) {
                            $.ajax({
                                url: "@Url.Action("AddShipmentManual")",
                                type: 'POST',
                                data: formData,
                                processData: false,
                                contentType: false
                            }).done(function (msg) {
                                let arr = msg.split(";");
                                if (arr[0] == "success") {
                                    swal.fire("Success!", arr[1], "success").then(function () {
                                        location.reload();
                                    });
                                } else {
                                    swal.fire("Failed!", msg, "error");
                                }
                            }).fail(function (err) {
                                swal.fire("Error!", "An error occurred while submitting", "error");
                            });
                        });
                    },
                    allowOutsideClick: () => !Swal.isLoading()
                });
            });

        })

    </script>
}