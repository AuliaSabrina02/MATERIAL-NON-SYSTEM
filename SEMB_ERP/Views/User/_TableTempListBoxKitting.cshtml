@model List<BoxModel>
@{
    decimal total_qty = ViewBag.total_qty;
    string box_id = ViewBag.box_id;
    int no = 0;
    List<string> listPrinter = ViewBag.listPrinter;
}

<table class="table table-bordered table-sm text-center">
    <thead class="bg-secondary">
        <tr>
            <th>Box.</th>
            <th>Qty</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var box in Model)
        {
            <tr>
                <td>@box.BoxId</td>
                <td>
                    <input class="form-control form-control-sm" type="number" step="0" min="0" name="qty_perbox[]" value="@box.Qty" />
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="form-group text-center">
    <button type="submit" class="btn btn-success mt-2" name="btn_submit_kitting"><i class="fa fa-arrow-right"></i> Submit</button>
</div>

<script>
    $(document).ready(function () {
        let box_id_kitting = "@box_id";
        let total_qty = @total_qty;
        var list_printers_kitting = @Html.Raw(Json.Serialize(listPrinter));
        const printInputOptionsKitting = list_printers.reduce((acc, text) => {
            acc[text] = text;
            return acc;
        }, {});
        $("button[name=btn_submit_kitting]").click(function () {
            let arr_qty = [];
            let total_qty_kitting = 0;
            $('input[name^="qty_perbox"]').each(function (i) {
                arr_qty.push($(this).val());
                total_qty_kitting = total_qty_kitting + parseFloat($(this).val());
            });
            // total1 = total1.toFixed(2);
            // total2 = total2.toFixed(2);
            if (parseInt(total_qty) != parseInt(total_qty_kitting)) {
                swal.fire("Error!", "Jumlah Qty tidak sama! " + total_qty + "|" + total_qty_kitting, "error");
            }
            else {
                // Swal.fire({
                //     title: 'Confirm ?',
                //     text: "Are you sure ?",
                //     icon: 'warning',
