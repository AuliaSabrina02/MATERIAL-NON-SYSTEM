@using SEMB_ERP.Models
@*@model ViewModel*@
@using System.Globalization;
@using Microsoft.AspNetCore.Http;
@using SEMB_ERP.Controllers;
@inject IHttpContextAccessor Accessor

@{
    string sesa_id = ViewBag.sesa_id;
    string name = ViewBag.name;
    string plant = ViewBag.plant;
    string todayDate = DateTime.Today.ToString("yyyy-MM-dd");
    List<string> catList = ViewBag.catList;

}

<style>

    .table-row {
        cursor: pointer;
    }

    .modal {
        overflow-y: auto;
    }

    .box_form_input {
        background-color: #fcfcfc;
        border-radius: 5px;
        box-shadow: 1px 2px 8px 2px rgba(152,152,152,0.7);
    }

    /* .content {
        font-family: Verdana
    } */
    #list_sbin tbody tr.row_body:hover {
        background-color: #95db72;
        color: white;
    }

    #list_sbin {
        border-radius: 0.35rem; /* sudut tumpul */
        overflow: hidden; /* supaya border-radius bekerja */
    }

        #list_sbin td {
            border-bottom: 0.5px solid #FBF8EF !important;
            border-left: none !important;
            font-size: 10px;
        }

        #list_sbin thead th {
            border: none !important;
            font-size: 12px;
        }
        @@property --rotate {
        syntax: "<angle>";
        initial-value: 0deg;
        inherits: false;
    }

    .magic-card {
        --card-height: 610px;
        --ring: 2px;
        position: relative;
        overflow: visible;
        isolation: isolate;
        border-radius: 5px;
    }

    .magic-card::before {
        content: "";
        position: absolute;
        inset: 0;
        padding: var(--ring);
        border-radius: inherit;
        background: conic-gradient( from var(--rotate), #3dcd58, #7aff91, #1e7f34, #74ffaf, #3dcd58 );
        -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        animation: spin 3s linear infinite;
        pointer-events: none;
        z-index: 0;
    }

    .magic-card .card-body {
        position: relative;
        z-index: 1;
    }

    @@keyframes spin {
        to {
            --rotate: 360deg;
        }
    }

    @@keyframes smoothshake {
   
        0%   { transform: translateX(0); }
        3%   { transform: translateX(-3px); }
        6%   { transform: translateX(3px); }
        9%   { transform: translateX(0); }
        100% { transform: translateX(0); }
    }
</style>
<section id="hero1" class="hero bg-dark position-relative">
