<div class="content">
    <div class="container-fluid">
        <div class="row pt-3">
            <div class="col-md-12">
                <div class="card card-info card-outline">
                    <div class="card-header bg-info">
                        <h5 class="text-center"><i class="fas fa-boxes"></i> Putaway</h5>
                        @*<div class="card-tools">
                        <a href="~/Template/TemplateUploadPallet.xlsx" class="btn btn-danger mr-1">
                        <i class="fa fa-download"></i> Template
                        </a>
                        <button class="btn btn-success mr-1" name="btn_filter" data-bs-toggle="modal" data-bs-target="#ImportDataModel"><i class="fas fa-file-import"></i> Upload Pallet List</button>
                        </div>*@
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-12">
                                <div class="text-center"><label style="font-size:14pt"><i class="fas fa-qrcode"></i> Scan Box</label></div>
                                <div class="form-group">
