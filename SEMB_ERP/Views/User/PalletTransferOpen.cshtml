@section Scripts {

    <script>
        var table;
        var loading = "<div class='text-center'><i class='fa fa-4x fa-spinner fa-spin'></i></div>";
        var sesa_id = "@user.sesa_id".toUpperCase();

        $(document).ready(function () {

            table = $("#table_req").DataTable({
                // "searching": false,
                // "scrollX": true,
                // "fixedColumns": {
                //     rightColumns: 1
                // },
                "orderCellsTop": true,
                "processing": true,
                "serverSide": true,
                "filter": true,
                "ajax": {
                    "url": "@Url.Action("GetPalletTransferList")",
                    "type": "POST",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "pallet_no", "className": "align-middle text-center" },
                    { "data": "request_no",  "className": "align-middle text-center" },
                    {
                        "data": "status_pallet",
                        "className": "align-middle text-center",
                        "render": function (data, type, row) {
                            if (data === "TRANSFER") {
                                return `<button class="btn btn-primary btn-sm" onclick="receive_pallet(${row["id_pallet"]})">
                                            <i class="fas fa-truck"></i> Receive
                                        </button>`;
                            }

                            if (data === "RECEIVED") {
                                return data
                            }

                            return data;
                        }
                    },
                    {
                        "data": "status_pallet",
                        "className": "align-middle text-center",
                        "render": function (data, type, row) {
                            if (row.status_pallet === "RECEIVED") {
                                return `<button class="btn btn-primary btn-sm" onclick="supply_pallet(${row["id_pallet"]})">
                                            <i class="fas fa-box"></i> Supply
                                        </button>`;
                            } else {
                                return `<button class="btn btn-secondary btn-sm" disabled>
                                            <i class="fas fa-box"></i> Supply
                                        </button>`;
                            }
                        }

                    }

                ],
                "drawCallback": function (settings) {
                    // Set the background color for the second column (index 1)
                    this.api().rows().every(function () {
                        var rowNode = this.node();
                        let receive_status = $(rowNode).find('td:eq(2)').html();
                        let supply_status = $(rowNode).find('td:eq(3)').html();
                        receive_status = receive_status ? receive_status.toLowerCase() : "";
                        supply_status = supply_status ? supply_status.toLowerCase() : "";
                        let bg_color = "";
                        //console.log(receive_status);
                        if(receive_status=="received"){
                            bg_color = "bg-success";
                            $(rowNode).find('td:eq(2)').addClass(bg_color);
                        }
                        if(supply_status=="supplied"){
                            bg_color = "bg-success";
                            $(rowNode).find('td:eq(3)').addClass(bg_color);
                        }
                        // $(rowNode).find('td').css("background-color", "#edfcf1")
                        // $(rowNode).find('td:eq(2)').addClass(bg_color);
                        // $(rowNode).find('td:eq(3)').addClass(bg_color);

                    });
                }
            });


            $('input.filter_table, select.filter_table', this).on('keyup change', function () {
                let trgt = $(this).attr('target');
                // alert(trgt);
                if (table.column(trgt).search() !== this.value) {
                    table
                        .column(trgt)
                        .search(this.value)
                        .draw();
                }
            });
        })

        function receive_pallet(id_pallet) {
            //console.log(id_pallet)
            var sesa_id = '@ViewBag.sesa_id'

            Swal.fire({
                title: 'Are you sure?',
                text: "",
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes!',
                cancelButtonText: 'No, cancel',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("UpdateReceived")',
                        data: {
                            id_pallet: id_pallet,
                            sesa_id: sesa_id
                        },
                        success: function(response) {
                            console.log(response);
                            if (response.trim() === "OK") {
                                Swal.fire(
                                    'Received!',
                                    'Bin has been received.',
                                    'success'
                                );
                            } else {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Warning!',
                                    text: 'Unexpected response received.',
                                    confirmButtonText: 'OK'
                                });
                            }

                            table.ajax.reload();
                        },
                        error: function(xhr, status, error) {
                            alert('An error occurred: ' + error);
                        }
                    });
                }
            });

        }

        function supply_pallet(id_pallet) {
            //console.log(id_pallet)
            var sesa_id = '@ViewBag.sesa_id'
            Swal.fire({
                title: 'Are you sure?',
                text: "",
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes!',
                cancelButtonText: 'No, cancel',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("UpdateSupplied")',
                        data: {
                            id_pallet: id_pallet,
                            sesa_id: sesa_id
                        },
                        success: function(response) {
                            console.log(response);
                            if (response.trim() === "OK") {
                                Swal.fire(
                                    'Received!',
                                    'Bin has been received.',
                                    'success'
                                );
                            } else {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Warning!',
                                    text: 'Unexpected response received.',
                                    confirmButtonText: 'OK'
                                });
                            }

                            table.ajax.reload();
                        },
                        error: function(xhr, status, error) {
                            alert('An error occurred: ' + error);
                        }
                    });
                }
            });
        }
    </script>
}